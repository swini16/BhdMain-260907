        "purchase_reassurance": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-purchase-reassurance\">{% if product.selected_or_first_available_variant.available %}<span class=\"bhd-stock\">● In stock</span>{% endif %}<span class=\"bhd-purchase-note\">Secure checkout.</span><a href=\"/policies/shipping-policy\">Shipping &amp; delivery</a><a href=\"/policies/refund-policy\">Returns &amp; refunds</a></div><style>.product-form__submit:not([disabled]){min-height:5.2rem;background:#0b2d67!important;color:#fff!important;font-weight:850}.product-form__submit:not([disabled]):after{box-shadow:0 0 0 1px #0b2d67!important}.shopify-payment-button{margin-top:.6rem}.bhd-purchase-reassurance{display:flex;align-items:center;gap:.7rem 1.1rem;flex-wrap:wrap;margin:.7rem 0 1rem;color:#52657a;font-size:1.15rem}.bhd-purchase-reassurance a{color:#0b2d67;text-underline-offset:.25rem}.bhd-purchase-note{color:#52657a}.bhd-stock{color:#26734d;font-weight:800}</style>"
          }
