        "trust_strip": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-trust-strip\" aria-label=\"Product trust signals\"><span><strong>Health Canada NPN</strong><br>80118664</span><span><strong>Made in Alberta</strong><br>Mixed &amp; packaged in Edmonton</span><span><strong>Science-informed formula</strong><br>Glucose + electrolytes</span></div><style>.bhd-trust-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin:.8rem 0 1rem}.bhd-trust-strip span{display:block;padding:.8rem .7rem;border:1px solid #d7e3f1;border-radius:.9rem;background:#f7fbff;color:#52657a;font-size:1.08rem;line-height:1.35;text-align:center}.bhd-trust-strip strong{color:#0b2d67;font-size:1.12rem}@media screen and (max-width:749px){.bhd-trust-strip{grid-template-columns:1fr}.bhd-trust-strip span{text-align:left}}</style>"
          }
        },
        "free_shipping": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-free-shipping\" role=\"note\"><strong>✓ Free &amp; Fast Delivery</strong><span>Orders generally process in 0–2 business days. Delivery timing varies by destination.</span></div><style>.product__tax{display:none!important}.bhd-free-shipping{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin:.6rem 0 .2rem;padding:.85rem 1.05rem;border:1px solid #8dc6aa;border-radius:1rem;background:#e7f6ee;color:#174f3c;font-size:1.35rem;line-height:1.3}.bhd-free-shipping strong{font-weight:850}.bhd-free-shipping span{color:#3f6758;font-size:1.2rem}@media screen and (max-width:749px){.bhd-free-shipping{align-items:flex-start;flex-direction:column;gap:.2rem}}</style>"
          }
        },
