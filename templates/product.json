        "purchase_value": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-product-value\" aria-label=\"Best Hydrate value\"><strong>LOW SUGAR, ON PURPOSE.</strong><span>1 g sugar / 100 mL prepared</span><span>5 electrolytes</span><span>32 servings</span><span>~C$1.25/serving</span><p class=\"bhd-product-taste\"><strong>Tastes great.</strong> Light, balanced, not too sweet.</p></div><style>.bhd-product-value{display:flex;flex-wrap:wrap;gap:.45rem .6rem;align-items:center;margin:.45rem 0 .35rem}.bhd-product-value>strong{flex-basis:100%;color:#0b2d67;font-size:1.32rem}.bhd-product-value>span{display:inline-block;padding:.45rem .7rem;border:1px solid #d7e3f1;border-radius:999px;background:#f7fbff;color:#52657a;font-size:1.08rem;font-weight:700;line-height:1.2}.bhd-product-taste{flex-basis:100%;margin:.2rem 0 0;color:#52657a;font-size:1.18rem;line-height:1.35}.bhd-product-taste strong{color:#0b2d67}@media screen and (max-width:749px){.bhd-product-value{gap:.35rem .45rem;margin:.35rem 0 .45rem}.bhd-product-value>strong{font-size:1.2rem}.bhd-product-value>span{padding:.38rem .6rem;font-size:1rem}.bhd-product-taste{font-size:1.08rem}}</style>"
          }
        },
        "purchase_choice": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-purchase-choice\" role=\"note\"><strong>One-time purchase</strong><span>No subscription required.</span></div><style>.bhd-purchase-choice{display:flex;align-items:center;gap:.45rem .7rem;flex-wrap:wrap;margin:.45rem 0 .1rem;padding:.7rem .9rem;border:1px solid #d7e3f1;border-radius:.9rem;background:#fbfdff;color:#52657a;font-size:1.15rem;line-height:1.25}.bhd-purchase-choice strong{color:#0b2d67}.bhd-purchase-choice span{font-weight:600}</style>"
          }
        },
        "mobile_sticky": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bhd-mobile-sticky-buy\" data-bhd-mobile-sticky-buy hidden><button type=\"button\" class=\"button button--primary button--full-width\" data-bhd-sticky-submit>Add to cart</button><span>Free &amp; Fast Delivery</span></div><script>(()=>{const init=()=>{const root=document.getElementById('MainProduct-{{ section.id }}');const sticky=root?.querySelector('[data-bhd-mobile-sticky-buy]');const primary=root?.querySelector('.product-form__submit[name=\"add\"]');if(!sticky||!primary||sticky.dataset.ready==='true')return;sticky.dataset.ready='true';const button=sticky.querySelector('[data-bhd-sticky-submit]');const sync=()=>{button.disabled=primary.disabled||primary.getAttribute('aria-disabled')==='true'};sync();sticky.hidden=false;button.addEventListener('click',()=>primary.click());if('IntersectionObserver'in window){new IntersectionObserver(([entry])=>sticky.classList.toggle('is-hidden',entry.isIntersecting),{threshold:.2}).observe(primary)}if('MutationObserver'in window){new MutationObserver(sync).observe(primary,{attributes:true,attributeFilter:['disabled','aria-disabled']})}};document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init,{once:true}):init()})();</script><style>.bhd-mobile-sticky-buy{display:none}@media screen and (max-width:749px){.bhd-mobile-sticky-buy:not([hidden]){position:fixed;left:1rem;right:1rem;bottom:calc(1rem + env(safe-area-inset-bottom));z-index:45;display:grid;gap:.35rem;padding:.7rem;background:rgb(var(--color-background));border:1px solid rgba(var(--color-foreground),.16);border-radius:1.2rem;box-shadow:0 .6rem 2rem rgba(0,0,0,.18);transition:opacity .2s ease,transform .2s ease}.bhd-mobile-sticky-buy .button{min-height:4.8rem;font-weight:850}.bhd-mobile-sticky-buy span{text-align:center;color:#2c6b46;font-size:1.05rem;font-weight:700;line-height:1.2}.bhd-mobile-sticky-buy.is-hidden{opacity:0;pointer-events:none;transform:translateY(120%)}body:has(cart-drawer.active) .bhd-mobile-sticky-buy{display:none!important}}</style>"
          }
        },
        "subscription_guard": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<script>(()=>{const init=()=>{const root=document.getElementById('MainProduct-{{ section.id }}');if(!root||root.dataset.bhdRecurringGuard==='true')return;root.dataset.bhdRecurringGuard='true';const phrase='This item is a deferred, subscription, or recurring purchase.';const hasPlan=()=>{const checked=root.querySelector('input[name=\"selling_plan\"]:checked');if(checked&&checked.value)return true;const select=root.querySelector('select[name=\"selling_plan\"]');if(select&&select.value)return true;const hidden=[...root.querySelectorAll('input[name=\"selling_plan\"][type=\"hidden\"]')].find(el=>el.value);return !!hidden};const apply=()=>{const selected=hasPlan();const candidates=[...root.querySelectorAll('label,p,small,div,span')].filter(el=>{const text=(el.textContent||'').trim();return text.includes(phrase)&&text.length<900});candidates.forEach(el=>{let target=el;if(el.closest('label'))target=el.closest('label');else if(el.parentElement&&el.parentElement.querySelector('input[type=\"checkbox\"]')&&(el.parentElement.textContent||'').includes(phrase))target=el.parentElement;target.style.display=selected?'':'none';target.setAttribute('data-bhd-recurring-policy',selected?'visible':'hidden')})};apply();root.addEventListener('change',e=>{if(e.target&&((e.target.name||'')==='selling_plan'||e.target.closest?.('[name=\"selling_plan\"]')))requestAnimationFrame(apply)});if('MutationObserver'in window)new MutationObserver(apply).observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['value','checked']})};document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init,{once:true}):init()})();</script>"
          }
        },
