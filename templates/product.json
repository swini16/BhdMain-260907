      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div id=\"customer-reviews\" class=\"bhd-reviews-intro\"><p class=\"bhd-reviews-intro__eyebrow\">Customer reviews</p><h2>What customers are saying</h2><p>Read Best Hydrate customer feedback here, or open the review pages for the marketplace where you shop.</p><div class=\"bhd-reviews-intro__links\"><a href=\"https://www.amazon.ca/product-reviews/B0CPSR65JY\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon.ca reviews</a><a href=\"https://www.amazon.com/product-reviews/B0CPSR65JY\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon.com reviews</a></div></div><style>.bhd-reviews-intro{max-width:112rem;margin:0 auto;padding:1rem 5rem 1.5rem;text-align:center}.bhd-reviews-intro__eyebrow{margin:0 0 .45rem;color:#3f6089;font-size:1.12rem;font-weight:850;letter-spacing:.11em;text-transform:uppercase}.bhd-reviews-intro h2{margin:.2rem 0 .7rem;color:#0b2d67;font-size:clamp(2.2rem,3vw,3.4rem)}.bhd-reviews-intro>p:not(.bhd-reviews-intro__eyebrow){max-width:72rem;margin:.4rem auto 1.1rem;color:#5f6f83;font-size:1.35rem;line-height:1.5}.bhd-reviews-intro__links{display:flex;justify-content:center;flex-wrap:wrap;gap:.7rem}.bhd-reviews-intro__links a{padding:.7rem 1rem;border:1px solid #9fb9d8;border-radius:999px;background:#eef5fc;color:#0b2d67;font-size:1.15rem;font-weight:800;text-decoration:none}.bhd-reviews-intro__links a:hover{background:#dbe8f6}@media screen and (max-width:749px){.bhd-reviews-intro{padding:1rem 2rem 1.25rem}}</style>",
