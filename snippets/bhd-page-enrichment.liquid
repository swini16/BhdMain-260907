      assign e_link_2 = '/pages/q-a'
      assign e_link_2_label = 'FAQ'
  endcase
%}

{% if e_heading != blank %}
  <section class="bhd-enrichment" aria-labelledby="BhdEnrichment-{{ page.handle }}">
    <div class="bhd-enrichment__icon" aria-hidden="true">{{ e_icon }}</div>
    <div class="bhd-enrichment__body">
      <p class="bhd-enrichment__label">{{ e_label }}</p>
      <h2 id="BhdEnrichment-{{ page.handle }}">{{ e_heading }}</h2>
      <p>{{ e_p1 }}</p>
      {% if e_p2 != blank %}<p>{{ e_p2 }}</p>{% endif %}
      {% if e_link_1 != blank or e_link_2 != blank %}
        <nav class="bhd-enrichment__links" aria-label="Related pages">
          {% if e_link_1 != blank %}<a href="{{ e_link_1 }}"><span aria-hidden="true">↗</span>{{ e_link_1_label }}</a>{% endif %}
          {% if e_link_2 != blank %}<a href="{{ e_link_2 }}"><span aria-hidden="true">↗</span>{{ e_link_2_label }}</a>{% endif %}
        </nav>
      {% endif %}
    </div>
  </section>

  <style>
    .bhd-enrichment{display:grid;grid-template-columns:5.8rem minmax(0,1fr);gap:1.7rem;align-items:start;max-width:1120px;margin:3rem auto 4rem;padding:2.2rem;border:1px solid rgba(var(--color-foreground),.12);border-radius:18px;background:linear-gradient(135deg,rgba(var(--color-button),.055),rgba(var(--color-background),1));box-shadow:0 .8rem 2.6rem rgba(13,33,78,.06)}
    .bhd-enrichment__icon{width:5.8rem;height:5.8rem;display:grid;place-items:center;border-radius:16px;background:rgba(var(--color-button),.12);border:1px solid rgba(var(--color-button),.22);font-size:2.6rem;line-height:1}
    .bhd-enrichment__body{min-width:0}.bhd-enrichment__label{margin:0 0 .45rem;text-transform:uppercase;letter-spacing:.12em;font-size:1.15rem;font-weight:750;opacity:.64}.bhd-enrichment h2{margin:0 0 .9rem;font-size:clamp(2rem,2.7vw,3rem);line-height:1.08}.bhd-enrichment__body>p:not(.bhd-enrichment__label){max-width:82ch;margin:.65rem 0;font-size:1.48rem;line-height:1.62}
    .bhd-enrichment__links{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.35rem}.bhd-enrichment__links a{display:inline-flex;align-items:center;gap:.5rem;padding:.68rem .9rem;border:1px solid rgba(var(--color-button),.25);border-radius:999px;background:rgba(var(--color-button),.07);color:rgb(var(--color-foreground));font-size:1.28rem;font-weight:650;text-decoration:none}.bhd-enrichment__links a:hover{background:rgba(var(--color-button),.13);border-color:rgba(var(--color-button),.4)}
    @media screen and (max-width:749px){.bhd-enrichment{grid-template-columns:1fr;gap:1.1rem;margin:2rem auto 3rem;padding:1.55rem;border-radius:14px}.bhd-enrichment__icon{width:4.8rem;height:4.8rem;border-radius:13px;font-size:2.2rem}.bhd-enrichment h2{font-size:2.1rem}.bhd-enrichment__body>p:not(.bhd-enrichment__label){font-size:1.4rem}.bhd-enrichment__links{gap:.55rem}.bhd-enrichment__links a{font-size:1.22rem}}
  </style>
{% endif %}