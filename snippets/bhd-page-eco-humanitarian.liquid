<script>
  (() => {
    const root = document.getElementById('BhdFieldCarousel-{{ section.id }}');
    if (!root) return;
    const viewport = root.querySelector('.bhd-field-carousel__viewport');
    const slides = Array.from(root.querySelectorAll('.bhd-field-carousel__slide'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const prev = root.querySelector('.bhd-field-carousel__nav--prev');
    const next = root.querySelector('.bhd-field-carousel__nav--next');
    let active = 0;

    const goTo = (index) => {
      active = (index + slides.length) % slides.length;
      viewport.scrollTo({ left: slides[active].offsetLeft, behavior: 'smooth' });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        if (i === active) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
      });
    };

    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(active - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(active + 1); }
    });

    let scrollTimer;
    viewport.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const index = Math.round(viewport.scrollLeft / Math.max(viewport.clientWidth, 1));
        active = Math.max(0, Math.min(slides.length - 1, index));
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === active);
          if (i === active) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
        });
      }, 80);
    }, { passive: true });
  })();
</script>

<section class="bhd-page__cards-section"><p class="bhd-page__kicker">Design for deployment</p><h2>Five questions before a humanitarian product leaves the warehouse</h2><div class="bhd-page__cards bhd-page__cards--4"><article><h3>Is the water safe?</h3><p>Preparation instructions are only meaningful if safe water is reliably available.</p></article><article><h3>Is the formulation appropriate?</h3><p>Therapeutic ORS requires the correct composition, authorization and evidence for the intended clinical use.</p></article><article><h3>Can people prepare it correctly?</h3><p>Serving size, language, literacy, measuring tools and package design affect real-world accuracy.</p></article><article><h3>Can supply be sustained?</h3><p>Procurement, storage, transport, shelf stability, local partners and replenishment all shape impact.</p></article></div></section>

<section class="bhd-page__prose-grid"><article class="bhd-page__prose"><p class="bhd-page__kicker">Eco-humanitarian design</p><h2>Reduce waste without compromising safe use</h2><p>Packaging weight and waste matter at scale, but reductions cannot compromise moisture protection, stability, dosing accuracy or clear instructions.</p></article><aside class="bhd-page__callout"><span class="bhd-page__callout-label">Systems principle</span><h3>Product × access × correct use.</h3><p>A good formulation has little value if water is unsafe, instructions fail or supply disappears.</p></aside></section>

<section class="bhd-page__cards-section"><p class="bhd-page__kicker">Partnership model</p><h2>Build with communities and technical partners</h2><div class="bhd-page__cards bhd-page__cards--3"><article><h3>Local implementation</h3><p>Partners understand language, distribution, community trust and operating constraints that cannot be designed from a distant office.</p></article><article><h3>Research and evaluation</h3><p>Pilots should predefine safety, preparation accuracy, acceptability, access, waste and relevant health or implementation outcomes.</p><a href="/pages/research-impact">Research Impact →</a></article><article><h3>Humanitarian partnerships</h3><p>Use partnerships to connect formulation, procurement, WASH, training and delivery rather than simply donating product.</p><a href="/pages/humanitarian-partnerships">Humanitarian Partnerships →</a></article></div></section>

