{% doc %}
  Renders the Best Hydrate media story, product and partnership pathways.
{% enddoc %}
{% assign media_now = 'now' | date: '%s' | plus: 0 %}
{% assign product_url = '/products/lemonade-best-hydrate' %}
{% if localization.country.iso_code == 'US' %}
  {% assign product_url = '/products/lemonade-electrolyte-best-hydrate' %}
{% endif %}
{% assign media_product_image = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/best-hydrate-lemonade-clean-20260910.png?v=1789057777' %}
{% assign media_title = "U of Alberta’s Folio: U of A researcher lends expertise to boost the science of oral hydration" %}
{% assign media_eyebrow = 'Featured coverage · October 8, 2026' %}
{% assign media_intro = 'Built on alliances. Made possible by people.' %}
{% if page.handle == 'cbc-edmonton-am' %}
  {% assign media_title = "CBC Edmonton AM: A sports drink that could help with Crohn's disease" %}
  {% assign media_eyebrow = 'Conversation & community' %}
{% endif %}

<div id="BhdMedia-{{ section.id }}" class="bhd-media-page" data-bhd-review-page="{% if page.handle == 'cbc-edmonton-am' %}cbc{% else %}folio{% endif %}">
<div data-bhd-review-block="hero">
{% render 'bhd-page-header',
  family: 'Connect',
  parent: 'Press & Media',
  parent_url: '/pages/press',
  eyebrow: media_eyebrow,
  title: media_title,
  intro: media_intro,
  hero_image: media_product_image,
  hero_alt: 'Best Hydrate Lemonade electrolyte powder jar'
%}
</div>

<section class="bhd-page__feature" data-bhd-review-block="story" aria-labelledby="BhdMediaStory-{{ section.id }}">
  <div>
    {% if page.handle == 'cbc-edmonton-am' %}
      <p class="bhd-page__kicker">CBC Edmonton AM · CBC Listen</p>
      <h2 id="BhdMediaStory-{{ section.id }}">Original reporting</h2>
      <p>CBC Edmonton AM introduces Best Hydrate founder Austin Swiniarski and chief scientific officer Spencer Proctor in a segment about the Sherwood Park company.</p>
      <p>CBC describes a drink that <q>hopes to do more than just quench your thirst</q>. Listen to the original interview for the discussion and context.</p>
      <p><small>The headline and excerpt are attributed to CBC. They do not establish that Best Hydrate treats Crohn’s disease or that a product efficacy trial has been completed.</small></p>
      <p><strong>CBC Radio One Edmonton · 93.9 FM / 740 AM.</strong></p>
      <a class="bhd-page__button" href="https://www.cbc.ca/listen/live-radio/1-17-edmonton-am/clip/16242570-a-sports-drink-help-crohns-disease" target="_blank" rel="noopener noreferrer">Listen to our CBC interview</a>
      <a class="bhd-page__text-link" href="https://www.cbc.ca/listen/live-radio/1-17-edmonton-am" target="_blank" rel="noopener noreferrer">CBC Edmonton AM program & archive →</a>
      <p><a class="bhd-page__text-link" href="/pages/folio-hydration-feature">Read the story in U of Alberta’s Folio →</a></p>
    {% else %}
      <p class="bhd-page__kicker">U of Alberta’s Folio · October 8, 2026</p>
      <h2 id="BhdMediaStory-{{ section.id }}">Original reporting</h2>
      <p>In U of Alberta’s Folio, Bev Betkowski reports on Dr. Spencer Proctor’s collaboration with Best Hydrate and a review of oral-hydration research. The article describes plans to compare and improve formulations, alongside questions for future clinical research.</p>
      <p><q>Our goal is to bring more science to this topic</q> — Dr. Spencer Proctor, quoted in U of Alberta’s Folio, October 8, 2026.</p>
      <a class="bhd-page__button" href="https://www.ualberta.ca/en/news/spotlights/2026/10-oct/uofa-researcher-lends-expertise-to-boost-science-of-oral-hydration.html" target="_blank" rel="noopener noreferrer">Read U of Alberta’s Folio →</a>
      <p><small>Read the original reporting at the University of Alberta. Coverage and research collaboration do not imply a product endorsement or completed product efficacy trial.</small></p>
      {% if media_now < 1791812100 %}
        <p>Austin and Dr. Proctor are also scheduled to join CBC Edmonton AM on Monday, October 12 at 7:35 a.m. MDT.</p>
      {% endif %}
      <a class="bhd-page__text-link" href="/pages/cbc-edmonton-am">CBC Edmonton AM listening information →</a>
    {% endif %}
  </div>
</section>

<section class="bhd-page__brand-context" data-bhd-review-block="product" aria-labelledby="BhdMediaProduct-{{ section.id }}">
  <div>
    <p class="bhd-page__kicker">Meet the product</p>
    <h2 id="BhdMediaProduct-{{ section.id }}">Hydrate for YOUR Best Day!</h2>
    <p>Meet Best Hydrate Lemonade. Light, balanced flavour, purposeful low sugar and 32 servings per container. See the current product page for ingredients, directions and availability.</p>
  </div>
  <div class="bhd-page__brand-actions">
    <a class="bhd-page__button" href="{{ product_url }}">Buy Now</a>
    <a class="bhd-page__button bhd-page__button--secondary" href="/pages/product-details">Product Details</a>
  </div>
</section>

<section class="bhd-page__feature" data-bhd-review-block="partnerships" aria-labelledby="BhdMediaPartners-{{ section.id }}">
  <div>
    <p class="bhd-page__kicker">Strategic partnerships</p>
    <h2 id="BhdMediaPartners-{{ section.id }}">Help shape what comes next.</h2>
    <p>Best Hydrate is growing through alliances. We welcome conversations with strategic partners who can help guide our next stage of growth.</p>
    <a class="bhd-page__button" href="/pages/partnerships">Explore Partnerships</a>
    <a class="bhd-page__button bhd-page__button--secondary" href="/pages/contact">Start a Conversation</a>
    <p><a class="bhd-page__text-link" href="/pages/press">More Best Hydrate news & media →</a></p>
  </div>
</section>
</div>

<style>
  /* Reuse the existing bhd-hero-v4 palette; keep approved product art uncropped. */
  #BhdMedia-{{ section.id }}.bhd-media-page{
    --bhd-navy:#0d1d53;
    --bhd-blue:#1475ef;
    --bhd-muted:#52657f;
    --bhd-line:#d9e6f5
  }
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page-hero__media{background:#fff}
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page-hero__media img{object-fit:contain}
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page-hero__lede,
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page__feature p{color:var(--bhd-muted)}
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page__feature{background:#fff;border-color:var(--bhd-line)}
  #BhdMedia-{{ section.id }}.bhd-media-page .bhd-page__brand-context{background:var(--bhd-navy)}
</style>
