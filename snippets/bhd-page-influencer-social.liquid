{% render 'bhd-page-header',
  family: 'Connect',
  eyebrow: 'Influencer & Social',
  title: 'Creators & Social',
  intro: 'Best Hydrate works with creators when the audience, content and hydration context are a genuine fit.'
%}

<div class="bhd-page__keypoints" aria-label="Creator partnership priorities">
  <div><strong>Audience fit</strong><span>Hydration should make sense within the creator’s normal content.</span></div>
  <div><strong>Clear disclosure</strong><span>Paid, gifted and affiliate relationships should be transparent.</span></div>
  <div><strong>Evidence-aware</strong><span>Personal experience is not proof of a medical or performance outcome.</span></div>
</div>

{% render 'bhd-social-archive',
