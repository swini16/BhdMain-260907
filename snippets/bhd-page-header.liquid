{% render 'bhd-page-breadcrumbs', page_handle: page.handle, current_title: title, preferred_family: family %}

{% liquid
  assign resolved_eyebrow = eyebrow | strip
  assign resolved_title = title | strip
  assign resolved_parent = parent | strip
  assign resolved_family = family | strip

  if resolved_eyebrow != blank and resolved_eyebrow == resolved_title
    if resolved_parent != blank and resolved_parent != resolved_title
      assign resolved_eyebrow = resolved_parent
    elsif resolved_family != blank and resolved_family != resolved_title
      assign resolved_eyebrow = resolved_family
    else
      assign resolved_eyebrow = ''
    endif
  endif
%}

<header class="bhd-page-hero" data-bhd-page-handle="{{ page.handle | escape }}">
  <div class="bhd-page-hero__copy">
    {% if resolved_eyebrow != blank %}<p class="bhd-page__eyebrow">{{ resolved_eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if intro != blank %}<p class="bhd-page-hero__lede">{{ intro }}</p>{% endif %}
  </div>
  {% if hero_image != blank %}
    <div class="bhd-page-hero__media">
      <img src="{{ hero_image }}"{% if hero_srcset != blank %} srcset="{{ hero_srcset | escape }}" sizes="{{ hero_sizes | default: '100vw' | escape }}"{% endif %} alt="{{ hero_alt | escape }}" width="1800" height="1200" loading="eager" fetchpriority="high" decoding="async">
    </div>
  {% endif %}
</header>

{% render 'bhd-menu-descendants' %}
{% comment %}Athletics and Dianna use the canonical Solutions > Performance hierarchy; other Pages use the deterministic breadcrumb map.{% endcomment %}