{% doc %}
  Renders one Lemonade quantity prompt beside the native quantity control.
  The prompt changes quantity only; Shopify determines the applied offer.

  @param {product} product - The product displayed by the enclosing product-info element.
  @param {string} section_id - The section ID used by Quantity- and product-form-.

  @example
  {% render 'bhd-lemonade-volume', product: product, section_id: section.id %}
{% enddoc %}

{%- liquid
  assign volume_eligible = false
  if product.id == 8904882422044 or product.id == 10168145281308
    assign volume_eligible = true
  endif
  assign volume_variant = product.selected_or_first_available_variant
  if product.quantity_price_breaks_configured?
    assign volume_eligible = false
  endif
  assign volume_stock_limit = ''
  if volume_variant.inventory_management == 'shopify' and volume_variant.inventory_policy == 'deny'
    assign volume_stock_limit = volume_variant.inventory_quantity
  endif
  assign volume_now = 'now' | date: '%s' | plus: 0
  assign volume_bfcm_start = '2026-11-27T07:00:00Z' | date: '%s' | plus: 0
  assign volume_bfcm_end = '2026-12-01T07:00:00Z' | date: '%s' | plus: 0
  assign volume_bfcm = false
  if volume_now >= volume_bfcm_start and volume_now < volume_bfcm_end
    assign volume_bfcm = true
  endif
  assign volume_initial_subscription = false
  if product.selected_selling_plan != blank or product.requires_selling_plan
    assign volume_initial_subscription = true
  endif
  assign volume_cart_quantity = 0
  assign volume_known_percent = 0
  assign volume_bulk_percent = 0
  assign volume_unknown_discount = false
  assign volume_applications = cart.cart_level_discount_applications
  for volume_item in cart.items
    assign volume_line_applications = volume_item.line_level_discount_allocations | map: 'discount_application'
    assign volume_applications = volume_applications | concat: volume_line_applications
    assign volume_product_id = volume_item.product.id | default: volume_item.product_id
    if volume_product_id == 8904882422044 or volume_product_id == 10168145281308
      if volume_item.selling_plan_allocation == blank
        assign volume_cart_quantity = volume_cart_quantity | plus: volume_item.quantity
      endif
    endif
  endfor
  for volume_application in volume_applications
    assign volume_percent = 0
    assign volume_bulk_candidate = 0
    if volume_application.value_type == 'percentage'
      assign volume_percent = volume_application.value | plus: 0
    endif
    if volume_application.type == 'automatic'
      case volume_application.title
        when 'Lemonade: Buy 2+, save 10%'
          assign volume_percent = 10
          assign volume_bulk_candidate = 10
        when 'Lemonade: Buy 3+, save 15%'
          assign volume_percent = 15
          assign volume_bulk_candidate = 15
        when 'Lemonade: Buy 10+, save 20%', 'BHD BFCM 2026 · 20% · 1 jar'
          assign volume_percent = 20
          assign volume_bulk_candidate = 20
        when 'BHD BFCM 2026 · 25% · 2+ jars'
          assign volume_percent = 25
          assign volume_bulk_candidate = 25
        else
          if volume_application.value_type != 'percentage'
            assign volume_unknown_discount = true
          endif
      endcase
    elsif volume_application.value_type != 'percentage'
      assign volume_unknown_discount = true
    endif
    if volume_percent > volume_known_percent
      assign volume_known_percent = volume_percent
    endif
    if volume_bulk_candidate > volume_bulk_percent
      assign volume_bulk_percent = volume_bulk_candidate
    endif
  endfor
  assign volume_prospective = volume_variant.quantity_rule.min | default: 1 | plus: volume_cart_quantity
  assign volume_initial_key = 'bhd.volume.confirmation'
  assign volume_target_percent = 15
  assign volume_is_upgrade = false
  if volume_bfcm
    assign volume_target_percent = 25
    assign volume_initial_key = 'bhd.volume.confirmation_bfcm'
    if volume_prospective == 1
      assign volume_initial_key = 'bhd.volume.nudge_bfcm'
      assign volume_is_upgrade = true
    endif
  elsif volume_prospective >= 10
    assign volume_target_percent = 20
    assign volume_initial_key = 'bhd.volume.confirmation_bulk'
  elsif volume_prospective == 1
    assign volume_target_percent = 10
    assign volume_initial_key = 'bhd.volume.nudge_one'
    assign volume_is_upgrade = true
  elsif volume_prospective == 2
    assign volume_initial_key = 'bhd.volume.nudge_two'
    assign volume_is_upgrade = true
  endif
  if volume_unknown_discount or volume_known_percent > volume_target_percent
    assign volume_initial_key = 'bhd.volume.generic'
  elsif volume_is_upgrade and volume_known_percent == volume_target_percent
    assign volume_initial_key = 'bhd.volume.better_offer'
  endif
-%}

{%- if volume_eligible and volume_variant != blank -%}
  {{ 'bhd-lemonade-volume.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'bhd-lemonade-volume.js' | asset_url }}" defer="defer"></script>
  <bhd-lemonade-volume
    id="BhdLemonadeVolume-{{ section_id }}"
    class="bhd-volume"
    data-section-id="{{ section_id }}"
    data-details-id="BhdVolumeDetails-{{ section_id }}"
    data-variant-id="{{ volume_variant.id }}"
    data-available="{{ volume_variant.available }}"
    data-stock-limit="{{ volume_stock_limit }}"
    data-initial-subscription="{{ volume_initial_subscription }}"
    data-requires-selling-plan="{{ product.requires_selling_plan }}"
    data-cart-quantity="{{ volume_cart_quantity }}"
    data-known-percent="{{ volume_known_percent }}"
    data-bulk-percent="{{ volume_bulk_percent }}"
    data-unknown-discount="{{ volume_unknown_discount }}"
    data-bfcm="{{ volume_bfcm }}"
    data-bfcm-start="{{ volume_bfcm_start }}"
    data-bfcm-end="{{ volume_bfcm_end }}"
    data-nudge-one="{{ 'bhd.volume.nudge_one' | t | escape }}"
    data-nudge-two="{{ 'bhd.volume.nudge_two' | t | escape }}"
    data-confirmation="{{ 'bhd.volume.confirmation' | t | escape }}"
    data-confirmation-bulk="{{ 'bhd.volume.confirmation_bulk' | t | escape }}"
    data-nudge-bfcm="{{ 'bhd.volume.nudge_bfcm' | t | escape }}"
    data-confirmation-bfcm="{{ 'bhd.volume.confirmation_bfcm' | t | escape }}"
    data-better-offer="{{ 'bhd.volume.better_offer' | t | escape }}"
    data-generic="{{ 'bhd.volume.generic' | t | escape }}"
    data-next-bulk-template="Add __COUNT__ more for 20% off"
  >
    <div data-volume-offers{% if volume_initial_subscription %} hidden{% endif %}>
      <p class="bhd-volume__message" data-volume-message>
        <button class="bhd-volume__prompt" type="button" data-volume-add aria-controls="Quantity-{{ section_id }}" aria-describedby="BhdVolumeTerms-{{ section_id }}" hidden disabled></button>
        <span class="bhd-volume__confirmation" data-volume-confirmation aria-describedby="BhdVolumeTerms-{{ section_id }}">{{ volume_initial_key | t | escape }}</span>
      </p>
      <div
        id="BhdVolumeDetails-{{ section_id }}"
        class="bhd-volume__details"
        {% if volume_initial_subscription %}hidden{% endif %}
      >
        <p class="bhd-volume__tiers">
          {%- if volume_bfcm -%}
            1 jar: 20% off · 2+ jars: 25% off*
          {%- else -%}
            2 jars: 10% off · 3–9 jars: 15% off · 10+ jars: 20% off*
          {%- endif -%}
        </p>
        <p
          class="bhd-volume__terms"
          data-prefix="*One-time purchases only. "
          aria-hidden="true"
        >{{ 'bhd.volume.terms' | t | escape }}</p>
        <span class="visually-hidden" id="BhdVolumeTerms-{{ section_id }}">One-time purchases only. Offers do not combine.</span>
        <span class="visually-hidden" data-volume-announcement aria-live="polite" aria-atomic="true"></span>
      </div>
    </div>
  </bhd-lemonade-volume>
{%- endif -%}
