{% assign bhd_founder_headshot = 'austin-swiniarski-bio-20260910.webp' | asset_url %}
{% assign bhd_product_clean = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/best-hydrate-lemonade-clean-20260910.png?v=1789057777' %}
{% assign bhd_product_splash = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/best-hydrate-lemonade-splash-20260910.png?v=1789057786' %}
{% assign bhd_logo = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/LOGOClear.png?v=1682315014' %}

{% render 'bhd-page-header',
  family: 'Connect',
  parent: 'News & Contact',
  parent_url: '/pages/news-contact',
  eyebrow: 'Media Kit',
  title: 'Press & Media',
  intro: 'Fast facts, source links, product images, founder media and interview access for journalists, editors and producers.',
  hero_image: bhd_product_splash,
  hero_alt: 'Best Hydrate Lemonade electrolyte powder with water splash and lemon'
%}

<div class="bhd-page__keypoints" aria-label="Best Hydrate media summary"><div><strong>Alberta-grown</strong><span>Founded in 2021 in Alberta, Canada, with product mixed and packaged in Edmonton.</span></div><div><strong>Science-first</strong><span>Consumer hydration today, alongside a growing research and clinical-development program.</span></div><div><strong>Reporter-ready</strong><span>Downloadable visuals, source links, fact checks and interview requests in one place.</span></div></div>

<section class="bhd-media-assets" aria-labelledby="MediaAssets-{{ section.id }}">
  <div class="bhd-media-assets__head"><p class="bhd-page__kicker">Media assets</p><h2 id="MediaAssets-{{ section.id }}">Images & brand files</h2><p>Open the full-size asset, then save the original image from your browser. For alternate formats or higher-resolution source files, send a media request below.</p></div>
  <div class="bhd-media-assets__grid">
    <article class="bhd-media-asset"><a class="bhd-media-asset__image" href="{{ bhd_product_clean }}" target="_blank" rel="noopener"><img src="{{ bhd_product_clean }}" alt="Best Hydrate Lemonade electrolyte powder clean product image" width="1200" height="1200" loading="lazy" decoding="async"></a><div><h3>Clean product image</h3><p>Primary catalog-ready Best Hydrate Lemonade product image.</p><a class="bhd-page__button bhd-page__button--secondary" href="{{ bhd_product_clean }}" target="_blank" rel="noopener">Open full size</a></div></article>
    <article class="bhd-media-asset"><a class="bhd-media-asset__image" href="{{ bhd_product_splash }}" target="_blank" rel="noopener"><img src="{{ bhd_product_splash }}" alt="Best Hydrate Lemonade electrolyte powder splash image" width="713" height="726" loading="lazy" decoding="async"></a><div><h3>Splash product image</h3><p>Editorial and promotional product image with water-and-lemon treatment.</p><a class="bhd-page__button bhd-page__button--secondary" href="{{ bhd_product_splash }}" target="_blank" rel="noopener">Open full size</a></div></article>
    <article class="bhd-media-asset"><a class="bhd-media-asset__image" href="{{ bhd_founder_headshot }}" target="_blank" rel="noopener"><img src="{{ bhd_founder_headshot }}" alt="Austin Swiniarski, founder and CEO of Best Hydrate" width="1000" height="1000" loading="lazy" decoding="async"></a><div><h3>Founder headshot</h3><p>Austin Swiniarski, Founder & CEO, Best Hydrate Inc.</p><a class="bhd-page__button bhd-page__button--secondary" href="{{ bhd_founder_headshot }}" target="_blank" rel="noopener">Open full size</a></div></article>
    <article class="bhd-media-asset bhd-media-asset--logo"><a class="bhd-media-asset__image" href="{{ bhd_logo }}" target="_blank" rel="noopener"><img src="{{ bhd_logo }}" alt="Best Hydrate logo" width="800" height="800" loading="lazy" decoding="async"></a><div><h3>Best Hydrate logo</h3><p>Brand logo for media identification and editorial layouts.</p><a class="bhd-page__button bhd-page__button--secondary" href="{{ bhd_logo }}" target="_blank" rel="noopener">Open full size</a></div></article>
  </div>
</section>

<section class="bhd-page__split"><div class="bhd-page__split-media"><img src="{{ bhd_founder_headshot }}" alt="Austin Swiniarski, founder and CEO of Best Hydrate" width="1000" height="1000" loading="lazy" decoding="async"></div><div class="bhd-page__split-copy"><p class="bhd-page__kicker">Five fast facts</p><h2>Best Hydrate at a glance</h2><ol class="bhd-media-facts"><li><strong>Founded in Alberta:</strong> Best Hydrate was founded in 2021 and is based in Alberta, Canada.</li><li><strong>Made here:</strong> the current Best Hydrate product is mixed and packaged in Edmonton.</li><li><strong>Canadian authorization:</strong> Best Hydrate Lemonade carries Natural Product Number <strong>80118664</strong>.</li><li><strong>Peer-reviewed work:</strong> a 2026 oral-hydration review involving Best Hydrate-affiliated authors was accepted in <em>Frontiers in Nutrition</em> on August 27, 2026.</li><li><strong>Research platform:</strong> current work spans hydration science, measurement, performance and staged clinical-development pathways.</li></ol></div></section>

<section class="bhd-page__feature bhd-media-boilerplate"><div><p class="bhd-page__kicker">Copy-ready company description</p><h2>Best Hydrate in brief</h2><p>Best Hydrate is an Alberta-based hydration company developing science-informed oral hydration products and research. Its current Lemonade electrolyte powder is mixed and packaged in Edmonton and is sold for consumer hydration, while the company continues work across performance, everyday, medical-development and humanitarian hydration applications.</p><p class="bhd-media-note"><strong>Accuracy note:</strong> Best Hydrate's 2026 <em>Frontiers in Nutrition</em> article is an accepted peer-reviewed review, not a clinical efficacy trial of the Best Hydrate product. Frontiers lists the final formatted version as forthcoming.</p></div></section>

<section class="bhd-page__cards-section"><p class="bhd-page__kicker">Primary sources</p><h2>Links reporters can cite</h2><div class="bhd-page__cards bhd-page__cards--4"><article><h3>Accepted peer-reviewed review</h3><p>Acceptance status, authorship and evidence context.</p><a href="/pages/publications">Research status →</a><br><a href="https://doi.org/10.3389/fnut.2026.1851906" target="_blank" rel="noopener">Frontiers DOI →</a></article><article><h3>Hydration science</h3><p>Core physiology and the science behind oral hydration.</p><a href="/pages/hydration-science">Hydration Science →</a></article><article><h3>Formula & product</h3><p>Current ingredients, formula rationale, directions and product context.</p><a href="/pages/our-formula">Our Formula →</a><br><a href="/pages/product-details">Product Details →</a></article><article><h3>Research program</h3><p>Current work, research collaborators and development pathways.</p><a href="/pages/current-research">Current Research →</a><br><a href="/pages/research-partners">Research Partners →</a></article></div></section>

<section class="bhd-page__cards-section"><p class="bhd-page__kicker">Story angles</p><h2>Useful starting points</h2><div class="bhd-page__cards bhd-page__cards--4"><article><h3>Founder story</h3><p>A personal hydration problem became an Alberta company focused on oral hydration.</p><a href="/pages/our-story">Our Story →</a></article><article><h3>Science & research</h3><p>Why oral hydration technology still has room for improvement and investigation.</p><a href="/pages/publications">Research status →</a></article><article><h3>Performance</h3><p>Hydration for training, competition, heat and high-sweat settings.</p><a href="/pages/performance-hydration">Performance →</a></article><article><h3>Canadian company</h3><p>Building an Alberta hydration company with its current product mixed and packaged in Edmonton.</p><a href="/pages/our-story">Company Background →</a></article></div></section>

<section class="bhd-page__feature"><div><p class="bhd-page__kicker">Interview topics</p><h2>Hydration, science and building the company</h2><p>Available topics include oral hydration science, glucose and electrolytes, formulation strategy, performance hydration, research development, consumer-to-medical pathways, humanitarian access, Canadian mixing and packaging, and the experience of building an Alberta science-first startup.</p></div></section>

<section class="bhd-page__brand-context"><div><p class="bhd-page__kicker">Media inquiry</p><h2>Talk with Best Hydrate</h2><p>For interviews, fact checks, research-status questions, image requests or company background, send the outlet, request and deadline.</p></div><div class="bhd-page__brand-actions"><a class="bhd-page__button" href="#media-contact">Media Contact</a><a class="bhd-page__button bhd-page__button--secondary" href="/blogs/news">News & Insights</a></div></section>

<section class="bhd-media-form-wrap" id="media-contact" aria-labelledby="MediaContactHeading-{{ section.id }}">
  <div class="bhd-media-form-head"><p class="bhd-page__kicker">Press & media contact</p><h2 id="MediaContactHeading-{{ section.id }}">Media inquiry</h2><p>Send your outlet, request and deadline. We will route it directly as a media inquiry.</p></div>
  {% form 'contact', id: 'BhdMediaContact' %}
    <input type="hidden" name="contact[Inquiry type]" value="Press & Media">
    {% if form.posted_successfully? %}<div class="bhd-media-form-status" role="status"><strong>Thank you.</strong> Your media inquiry was sent successfully.</div>{% endif %}
    {{ form.errors | default_errors }}

    <div class="bhd-media-form-grid">
      <label><span>Name *</span><input type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% endif %}"></label>
      <label><span>Email *</span><input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% endif %}"></label>
      <label><span>Outlet / organization *</span><input type="text" name="contact[Outlet or organization]" required></label>
      <label><span>Role / title</span><input type="text" name="contact[Role or title]"></label>
      <label><span>Website</span><input type="text" name="contact[Website]" inputmode="url" placeholder="example.com"></label>
      <label><span>Deadline</span><input type="text" name="contact[Deadline]" placeholder="Date / time / timezone"></label>
      <label><span>Request</span><select name="contact[Media request]"><option value="">Select</option><option>Interview</option><option>Fact check</option><option>Founder / company background</option><option>Research / science question</option><option>Product information</option><option>Images / logo</option><option>Other</option></select></label>
      <label><span>Preferred contact method</span><select name="contact[Preferred contact method]"><option>Email</option><option>Phone / video call</option><option>Either</option></select></label>
      <label class="bhd-media-form-span"><span>Message *</span><textarea name="contact[body]" rows="6" required placeholder="What are you working on, what do you need from Best Hydrate, and by when?"></textarea></label>
    </div>

    <div class="bhd-media-submit"><button class="bhd-page__button" type="submit">Send Media Inquiry</button></div>
  {% endform %}
</section>

<section class="bhd-page__related" aria-labelledby="RelatedPress-{{ section.id }}"><p class="bhd-page__kicker">Explore</p><h2 id="RelatedPress-{{ section.id }}">More from Best Hydrate</h2><div class="bhd-page__related-grid"><a href="/pages/mission-values"><strong>About Best Hydrate</strong><span>Company direction and operating values.</span></a><a href="/pages/hydration-science"><strong>Hydration Science</strong><span>Core physiology and oral hydration science.</span></a><a href="/pages/partnerships"><strong>Partnerships</strong><span>Research, commercial and humanitarian collaboration.</span></a><a href="/pages/investor-relations"><strong>Investor Relations</strong><span>Company opportunity and next-stage growth.</span></a></div></section>

<style>
.bhd-media-assets{margin:clamp(2.2rem,5vw,4.5rem) 0}.bhd-media-assets__head{max-width:850px;margin-bottom:1.4rem}.bhd-media-assets__head h2{margin:.2rem 0 .65rem}.bhd-media-assets__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.bhd-media-asset{display:flex;flex-direction:column;overflow:hidden;border:1px solid #dbe6f2;border-radius:18px;background:#fff}.bhd-media-asset__image{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:#f6f9fc;overflow:hidden}.bhd-media-asset__image img{width:100%;height:100%;object-fit:cover}.bhd-media-asset--logo .bhd-media-asset__image img{object-fit:contain;padding:12%;box-sizing:border-box}.bhd-media-asset>div{display:flex;flex:1;flex-direction:column;align-items:flex-start;padding:1rem}.bhd-media-asset h3{margin:0 0 .35rem}.bhd-media-asset p{margin:0 0 1rem;line-height:1.45}.bhd-media-asset .bhd-page__button{margin-top:auto}.bhd-media-facts{padding-left:1.25rem}.bhd-media-facts li+li{margin-top:.75rem}.bhd-media-note{margin-top:1rem;padding:.8rem 1rem;border-left:4px solid #2d6fa8;background:#f4f9fd}.bhd-media-form-wrap{margin:clamp(2rem,5vw,4rem) 0;padding:clamp(1.25rem,3vw,2.5rem);border:1px solid #dfe8f3;border-radius:20px;background:#f7fbff}.bhd-media-form-head{max-width:820px;margin-bottom:1.5rem}.bhd-media-form-head h2{margin:.2rem 0 .65rem}.bhd-media-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem 1.15rem}.bhd-media-form-grid label{display:flex;flex-direction:column;gap:.4rem;font-weight:600}.bhd-media-form-grid input,.bhd-media-form-grid select,.bhd-media-form-grid textarea{width:100%;box-sizing:border-box;border:1px solid #cdd9e7;border-radius:12px;background:#fff;padding:.85rem .9rem;font:inherit;color:inherit}.bhd-media-form-grid textarea{resize:vertical}.bhd-media-form-grid input:focus,.bhd-media-form-grid select:focus,.bhd-media-form-grid textarea:focus{outline:2px solid #173f7a;outline-offset:2px}.bhd-media-form-span{grid-column:1/-1}.bhd-media-form-status{padding:1rem 1.1rem;margin:0 0 1rem;border-radius:12px;background:#eaf7ef}.bhd-media-submit{margin-top:1.2rem}.bhd-media-submit .bhd-page__button{border:0;cursor:pointer}@media(max-width:990px){.bhd-media-assets__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.bhd-media-assets__grid,.bhd-media-form-grid{grid-template-columns:1fr}.bhd-media-form-span{grid-column:auto}.bhd-media-asset{display:grid;grid-template-columns:120px 1fr}.bhd-media-asset__image{height:100%;aspect-ratio:auto;min-height:150px}.bhd-media-asset>div{padding:.85rem}}
</style>
