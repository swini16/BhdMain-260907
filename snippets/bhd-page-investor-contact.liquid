{% render 'bhd-page-header',
  family: 'Connect',
  parent: 'Investor Relations',
  parent_url: '/pages/investor-relations',
  eyebrow: 'Capital, Advice & Connections',
  title: 'Investor & Advisor Interest',
  intro: 'Best Hydrate welcomes conversations with prospective investors, experienced advisors, strategic partners and senior operators who can help accelerate the company’s next stage.',
  hero_image: 'https://images.pexels.com/photos/8297652/pexels-photo-8297652.jpeg?auto=compress&cs=tinysrgb&w=1800',
  hero_alt: 'Two professionals reviewing business documents during a meeting'
%}

<div class="bhd-page__keypoints" aria-label="Investor and advisor interest"><div><strong>Investors</strong><span>Prospective lead and follow-on investors interested in an early-stage hydration platform.</span></div><div><strong>Advisors & connectors</strong><span>Experienced people who can sharpen the strategy or make high-value introductions.</span></div><div><strong>Strategic operators</strong><span>Partners and senior leaders who can strengthen commercialization, research or execution.</span></div></div>

<section class="bhd-page__feature"><div><p class="bhd-page__kicker">Build the next stage with us</p><h2>Capital is valuable. So are judgment, access and execution.</h2><p>Best Hydrate is exploring a disciplined seed financing while continuing to strengthen its commercial, scientific and development platform. We are interested in people who can contribute more than capital alone, whether through experience, introductions, strategic capability or operating leadership.</p></div></section>

<section class="bhd-ir-form-wrap" id="interest-form" aria-labelledby="InvestorInterestHeading-{{ section.id }}">
  <div class="bhd-ir-form-head"><p class="bhd-page__kicker">Investor & advisor inquiry</p><h2 id="InvestorInterestHeading-{{ section.id }}">Start a conversation</h2><p>Tell us who you are, what interests you and where you may fit.</p></div>
  {% form 'contact', id: 'BhdInvestorInterest' %}
    <input type="hidden" name="contact[Inquiry type]" value="Investor Relations / Advisor Interest">
    {% if form.posted_successfully? %}<div class="bhd-ir-form-status" role="status"><strong>Thank you.</strong> Your inquiry was sent successfully.</div>{% endif %}
    {{ form.errors | default_errors }}

    <div class="bhd-ir-form-grid">
      <label><span>Name *</span><input type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></label>
      <label><span>Email *</span><input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></label>
      <label><span>Organization / fund</span><input type="text" name="contact[Organization or fund]"></label>
      <label><span>Role / title</span><input type="text" name="contact[Role or title]"></label>
      <label><span>Website / LinkedIn</span><input type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" name="contact[Website or LinkedIn]" placeholder="besthydrate.com or linkedin.com/in/..."></label>
      <label><span>Introduced by</span><input type="text" name="contact[Introduced by]" placeholder="Optional"></label>
    </div>

    <fieldset class="bhd-ir-interest"><legend>I’m interested in</legend><div class="bhd-ir-check-grid">
      <label><input type="checkbox" name="contact[Interest - Strategic advice]" value="Yes"><span><strong>Strategic advice</strong><small>Company building, commercialization or financing.</small></span></label>
      <label><input type="checkbox" name="contact[Interest - Introduction]" value="Yes"><span><strong>Making an introduction</strong><small>Investor, operator, researcher or partner.</small></span></label>
      <label><input type="checkbox" name="contact[Interest - Lead investor]" value="Yes"><span><strong>Lead investor</strong><small>Exploring a potential lead role.</small></span></label>
      <label><input type="checkbox" name="contact[Interest - Follow-on investor]" value="Yes"><span><strong>Follow-on investor</strong><small>Potential participation in a future cohort.</small></span></label>
      <label><input type="checkbox" name="contact[Interest - Strategic partner]" value="Yes"><span><strong>Strategic partnership</strong><small>Commercial, research, manufacturing, clinical or humanitarian capability.</small></span></label>
      <label><input type="checkbox" name="contact[Interest - Marketing leadership]" value="Yes"><span><strong>Marketing leadership</strong><small>Executive or senior operating opportunity.</small></span></label>
    </div></fieldset>

    <div class="bhd-ir-form-grid">
      <label><span>Investor role</span><select name="contact[Investor role]"><option value="">Not applicable / select</option><option>Potential lead</option><option>Potential follow-on</option><option>Either</option><option>Advisor / connector only</option></select></label>
      <label><span>Typical investment range</span><input type="text" name="contact[Typical investment range]" placeholder="Optional"></label>
      <label class="bhd-ir-form-span"><span>Investment mandate / relevant experience</span><input type="text" name="contact[Mandate or relevant experience]" placeholder="Stage, sector, geography or operating experience"></label>
      <label class="bhd-ir-form-span"><span>What interests you about Best Hydrate?</span><textarea name="contact[What caught your attention]" rows="3"></textarea></label>
      <label class="bhd-ir-form-span"><span>Message *</span><textarea name="contact[body]" rows="6" required placeholder="Share your perspective, proposed connection, investment interest or suggested next step."></textarea></label>
      <label><span>Preferred next step</span><select name="contact[Preferred next step]"><option value="">Select</option><option>Advice exchange</option><option>Introduction call</option><option>Company / deck overview</option><option>Investor conversation</option><option>Diligence discussion</option><option>Marketing leadership conversation</option><option>Other</option></select></label>
      <label><span>Timing</span><input type="text" name="contact[Timing]" placeholder="Optional"></label>
    </div>

    <div class="bhd-ir-submit"><button class="bhd-page__button" type="submit">Start a Conversation</button><p>Submitting this form does not create an investment commitment or constitute an offer or acceptance of funds.</p></div>
  {% endform %}
</section>

<section class="bhd-page__brand-context"><div><p class="bhd-page__kicker">Investor context</p><h2>Explore the opportunity</h2><p>Review Best Hydrate’s current foundation, growth platform and next-stage priorities.</p></div><div class="bhd-page__brand-actions"><a class="bhd-page__button" href="/pages/investor-overview">Investor Overview</a><a class="bhd-page__button bhd-page__button--secondary" href="/pages/corporate-information">Corporate Information</a></div></section>

<section class="bhd-page__references" aria-labelledby="InvestorDisclaimer-{{ section.id }}"><h2 id="InvestorDisclaimer-{{ section.id }}">Investor notice</h2><p class="bhd-page__reference-note">This website provides general company information only. It is not an offer to sell or a solicitation of an offer to buy securities, and it does not provide investment, legal, tax or accounting advice.</p></section>

<style>
.bhd-ir-form-wrap{margin:clamp(2rem,5vw,4rem) 0;padding:clamp(1.25rem,3vw,2.5rem);border:1px solid #dfe8f3;border-radius:20px;background:#f7fbff}.bhd-ir-form-head{max-width:820px;margin-bottom:1.5rem}.bhd-ir-form-head h2{margin:.2rem 0 .65rem}.bhd-ir-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem 1.15rem;margin:1.2rem 0}.bhd-ir-form-grid label,.bhd-ir-interest label{display:flex;flex-direction:column;gap:.4rem;font-weight:600}.bhd-ir-form-grid input,.bhd-ir-form-grid select,.bhd-ir-form-grid textarea{width:100%;box-sizing:border-box;border:1px solid #cdd9e7;border-radius:12px;background:#fff;padding:.85rem .9rem;font:inherit;color:inherit}.bhd-ir-form-grid textarea{resize:vertical}.bhd-ir-form-grid input:focus,.bhd-ir-form-grid select:focus,.bhd-ir-form-grid textarea:focus{outline:2px solid #173f7a;outline-offset:2px}.bhd-ir-form-span{grid-column:1/-1}.bhd-ir-interest{border:0;padding:0;margin:1.6rem 0}.bhd-ir-interest legend{font-weight:700;font-size:1.05em;margin-bottom:.8rem}.bhd-ir-check-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.bhd-ir-check-grid label{display:flex;flex-direction:row;align-items:flex-start;gap:.7rem;padding:1rem;border:1px solid #d9e3ee;border-radius:14px;background:#fff;font-weight:400;cursor:pointer}.bhd-ir-check-grid input{margin-top:.2rem}.bhd-ir-check-grid span{display:flex;flex-direction:column;gap:.15rem}.bhd-ir-check-grid small{font-weight:400;opacity:.75}.bhd-ir-form-status{padding:1rem 1.1rem;margin:0 0 1rem;border-radius:12px;background:#eaf7ef}.bhd-ir-submit{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1rem}.bhd-ir-submit p{margin:0;max-width:680px;font-size:.9em;opacity:.72}.bhd-ir-submit .bhd-page__button{border:0;cursor:pointer}@media(max-width:760px){.bhd-ir-form-grid,.bhd-ir-check-grid{grid-template-columns:1fr}.bhd-ir-form-span{grid-column:auto}}
</style>
