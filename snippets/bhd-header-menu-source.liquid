{% assign bhd_navigation = linklists['new-menu'] %}
{% if bhd_navigation != blank and bhd_navigation.links.size > 0 %}
  {% liquid
    assign bhd_current_path = request.path | split: '?' | first | split: '#' | first
    assign bhd_context_depth = 0
    assign bhd_context_1_label = ''
    assign bhd_context_1_url = ''
    assign bhd_context_2_label = ''
    assign bhd_context_2_url = ''
    assign bhd_context_3_label = ''
    assign bhd_context_3_url = ''

    for top_link in bhd_navigation.links
      assign bhd_top_path = top_link.url | split: '?' | first | split: '#' | first
      if shop.url != blank
        assign bhd_top_path = bhd_top_path | remove: shop.url
      endif
      if bhd_top_path contains '://'
        assign bhd_top_path = bhd_top_path | remove: 'https://' | remove: 'http://'
        if shop.domain != blank
          assign bhd_top_path = bhd_top_path | remove: shop.domain
        endif
        if shop.permanent_domain != blank
          assign bhd_top_path = bhd_top_path | remove: shop.permanent_domain
        endif
      endif

      if bhd_top_path == bhd_current_path and bhd_context_depth < 1
        assign bhd_context_depth = 1
        assign bhd_context_1_label = top_link.title
        assign bhd_context_1_url = top_link.url
      endif

      for second_link in top_link.links
        assign bhd_second_path = second_link.url | split: '?' | first | split: '#' | first
        if shop.url != blank
          assign bhd_second_path = bhd_second_path | remove: shop.url
        endif
        if bhd_second_path contains '://'
          assign bhd_second_path = bhd_second_path | remove: 'https://' | remove: 'http://'
          if shop.domain != blank
            assign bhd_second_path = bhd_second_path | remove: shop.domain
          endif
          if shop.permanent_domain != blank
            assign bhd_second_path = bhd_second_path | remove: shop.permanent_domain
          endif
        endif

        if bhd_second_path == bhd_current_path and bhd_context_depth < 2
          assign bhd_context_depth = 2
          assign bhd_context_1_label = top_link.title
          assign bhd_context_1_url = top_link.url
          assign bhd_context_2_label = second_link.title
          assign bhd_context_2_url = second_link.url
        endif

        for third_link in second_link.links
          assign bhd_third_path = third_link.url | split: '?' | first | split: '#' | first
          if shop.url != blank
            assign bhd_third_path = bhd_third_path | remove: shop.url
          endif
          if bhd_third_path contains '://'
            assign bhd_third_path = bhd_third_path | remove: 'https://' | remove: 'http://'
            if shop.domain != blank
              assign bhd_third_path = bhd_third_path | remove: shop.domain
            endif
            if shop.permanent_domain != blank
              assign bhd_third_path = bhd_third_path | remove: shop.permanent_domain
            endif
          endif

          if bhd_third_path == bhd_current_path and bhd_context_depth < 3
            assign bhd_context_depth = 3
            assign bhd_context_1_label = top_link.title
            assign bhd_context_1_url = top_link.url
            assign bhd_context_2_label = second_link.title
            assign bhd_context_2_url = second_link.url
            assign bhd_context_3_label = third_link.title
            assign bhd_context_3_url = third_link.url
          endif
        endfor
      endfor
    endfor
  %}

  <template id="BhdAdminMobileMenu">
    {% for top_link in bhd_navigation.links %}
      {% if top_link.title == 'Shop' %}
        <a class="bhd-header__mobile-shop" href="{{ top_link.url }}">{{ top_link.title | escape }}</a>
      {% else %}
        <div class="bhd-header__mobile-main" data-mobile-main>
          <div class="bhd-header__mobile-main-row">
            <a href="{{ top_link.url }}">{{ top_link.title | escape }}</a>
            <button type="button" class="bhd-header__mobile-toggle" data-menu-toggle aria-expanded="false" aria-label="Open {{ top_link.title | escape }} menu"><span aria-hidden="true">⌄</span></button>
          </div>
          <div class="bhd-header__mobile-level-one" data-menu-panel>
            {% for second_link in top_link.links %}
              <div class="bhd-header__mobile-tier2">
                <div class="bhd-header__mobile-tier2-split">
                  <a class="bhd-header__mobile-tier2-link" href="{{ second_link.url }}">{{ second_link.title | escape }}</a>
                  {% if second_link.links.size > 0 %}<button type="button" class="bhd-header__mobile-tier2-toggle" aria-expanded="false" aria-label="Open {{ second_link.title | escape }} submenu"><span aria-hidden="true"></span></button>{% endif %}
                </div>
                {% if second_link.links.size > 0 %}<div class="bhd-header__mobile-tier3">{% for third_link in second_link.links %}<a href="{{ third_link.url }}">{{ third_link.title | escape }}</a>{% endfor %}</div>{% endif %}
              </div>
            {% endfor %}
            <a class="bhd-header__mobile-discuss" href="/blogs/news"><img src="{{ 'bhd-discuss-icon.webp' | asset_url }}" alt="" width="96" height="96"><strong>{% case top_link.title %}{% when 'Science' %}Discuss Science Blog{% when 'Solutions' %}Discuss Solutions Blog{% else %}Community Blog{% endcase %}</strong></a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </template>

  <template id="BhdAdminDesktopMenu">
    {% for top_link in bhd_navigation.links %}
      {% if top_link.title == 'Shop' %}
        <a href="{{ top_link.url }}" class="bhd-header__shop-cta">{{ top_link.title | escape }}</a>
      {% else %}
        <div class="bhd-header__main-item" data-main-item>
          <div class="bhd-header__split-button"><a class="bhd-header__main-link" href="{{ top_link.url }}">{{ top_link.title | escape }}</a><button type="button" class="bhd-header__main-toggle" data-menu-toggle aria-expanded="false" aria-label="Open {{ top_link.title | escape }} menu"><span aria-hidden="true">⌄</span></button></div>
          <div class="bhd-header__dropdown-menu" data-menu-panel>
            {% for second_link in top_link.links %}
              <div class="bhd-header__dropdown-child">
                <div class="bhd-header__tier2-split"><a class="bhd-header__tier2-link" href="{{ second_link.url }}">{{ second_link.title | escape }}</a>{% if second_link.links.size > 0 %}<button type="button" class="bhd-header__tier2-toggle" aria-expanded="false" aria-label="Open {{ second_link.title | escape }} submenu"><span aria-hidden="true"></span></button>{% endif %}</div>
                {% if second_link.links.size > 0 %}<div class="bhd-header__tier3">{% for third_link in second_link.links %}<a href="{{ third_link.url }}">{{ third_link.title | escape }}</a>{% endfor %}</div>{% endif %}
              </div>
            {% endfor %}
            <a class="bhd-header__discuss-row" href="/blogs/news"><img src="{{ 'bhd-discuss-icon.webp' | asset_url }}" alt="" width="96" height="96"><strong>{% case top_link.title %}{% when 'Science' %}Discuss Science Blog{% when 'Solutions' %}Discuss Solutions Blog{% else %}Community Blog{% endcase %}</strong></a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </template>

  {% if request.page_type != 'page' and bhd_context_depth > 0 %}
    <template id="BhdMenuContextBreadcrumb">
      <nav class="bhd-menu-context-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        {% if bhd_context_depth == 1 %}
          <span aria-current="page">{{ bhd_context_1_label | escape }}</span>
        {% else %}
          <a href="{{ bhd_context_1_url }}">{{ bhd_context_1_label | escape }}</a>
        {% endif %}
        {% if bhd_context_depth >= 2 %}
          <span aria-hidden="true">›</span>
          {% if bhd_context_depth == 2 %}
            <span aria-current="page">{{ bhd_context_2_label | escape }}</span>
          {% else %}
            <a href="{{ bhd_context_2_url }}">{{ bhd_context_2_label | escape }}</a>
          {% endif %}
        {% endif %}
        {% if bhd_context_depth >= 3 %}
          <span aria-hidden="true">›</span>
          <span aria-current="page">{{ bhd_context_3_label | escape }}</span>
        {% endif %}
      </nav>
    </template>
  {% endif %}

  <style>
    .bhd-menu-context-breadcrumb{box-sizing:border-box;display:flex;align-items:center;flex-wrap:wrap;gap:.65rem;max-width:var(--page-width,120rem);margin:0 auto;padding:2rem 5rem 1.4rem;color:#61718a;font-size:1.4rem;line-height:1.4}
    .bhd-menu-context-breadcrumb a{color:#0b2d67;text-decoration:none}
    .bhd-menu-context-breadcrumb a:hover{text-decoration:underline}
    @media screen and (max-width:749px){.bhd-menu-context-breadcrumb{padding:1.5rem 2rem 1rem;font-size:1.25rem}}
    @media screen and (min-width:990px){
      .bhd-header__main-item:not(.is-open) > .bhd-header__dropdown-menu{display:none!important}
      .bhd-header__main-item.is-open > .bhd-header__dropdown-menu{display:grid!important}
    }
  </style>

  <script>
    (()=>{
      const hydrateHeader=()=>{
        const header=document.querySelector('.bhd-header');
        const mobileTemplate=document.getElementById('BhdAdminMobileMenu');
        const desktopTemplate=document.getElementById('BhdAdminDesktopMenu');
        if(header&&mobileTemplate&&desktopTemplate){
          const mobilePanel=header.querySelector('.bhd-header__mobile-panel');
          const desktopNav=header.querySelector('.bhd-header__nav');
          if(mobilePanel)mobilePanel.replaceChildren(mobileTemplate.content.cloneNode(true));
          if(desktopNav)desktopNav.replaceChildren(desktopTemplate.content.cloneNode(true));
          header.dataset.bhdMenuSource='shopify-main';
        }
      };

      const hydrateContextBreadcrumb=()=>{
        const template=document.getElementById('BhdMenuContextBreadcrumb');
        const main=document.getElementById('MainContent');
        if(!template||!main)return;
        if(main.querySelector('.bhd-breadcrumbs,.bhd-menu-context-breadcrumb'))return;
        main.prepend(template.content.cloneNode(true));
      };

      hydrateHeader();
      if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',hydrateContextBreadcrumb,{once:true});
      else hydrateContextBreadcrumb();
    })();
  </script>

  <script>
    (()=>{
      const closeTier2=(item)=>{
        item.classList.remove('is-tier2-open');
        const button=item.querySelector(':scope > .bhd-header__tier2-split .bhd-header__tier2-toggle');
        if(button)button.setAttribute('aria-expanded','false');
      };
      const closeMain=(item)=>{
        item.classList.remove('is-open');
        const button=item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle]');
        if(button)button.setAttribute('aria-expanded','false');
        item.querySelectorAll('.bhd-header__dropdown-child.is-tier2-open').forEach(closeTier2);
      };
      const positionMenu=(item)=>{
        const menu=item.querySelector(':scope > .bhd-header__dropdown-menu');
        if(!menu)return;
        menu.style.setProperty('--menu-shift-x','0px');
        requestAnimationFrame(()=>{
          const rect=menu.getBoundingClientRect();
          const margin=16;
          let shift=0;
          if(rect.left<margin)shift+=margin-rect.left;
          if(rect.right>window.innerWidth-margin)shift-=rect.right-(window.innerWidth-margin);
          menu.style.setProperty('--menu-shift-x',`${shift}px`);
        });
      };
      const openMain=(item)=>{
        const header=item.closest('.bhd-header');
        header.querySelectorAll('[data-main-item].is-open').forEach(other=>{if(other!==item)closeMain(other)});
        item.classList.add('is-open');
        const button=item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle]');
        if(button)button.setAttribute('aria-expanded','true');
        positionMenu(item);
      };

      document.addEventListener('click',(event)=>{
        if(window.innerWidth<990||!(event.target instanceof Element))return;
        const header=document.querySelector('.bhd-header');
        if(!header)return;

        const mainToggle=event.target.closest('.bhd-header [data-main-item] > .bhd-header__split-button [data-menu-toggle]');
        if(mainToggle){
          event.preventDefault();
          event.stopImmediatePropagation();
          const item=mainToggle.closest('[data-main-item]');
          if(item.classList.contains('is-open'))closeMain(item);else openMain(item);
          return;
        }

        const tierToggle=event.target.closest('.bhd-header__tier2-toggle');
        if(tierToggle){
          event.preventDefault();
          event.stopImmediatePropagation();
          const item=tierToggle.closest('.bhd-header__dropdown-child');
          const scope=item.closest('.bhd-header__dropdown-menu');
          scope.querySelectorAll('.bhd-header__dropdown-child.is-tier2-open').forEach(other=>{if(other!==item)closeTier2(other)});
          const opening=!item.classList.contains('is-tier2-open');
          if(opening){item.classList.add('is-tier2-open');tierToggle.setAttribute('aria-expanded','true');}
          else closeTier2(item);
          return;
        }

        if(!event.target.closest('.bhd-header__main-item')){
          header.querySelectorAll('[data-main-item].is-open').forEach(closeMain);
        }
      },true);

      document.addEventListener('keydown',(event)=>{
        if(event.key!=='Escape'||window.innerWidth<990)return;
        document.querySelectorAll('.bhd-header [data-main-item].is-open').forEach(closeMain);
      },true);
    })();
  </script>
{% endif %}

{% comment %}Shopify Admin MAIN, handle new-menu, is the live interactive header and hierarchy source. Desktop dropdowns are click-controlled only: toggle opens persistently, same toggle closes, another toggle switches, outside click or Escape closes. URL comparisons are normalized so manual HTTP links match relative storefront request paths on both page and non-page destinations.{% endcomment %}