{% liquid
  assign t_title = page.title
  assign t_intro = ''
  assign t_p1 = ''
  assign t_p2 = ''
  assign t_p3 = ''
  assign t_proof = ''
  assign t_primary = '/products/lemonade-best-hydrate'
  assign t_primary_label = 'Shop Best Hydrate'
  assign t_secondary = '/pages/hydration-science'
  assign t_secondary_label = 'Hydration Science'
  case page.handle
    when 'mission-values'
      assign t_intro = 'We are building practical hydration products with evidence, clarity and responsible claims.'
      assign t_p1 = 'Useful first|Solve a real hydration problem before adding complexity.'
      assign t_p2 = 'Evidence before hype|Separate established evidence from questions still being tested.'
      assign t_p3 = 'Clear communication|Explain the product plainly and keep claims within the evidence.'
      assign t_proof = 'Best Hydrate is an Alberta company with a Health Canada Natural Product Number and published hydration research.'
      assign t_secondary = '/pages/our-story'
      assign t_secondary_label = 'Meet Us'
    when 'why-best-hydrate'
      assign t_intro = 'A low-sugar oral hydration mix designed around glucose, sodium, potassium and bicarbonate.'
      assign t_p1 = 'Low sugar on purpose|Enough glucose to support the formulation without a heavy sugar load.'
      assign t_p2 = 'Simple formula|A short ingredient list with a reason for each component.'
      assign t_p3 = 'Built for use|Portable powder for training, work, travel and everyday hydration needs.'
      assign t_proof = 'For ingredient detail, mechanisms and references, use the dedicated science pages.'
      assign t_secondary = '/pages/our-formula'
      assign t_secondary_label = 'Our Formula'
    when 'partnerships'
      assign t_intro = 'We work with research, retail, performance and community partners where there is a clear fit.'
      assign t_p1 = 'Research|Build evidence around useful hydration questions.'
      assign t_p2 = 'Retail|Put the product where customers already shop.'
      assign t_p3 = 'Community|Work with credible people and organizations using hydration in the real world.'
      assign t_proof = 'Partnerships should create measurable value for both sides, not another layer of branding.'
      assign t_primary = '/pages/contact'
      assign t_primary_label = 'Contact Us'
      assign t_secondary = '/pages/research-partners'
      assign t_secondary_label = 'Research Partnerships'
    when 'jobs-careers'
      assign t_intro = 'Best Hydrate is a small, early-stage company. Roles grow from real operating needs.'
      assign t_p1 = 'Small team|Work is practical and cross-functional.'
      assign t_p2 = 'Evidence-minded|We value careful thinking and clear communication.'
      assign t_p3 = 'Build with us|Future openings will be posted as the company grows.'
      assign t_proof = 'No role should exist simply to make the organization look larger than it is.'
      assign t_primary = '/pages/contact'
      assign t_primary_label = 'Contact Us'
      assign t_secondary = '/pages/our-story'
      assign t_secondary_label = 'Meet Us'
    when 'investor-relations', 'investor-overview'
      assign t_intro = 'Best Hydrate is building from a focused consumer hydration product toward a broader evidence-led hydration business.'
      assign t_p1 = 'Consumer wedge|Start with a product customers can buy and use now.'
      assign t_p2 = 'Evidence|Build credibility through research and disciplined claims.'
      assign t_p3 = 'Expansion|Grow channels, products and applications as evidence and demand support them.'
      assign t_proof = 'Investor materials distinguish the current business from longer-term opportunities.'
      assign t_primary = '/pages/investor-contact'
      assign t_primary_label = 'Investor Inquiry'
      assign t_secondary = '/pages/research-publications'
      assign t_secondary_label = 'Research & Impact'
    when 'active-living'
      assign t_intro = 'Hydration support for active days when water alone may not match meaningful fluid and electrolyte losses.'
      assign t_p1 = 'Prepare|Start activity adequately hydrated.'
      assign t_p2 = 'Perform|Replace fluid and electrolytes when losses become meaningful.'
      assign t_p3 = 'Recover|Continue replacing what the day took out.'
      assign t_proof = 'Needs vary with sweat, heat, duration, diet and the individual.'
    when 'everyday-wellness'
      assign t_intro = 'A simple option for days when you want more than plain water without a heavy sugar load.'
      assign t_p1 = 'Simple|Powder, water, mix.'
      assign t_p2 = 'Portable|Small container for work, travel and daily routines.'
      assign t_p3 = 'Flexible|Use when fluid and electrolyte needs are higher than usual.'
      assign t_proof = 'Hydration needs vary. Best Hydrate is not necessary for every drink or every day.'
    when 'travel-hydration'
      assign t_intro = 'Travel can disrupt normal drinking, meals, climate and activity. Keep hydration simple.'
      assign t_p1 = 'Pack small|Powder is easy to carry.'
      assign t_p2 = 'Mix as needed|Useful when travel increases fluid or electrolyte losses.'
      assign t_p3 = 'Keep drinking|Convenience matters when routines change.'
      assign t_proof = 'Travel hydration still starts with access to safe water and regular fluid intake.'
    when 'work-long-shifts'
      assign t_intro = 'Long shifts can make regular drinking easy to neglect, especially in heat or physical work.'
      assign t_p1 = 'Plan|Bring enough fluid before the shift starts.'
      assign t_p2 = 'Make it easy|Keep hydration accessible during work.'
      assign t_p3 = 'Replace losses|Electrolytes become more relevant when sweating is meaningful.'
      assign t_proof = 'Workplace hydration should fit the job, environment and individual.'
    when 'active-aging'
      assign t_intro = 'Hydration remains important with age, while needs and medical context become more individual.'
      assign t_p1 = 'Drink regularly|Do not rely only on thirst when it is an unreliable cue.'
      assign t_p2 = 'Match the day|Heat and activity can increase needs.'
      assign t_p3 = 'Consider health context|Medications and medical conditions can change appropriate fluid or electrolyte intake.'
      assign t_proof = 'People with fluid, sodium or potassium restrictions should follow their clinician’s guidance.'
      assign t_primary = '/pages/hydration-science'
      assign t_primary_label = 'Hydration Science'
    when 'recovery-rehabilitation'
      assign t_intro = 'Hydration can support normal recovery routines, but rehabilitation needs are individual.'
      assign t_p1 = 'Start with basics|Adequate fluid intake comes first.'
      assign t_p2 = 'Replace losses|Electrolytes may matter when sweating or other losses are meaningful.'
      assign t_p3 = 'Respect the plan|Clinical rehabilitation guidance takes priority over general product information.'
      assign t_proof = 'Best Hydrate is not presented as a treatment or rehabilitation therapy.'
      assign t_primary = '/pages/hydration-science'
      assign t_primary_label = 'Hydration Science'
    when 'clinical-hydration', 'healthcare-applications'
      assign t_intro = 'Healthcare-relevant hydration questions require stronger evidence and tighter boundaries than consumer use.'
      assign t_p1 = 'Established first|Start with accepted hydration physiology and oral rehydration principles.'
      assign t_p2 = 'Product claims stay narrow|Do not turn plausible mechanisms into clinical outcomes.'
      assign t_p3 = 'Research before expansion|New healthcare applications require appropriate study.'
      assign t_proof = 'These pages describe research context, not medical advice or established treatment claims for Best Hydrate.'
      assign t_primary = '/pages/research-publications'
      assign t_primary_label = 'Research & Impact'
      assign t_secondary = '/pages/clinical-development'
      assign t_secondary_label = 'Clinical Development'
    when 'clinical-development', 'clinical-program', 'pilot-studies'
      assign t_intro = 'Clinical development is a research pathway, not a list of established Best Hydrate benefits.'
      assign t_p1 = 'Question|Define a useful hydration question.'
      assign t_p2 = 'Study|Use an appropriate design and outcome measures.'
      assign t_p3 = 'Publish|Let results determine what can responsibly be said next.'
      assign t_proof = 'Planned or exploratory work is labelled separately from completed evidence.'
      assign t_primary = '/pages/research-publications'
      assign t_primary_label = 'Research & Impact'
      assign t_secondary = '/pages/contact'
      assign t_secondary_label = 'Research Inquiry'
    when 'research-impact', 'research-partnerships'
      assign t_intro = 'Research should answer useful questions and make future product or health claims more precise.'
      assign t_p1 = 'Relevant questions|Study problems that matter outside the lab.'
      assign t_p2 = 'Appropriate methods|Match study design to the claim being tested.'
      assign t_p3 = 'Transparent results|Publish and distinguish findings from interpretation.'
      assign t_proof = 'Best Hydrate’s research program is growing; completed work and future questions are kept separate.'
      assign t_primary = '/pages/research-publications'
      assign t_primary_label = 'Publications'
      assign t_secondary = '/pages/contact'
      assign t_secondary_label = 'Research Inquiry'
    when 'publications', 'research-publications'
      assign t_intro = 'The evidence hub for published work, current research and the limits of what the evidence shows.'
      assign t_p1 = 'Published|Peer-reviewed work is identified directly.'
      assign t_p2 = 'In progress|Ongoing research is not presented as a result.'
      assign t_p3 = 'Product evidence|General hydration science is separated from Best Hydrate-specific evidence.'
      assign t_proof = 'Read the underlying publications for methods, populations, outcomes and limitations.'
      assign t_primary = '/pages/hydration-science'
      assign t_primary_label = 'Hydration Science'
      assign t_secondary = '/pages/contact'
      assign t_secondary_label = 'Research Inquiry'
    when 'eco-humanitarian', 'humanitarian-partnerships'
      assign t_intro = 'Hydration access matters most where safe water, supply chains and health resources are constrained.'
      assign t_p1 = 'Context first|A product is only useful when it fits local needs and infrastructure.'
      assign t_p2 = 'Partners matter|Work through organizations that understand the setting.'
      assign t_p3 = 'Evidence matters|Humanitarian intent does not substitute for appropriate validation.'
      assign t_proof = 'Best Hydrate is exploring this area carefully; it is not presented as a deployed humanitarian solution.'
      assign t_primary = '/pages/contact'
      assign t_primary_label = 'Partnership Inquiry'
      assign t_secondary = '/pages/research-publications'
      assign t_secondary_label = 'Research & Impact'
    when 'retail-distribution'
      assign t_intro = 'Retail expansion should follow customer demand, reliable supply and a clear reason for the product to be on shelf.'
      assign t_p1 = 'Product fit|A differentiated hydration product with simple positioning.'
      assign t_p2 = 'Reliable supply|Growth should not outrun fulfillment.'
      assign t_p3 = 'Measured rollout|Learn from each channel before adding complexity.'
      assign t_proof = 'Best Hydrate currently sells online while building broader distribution.'
      assign t_primary = '/pages/contact'
      assign t_primary_label = 'Retail Inquiry'
      assign t_secondary = '/products/lemonade-best-hydrate'
      assign t_secondary_label = 'View Product'
  endcase
%}

{% render 'bhd-page-header', family: 'Best Hydrate', eyebrow: 'Best Hydrate', title: t_title, intro: t_intro %}

<div class="bhd-page__keypoints" aria-label="Key points">
  {% assign a = t_p1 | split: '|' %}<div><strong>{{ a[0] }}</strong><span>{{ a[1] }}</span></div>
  {% assign a = t_p2 | split: '|' %}<div><strong>{{ a[0] }}</strong><span>{{ a[1] }}</span></div>
  {% assign a = t_p3 | split: '|' %}<div><strong>{{ a[0] }}</strong><span>{{ a[1] }}</span></div>
</div>

<section class="bhd-page__feature"><div><p class="bhd-page__kicker">Why it matters</p><h2>What to know</h2><p>{{ t_proof }}</p></div></section>

<section class="bhd-page__brand-context"><div><p class="bhd-page__kicker">Next</p><h2>Choose the next step.</h2></div><div class="bhd-page__brand-actions"><a class="bhd-page__button" href="{{ t_primary }}">{{ t_primary_label }}</a><a class="bhd-page__button bhd-page__button--secondary" href="{{ t_secondary }}">{{ t_secondary_label }}</a></div></section>
