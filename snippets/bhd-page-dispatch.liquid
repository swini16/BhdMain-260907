  {% when 'clinical-development', 'clinical-program', 'pilot-studies', 'healthcare-applications' %}
    {% render 'bhd-page-clinical-development' %}
  {% when 'research-publications', 'publications', 'current-research', 'research-partners', 'research-impact' %}{% render 'bhd-page-research-publications' %}
  {% when 'product-details' %}{% render 'bhd-page-product-details' %}
  {% when 'directions' %}{% render 'bhd-page-directions' %}
  {% when 'q-a' %}{% render 'bhd-page-faq' %}
  {% when 'performance-hydration' %}{% render 'bhd-page-performance-hydration' %}
  {% when 'endurance-hydration' %}{% render 'bhd-page-endurance' %}
