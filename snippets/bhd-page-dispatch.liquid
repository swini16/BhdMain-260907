    when 'our-story', 'mission-values', 'why-best-hydrate', 'jobs-careers', 'partnerships', 'research-partnerships', 'retail-distribution', 'humanitarian-partnerships', 'eco-humanitarian', 'everyday-wellness', 'work-long-shifts', 'travel-hydration', 'active-living'
      assign show_enrichment = false
    when 'investor-relations', 'investor-overview', 'corporate-information', 'investor-contact'
      assign show_enrichment = false
  endcase
  if is_dedicated_paid_lp
    assign show_enrichment = false
  endif
%}
