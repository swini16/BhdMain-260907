{% case page.handle %}
  {% when 'hydration-science' %}
    {% render 'bhd-page-hydration-science' %}
  {% when 'how-hydration-works' %}
    {% render 'bhd-page-how-hydration-works' %}
  {% when 'electrolytes' %}
    {% render 'bhd-page-electrolytes' %}
  {% when 'glucose-water-absorption' %}
    {% render 'bhd-page-glucose-water-absorption' %}
  {% when 'our-formula' %}
    {% render 'bhd-page-our-formula' %}
  {% else %}
    <nav class="bhd-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">{{ page.title }}</span>
    </nav>
    <div class="bhd-page-fallback__content">
      <h1>{{ page.title }}</h1>
      <div class="rte">{{ page.content }}</div>
    </div>
{% endcase %}
