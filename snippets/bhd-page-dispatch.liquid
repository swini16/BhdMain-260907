  {% when 'events' %}{% render 'bhd-page-events' %}
  {% when 'contact' %}{% render 'bhd-page-contact' %}
  {% else %}
    {% render 'bhd-page-breadcrumbs', page_handle: page.handle, current_title: page.title %}
    {% assign rendered_page_content = page.content %}
    {% if page.handle contains 'lp-' and rendered_page_content contains '<p><small>Guide ' %}
      {% assign guide_label_parts = rendered_page_content | split: '</small></p>' %}
      {% assign rendered_page_content = guide_label_parts | slice: 1, 999 | join: '</small></p>' %}
    {% endif %}
    <div class="bhd-page-fallback__content{% if is_consumer_conversion_lp %} bhd-page-fallback__content--consumer-lp{% endif %}">
      <h1>{{ page.title }}</h1>
      {% if is_consumer_conversion_lp %}
        {% render 'bhd-lp-conversion-open' %}
      {% endif %}
      <div class="rte">{{ rendered_page_content }}</div>
    </div>
    {% render 'bhd-menu-descendants' %}
