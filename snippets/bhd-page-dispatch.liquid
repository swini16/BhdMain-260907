    {% render 'bhd-page-breadcrumbs', page_handle: page.handle, current_title: page.title %}
    <div class="bhd-page-fallback__content"><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div></div>
    {% render 'bhd-menu-descendants' %}
