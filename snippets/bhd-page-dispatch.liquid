  {% when 'lp-10-run-the-river-edmonton' %}{% render 'bhd-page-lp-run-the-river-edmonton' %}
  {% when 'lp-11-nashville-heat' %}{% render 'bhd-page-lp-nashville-heat' %}
  {% when 'lp-12-bicarb-bonus' %}{% render 'bhd-page-lp-bicarb-bonus' %}
  {% when 'recovery-hydration' %}{% render 'bhd-page-recovery' %}
  {% when 'everyday-wellness' %}{% render 'bhd-page-everyday-wellness' %}
  {% when 'work-long-shifts' %}{% render 'bhd-page-work-long-shifts' %}
  {% when 'travel-hydration' %}{% render 'bhd-page-travel' %}
