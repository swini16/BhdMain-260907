{% liquid
  assign is_dedicated_paid_lp = false
  case page.handle
    when 'lp-02f-hydration-thats-not-too-sweet', 'lp-10-eps-half-marathon-edmonton', 'lp-10-run-the-river-edmonton', 'lp-11-nashville-heat', 'lp-12-bicarb-bonus'
      assign is_dedicated_paid_lp = true
  endcase

  assign is_consumer_conversion_lp = false
  case page.handle
    when 'lp-01-hydration-is-more-than-water', 'lp-02-six-ingredients', 'lp-04-hydration-follows-the-session', 'lp-04a-heat-sweat-hydration', 'lp-04b-sweat-rate-changes-the-plan', 'lp-05-cold-dry-air', 'lp-05a-winter-hydration', 'lp-05b-long-winter-workdays', 'lp-07-hydration-for-long-workdays', 'lp-07a-when-electrolytes-make-sense', 'lp-02c-everyday-hydration', 'lp-02d-what-makes-best-hydrate-different', 'lp-02e-electrolyte-drink-mix-what-to-look-for', 'lp-09-summer-hydration', 'lp-09a-hot-days-hydration'
      assign is_consumer_conversion_lp = true
  endcase

  assign show_lp_sales_close = false
  if page.handle contains 'lp-'
    assign show_lp_sales_close = true
  endif
  case page.handle
    when 'lp-03-research-milestone', 'lp-03a-what-the-review-means', 'lp-03b-from-review-to-direct-study', 'lp-06-clinical-hydration-context', 'lp-06a-when-context-changes-hydration', 'lp-06b-oral-hydration-care-plan', 'lp-08-hydration-access', 'lp-02f-hydration-thats-not-too-sweet', 'lp-10-eps-half-marathon-edmonton', 'lp-10-run-the-river-edmonton', 'lp-11-nashville-heat', 'lp-12-bicarb-bonus'
      assign show_lp_sales_close = false
  endcase
%}

