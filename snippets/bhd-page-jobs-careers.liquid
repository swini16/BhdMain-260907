{% assign job_openings = shop.metaobjects.job_opening.values %}
{% assign open_job_count = 0 %}
{% for job in job_openings %}
  {% if job.is_open.value == true %}
    {% assign open_job_count = open_job_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% render 'bhd-page-header',
  family: 'Connect',
  parent: 'Company & People',
  parent_url: '/pages/company-people',
  eyebrow: 'Build With Us',
  title: 'Jobs & Careers',
  intro: 'Best Hydrate is a small early-stage company. We post roles when there is real work, funding and ownership to offer.',
  hero_image: 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/bhd-careers-team-20260911.jpg?v=1789147293',
  hero_alt: 'Small collaborative team gathered around a table during a working session'
%}

<div class="bhd-page__keypoints" aria-label="Careers at Best Hydrate">
  <div><strong>Small team</strong><span>Roles may cross functions and come with real ownership.</span></div>
  <div><strong>Science-first</strong><span>We value clear thinking and evidence over hype.</span></div>
  <div><strong>Hiring deliberately</strong><span>We add people when the work justifies it.</span></div>
</div>

<section class="bhd-page__feature" id="current-openings">
  <div>
    <p class="bhd-page__kicker">Current openings</p>
    {% if open_job_count > 0 %}
      <h2>Join Best Hydrate</h2>
      <div class="bhd-page__cards bhd-page__cards--4">
        {% for job in job_openings %}
          {% if job.is_open.value == true %}
            <article>
              <h3>{{ job.title.value | escape }}</h3>
              {% if job.department.value != blank or job.location.value != blank or job.employment_type.value != blank %}
                <p><strong>
                  {% if job.department.value != blank %}{{ job.department.value | escape }}{% endif %}
                  {% if job.location.value != blank %}{% if job.department.value != blank %} · {% endif %}{{ job.location.value | escape }}{% endif %}
                  {% if job.employment_type.value != blank %}{% if job.department.value != blank or job.location.value != blank %} · {% endif %}{{ job.employment_type.value | escape }}{% endif %}
                </strong></p>
              {% endif %}
              {% if job.summary.value != blank %}<p>{{ job.summary.value | escape | newline_to_br }}</p>{% endif %}
              {% if job.apply_url.value != blank %}<p><a class="bhd-page__button" href="{{ job.apply_url.value | escape }}">Apply</a></p>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <h2>No formal roles are posted right now</h2>
      <p>If you see an unusually strong fit with the work, you can still introduce yourself. We would rather post a real opportunity when it exists than keep vague placeholder jobs online.</p>
      <div class="bhd-page__brand-actions">
        <a class="bhd-page__button" href="/pages/contact">Introduce Yourself</a>
        <a class="bhd-page__button bhd-page__button--secondary" href="/blogs/news">Company Updates</a>
      </div>
    {% endif %}
  </div>
</section>

<section class="bhd-page__cards-section">
  <p class="bhd-page__kicker">Where we may hire next</p>
  <h2>Capabilities that fit Best Hydrate</h2>
  <div class="bhd-page__cards bhd-page__cards--4">
    <article><h3>Research & Clinical</h3><p>Study coordination, evidence review, data and research communication.</p></article>
    <article><h3>Growth & Retail</h3><p>Retail development, partnerships, field sales and customer education.</p></article>
    <article><h3>Operations</h3><p>Supply, quality, finance, systems and project execution.</p></article>
    <article><h3>Humanitarian & Access</h3><p>Implementation, local partnerships and responsible access work.</p></article>
  </div>
</section>

<section class="bhd-page__prose-grid">
  <article class="bhd-page__prose">
    <p class="bhd-page__kicker">What tends to fit</p>
    <h2>People who can make progress in an unfinished system</h2>
    <p>We value people who ask good questions, work well with imperfect information, document what they learn and improve the system for the next person.</p>
  </article>
  <aside class="bhd-page__callout">
    <span class="bhd-page__callout-label">Interested?</span>
    <h3>Tell us what problem you could help solve.</h3>
    <a class="bhd-page__button" href="/pages/contact">Contact Best Hydrate</a>
  </aside>
</section>
{% comment %}Editorial live-sync marker 2026-09-26 bhd-page-jobs-careers.liquid{% endcomment %}
