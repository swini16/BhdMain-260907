{% liquid
  assign bhd_menu = linklists['new-menu']
  assign current_path = request.path | split: '?' | first | split: '#' | first
  assign current_label = current_title | default: page.title

  assign menu_depth = 0
  assign level_1_label = ''
  assign level_1_url = ''
  assign level_2_label = ''
  assign level_2_url = ''
  assign level_3_label = ''
  assign level_3_url = ''

  if bhd_menu != blank
    for top_link in bhd_menu.links
      assign top_path = top_link.url | split: '?' | first | split: '#' | first
      if shop.url != blank
        assign top_path = top_path | remove: shop.url
      endif
      if top_path contains '://'
        assign top_path = top_path | remove: 'https://' | remove: 'http://'
        if shop.domain != blank
          assign top_path = top_path | remove: shop.domain
        endif
        if shop.permanent_domain != blank
          assign top_path = top_path | remove: shop.permanent_domain
        endif
      endif

      if preferred_family == blank or top_link.title == preferred_family
        if top_path != blank
          if current_path == top_path or current_path contains top_path
            if menu_depth < 1
              assign menu_depth = 1
              assign level_1_label = top_link.title
              assign level_1_url = top_link.url
              assign level_2_label = ''
              assign level_2_url = ''
              assign level_3_label = ''
              assign level_3_url = ''
            endif
          endif
        endif

        for second_link in top_link.links
          assign second_path = second_link.url | split: '?' | first | split: '#' | first
          if shop.url != blank
            assign second_path = second_path | remove: shop.url
          endif
          if second_path contains '://'
            assign second_path = second_path | remove: 'https://' | remove: 'http://'
            if shop.domain != blank
              assign second_path = second_path | remove: shop.domain
            endif
            if shop.permanent_domain != blank
              assign second_path = second_path | remove: shop.permanent_domain
            endif
          endif

          if second_path != blank
            if current_path == second_path or current_path contains second_path
              if menu_depth < 2
                assign menu_depth = 2
                assign level_1_label = top_link.title
                assign level_1_url = top_link.url
                assign level_2_label = second_link.title
                assign level_2_url = second_link.url
                assign level_3_label = ''
                assign level_3_url = ''
              endif
            endif
          endif

          for third_link in second_link.links
            assign third_path = third_link.url | split: '?' | first | split: '#' | first
            if shop.url != blank
              assign third_path = third_path | remove: shop.url
            endif
            if third_path contains '://'
              assign third_path = third_path | remove: 'https://' | remove: 'http://'
              if shop.domain != blank
                assign third_path = third_path | remove: shop.domain
              endif
              if shop.permanent_domain != blank
                assign third_path = third_path | remove: shop.permanent_domain
              endif
            endif

            if third_path != blank
              if current_path == third_path or current_path contains third_path
                if menu_depth < 3
                  assign menu_depth = 3
                  assign level_1_label = top_link.title
                  assign level_1_url = top_link.url
                  assign level_2_label = second_link.title
                  assign level_2_url = second_link.url
                  assign level_3_label = third_link.title
                  assign level_3_url = third_link.url
                endif
              endif
            endif
          endfor
        endfor
      endif
    endfor
  endif

  assign fallback_1_label = ''
  assign fallback_1_url = ''
  assign fallback_2_label = ''
  assign fallback_2_url = ''

  if menu_depth == 0
    case page.handle
      when 'athletes-ambassadors'
        assign fallback_1_label = 'Connect'
        assign fallback_1_url = '/pages/connect-overview'
        assign fallback_2_label = 'Company & People'
        assign fallback_2_url = '/pages/company-people'
        assign current_label = 'Athletes & Ambassadors'
      when 'dianna-proctor'
        assign fallback_1_label = 'Connect'
        assign fallback_1_url = '/pages/connect-overview'
        assign fallback_2_label = 'Company & People'
        assign fallback_2_url = '/pages/company-people'
        assign current_label = 'Dianna Proctor'
    endcase
  endif
%}

<nav class="bhd-breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>

  {% if menu_depth > 0 %}
    <span aria-hidden="true">›</span>
    {% if menu_depth == 1 %}
      <span aria-current="page">{{ level_1_label | escape }}</span>
    {% else %}
      <a href="{{ level_1_url }}">{{ level_1_label | escape }}</a>
    {% endif %}

    {% if menu_depth >= 2 %}
      <span aria-hidden="true">›</span>
      {% if menu_depth == 2 %}
        <span aria-current="page">{{ level_2_label | escape }}</span>
      {% else %}
        <a href="{{ level_2_url }}">{{ level_2_label | escape }}</a>
      {% endif %}
    {% endif %}

    {% if menu_depth >= 3 %}
      <span aria-hidden="true">›</span>
      <span aria-current="page">{{ level_3_label | escape }}</span>
    {% endif %}
  {% else %}
    {% if fallback_1_label != blank %}
      <span aria-hidden="true">›</span>
      <a href="{{ fallback_1_url }}">{{ fallback_1_label | escape }}</a>
    {% endif %}
    {% if fallback_2_label != blank %}
      <span aria-hidden="true">›</span>
      <a href="{{ fallback_2_url }}">{{ fallback_2_label | escape }}</a>
    {% endif %}
    <span aria-hidden="true">›</span>
    <span aria-current="page">{{ current_label | escape }}</span>
  {% endif %}
</nav>

{% comment %}
Breadcrumbs use Shopify Admin MAIN, handle new-menu, as the source of truth. Menu URLs are normalized before comparison, and localized storefront request prefixes are tolerated by matching the normalized menu path within request.path. The deepest matching node in the declared family wins.
{% endcomment %}