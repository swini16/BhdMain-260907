<nav class="bhd-breadcrumbs" aria-label="Breadcrumb" data-bhd-breadcrumb-handle="{{ canonical_handle | escape }}" data-bhd-breadcrumb-depth="{{ menu_depth }}">
  <a href="{{ routes.root_url }}">Home</a>

  {% if menu_depth >= 1 %}
    <span aria-hidden="true">›</span>
    {% if menu_depth == 1 %}
      <span aria-current="page">{{ current_label | escape }}</span>
    {% else %}
      <a href="{{ level_1_url }}">{{ level_1_label | escape }}</a>
    {% endif %}
  {% endif %}

  {% if menu_depth >= 2 %}
    <span aria-hidden="true">›</span>
    {% if menu_depth == 2 %}
      <span aria-current="page">{{ current_label | escape }}</span>
    {% else %}
      <a href="{{ level_2_url }}">{{ level_2_label | escape }}</a>
    {% endif %}
  {% endif %}

  {% if menu_depth >= 3 %}
    <span aria-hidden="true">›</span>
    <span aria-current="page">{{ current_label | escape }}</span>
  {% elsif menu_depth == 0 %}
    <span aria-hidden="true">›</span>
    <span aria-current="page">{{ current_label | escape }}</span>
  {% endif %}
</nav>

{% comment %}
Canonical Page breadcrumbs are deterministic by Shopify Page handle. They mirror the current MAIN information architecture and do not depend on runtime menu traversal, URL localization, or linklist cache state. Update this map whenever MAIN hierarchy changes.
