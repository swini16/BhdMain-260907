{% liquid
  assign bhd_menu = linklists['new-menu']
  assign current_path = page.url | default: request.path
  assign current_label = current_title | default: page.title

  assign menu_depth = 0
  assign level_1_label = ''
  assign level_1_url = ''
  assign level_2_label = ''
  assign level_2_url = ''
  assign level_3_label = ''
  assign level_3_url = ''

  if bhd_menu != blank
    for top_link in bhd_menu.links
      if preferred_family == blank or top_link.title == preferred_family
        if top_link.url == current_path and menu_depth < 1
          assign menu_depth = 1
          assign level_1_label = top_link.title
          assign level_1_url = top_link.url
          assign level_2_label = ''
          assign level_2_url = ''
          assign level_3_label = ''
          assign level_3_url = ''
        endif

        for second_link in top_link.links
          if second_link.url == current_path and menu_depth < 2
            assign menu_depth = 2
            assign level_1_label = top_link.title
            assign level_1_url = top_link.url
            assign level_2_label = second_link.title
            assign level_2_url = second_link.url
            assign level_3_label = ''
            assign level_3_url = ''
          endif

          for third_link in second_link.links
            if third_link.url == current_path and menu_depth < 3
              assign menu_depth = 3
              assign level_1_label = top_link.title
              assign level_1_url = top_link.url
              assign level_2_label = second_link.title
              assign level_2_url = second_link.url
              assign level_3_label = third_link.title
              assign level_3_url = third_link.url
            endif
          endfor
        endfor
      endif
    endfor
  endif

  assign fallback_1_label = ''
  assign fallback_1_url = ''
  assign fallback_2_label = ''
  assign fallback_2_url = ''

  if menu_depth == 0
    case page.handle
      when 'athletes-ambassadors'
        assign fallback_1_label = 'Connect'
        assign fallback_1_url = '/pages/connect-overview'
        assign fallback_2_label = 'Company & People'
        assign fallback_2_url = '/pages/company-people'
        assign current_label = 'Athletes & Ambassadors'
      when 'dianna-proctor'
        assign fallback_1_label = 'Connect'
        assign fallback_1_url = '/pages/connect-overview'
        assign fallback_2_label = 'Company & People'
        assign fallback_2_url = '/pages/company-people'
        assign current_label = 'Dianna Proctor'
    endcase
  endif
%}

<nav class="bhd-breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>

  {% if menu_depth > 0 %}
    <span aria-hidden="true">›</span>
    {% if menu_depth == 1 %}
      <span aria-current="page">{{ level_1_label | escape }}</span>
    {% else %}
      <a href="{{ level_1_url }}">{{ level_1_label | escape }}</a>
    {% endif %}

    {% if menu_depth >= 2 %}
      <span aria-hidden="true">›</span>
      {% if menu_depth == 2 %}
        <span aria-current="page">{{ level_2_label | escape }}</span>
      {% else %}
        <a href="{{ level_2_url }}">{{ level_2_label | escape }}</a>
      {% endif %}
    {% endif %}

    {% if menu_depth >= 3 %}
      <span aria-hidden="true">›</span>
      <span aria-current="page">{{ level_3_label | escape }}</span>
    {% endif %}
  {% else %}
    {% if fallback_1_label != blank %}
      <span aria-hidden="true">›</span>
      <a href="{{ fallback_1_url }}">{{ fallback_1_label | escape }}</a>
    {% endif %}
    {% if fallback_2_label != blank %}
      <span aria-hidden="true">›</span>
      <a href="{{ fallback_2_url }}">{{ fallback_2_label | escape }}</a>
    {% endif %}
    <span aria-hidden="true">›</span>
    <span aria-current="page">{{ current_label | escape }}</span>
  {% endif %}
</nav>

{% comment %}
Breadcrumbs use Shopify Admin MAIN navigation, handle new-menu, as the source of truth and follow the page's declared Science, Solutions or Connect family. Within that family, the deepest matching menu position wins. Every distinct menu level now uses a distinct route, so the visible path exactly corresponds to the clicked menu node. Secondary pages intentionally outside MAIN use an explicit logical fallback.
{% endcomment %}