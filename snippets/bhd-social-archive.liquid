{% doc %}
  Reusable Best Hydrate historical social archive.

  @param {string} [heading] - Archive heading.
  @param {string} [intro] - Short archive description.
  @param {string} [archive_id] - Optional unique section id.
{% enddoc %}

{% liquid
  assign archive_heading = heading | default: 'Selected posts from our archive'
  assign archive_intro = intro | default: 'Highlights from Best Hydrate social. Open any card to view the original post on Instagram.'
  assign archive_dom_id = archive_id | default: section.id | prepend: 'BhdSocialArchive-'
%}

<section id="social-archive" class="bhd-social-archive" aria-labelledby="{{ archive_dom_id }}">
  <div class="bhd-social-archive__head">
    <p class="bhd-page__kicker">From Best Hydrate Social</p>
    <h2 id="{{ archive_dom_id }}">{{ archive_heading }}</h2>
    <p>{{ archive_intro }}</p>
  </div>

  <div class="bhd-social-archive__grid">
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DZ0oD8QEuRl/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-06-20-dianna-silver.jpg?v=1789389469" alt="Best Hydrate social post celebrating Dianna Proctor's silver medal" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-06-20">June 20, 2026</time><strong>Silver medal weekend</strong><em>View on Instagram →</em></span>
    </a>
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DZN3DekgXpg/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-06-05-athlete-spotlight.jpg?v=1789389476" alt="Best Hydrate athlete spotlight social post" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-06-05">June 5, 2026</time><strong>Athlete spotlight</strong><em>View on Instagram →</em></span>
    </a>
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DYPZEnHlHXZ/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-05-12-hydration-coaching.jpg?v=1789389483" alt="Best Hydrate hydration coaching social post" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-05-12">May 12, 2026</time><strong>Hydration coaching notes</strong><em>View on Instagram →</em></span>
    </a>
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DXzwjcngec-/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-05-01-botswana-postcards.jpg?v=1789389490" alt="Best Hydrate social post from Gaborone, Botswana" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-05-01">May 1, 2026</time><strong>Postcards from Botswana</strong><em>View on Instagram →</em></span>
    </a>
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DXhvorEgdii/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-04-24-world-relays.jpg?v=1789389496" alt="Best Hydrate social post about Canadian athletes heading to World Relays" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-04-24">April 24, 2026</time><strong>Road to World Relays</strong><em>View on Instagram →</em></span>
    </a>
    <a class="bhd-social-archive__card" href="https://www.instagram.com/p/DUBkuCkARj0/" target="_blank" rel="noopener noreferrer">
      <img src="https://cdn.shopify.com/s/files/1/0741/2170/7804/files/social-2026-01-27-record.jpg?v=1789389503" alt="Best Hydrate social post celebrating an athlete record" loading="lazy" decoding="async" width="1200" height="1500">
      <span><time datetime="2026-01-27">January 27, 2026</time><strong>A record worth celebrating</strong><em>View on Instagram →</em></span>
    </a>
  </div>

  <p class="bhd-social-archive__more"><a href="https://www.instagram.com/besthydrate/" target="_blank" rel="noopener noreferrer">See more on Instagram →</a></p>
</section>

{% stylesheet %}
  .bhd-social-archive{margin:clamp(3rem,6vw,6rem) 0;padding:clamp(2.2rem,4vw,3.6rem);border:1px solid rgba(16,42,97,.10);border-radius:1.8rem;background:#f7fbff}
  .bhd-social-archive__head{max-width:760px;margin:0 auto 2rem;text-align:center}
  .bhd-social-archive__head h2{margin:.2rem 0 .8rem;color:#102a61;font-size:clamp(2.6rem,4vw,4rem);line-height:1.08}
  .bhd-social-archive__head>p:last-child{margin:0;color:#526078;font-size:1.45rem;line-height:1.5}
  .bhd-social-archive__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .bhd-social-archive__card{overflow:hidden;border:1px solid rgba(16,42,97,.11);border-radius:1.35rem;background:#fff;color:#102a61;text-decoration:none;box-shadow:0 .7rem 2rem rgba(31,66,116,.06);transition:transform .16s ease,box-shadow .16s ease}
  .bhd-social-archive__card:hover{transform:translateY(-2px);box-shadow:0 1rem 2.5rem rgba(31,66,116,.10)}
  .bhd-social-archive__card:focus-visible{outline:3px solid #078ee7;outline-offset:3px}
  .bhd-social-archive__card img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:contain;background:#f3f6fa}
  .bhd-social-archive__card>span{display:grid;gap:.3rem;padding:1.2rem 1.25rem 1.35rem}
  .bhd-social-archive__card time{color:#6b7890;font-size:1.05rem;font-weight:700}
  .bhd-social-archive__card strong{font-size:1.45rem;line-height:1.25}
  .bhd-social-archive__card em{margin-top:.25rem;color:#245f8f;font-size:1.12rem;font-style:normal;font-weight:800}
  .bhd-social-archive__more{text-align:center;margin:1.6rem 0 0}
  .bhd-social-archive__more a{color:#245f8f;font-weight:800;text-underline-offset:.18em}
  @media screen and (max-width:989px){.bhd-social-archive__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media screen and (max-width:599px){.bhd-social-archive{padding:1.5rem}.bhd-social-archive__grid{grid-template-columns:1fr}.bhd-social-archive__card img{aspect-ratio:1/1;object-fit:contain}}
  @media (prefers-reduced-motion:reduce){.bhd-social-archive__card{transition:none}.bhd-social-archive__card:hover{transform:none}}
{% endstylesheet %}
