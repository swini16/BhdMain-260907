{% doc %}
  Reusable Best Hydrate cross-platform social archive.

  @param {string} [heading] - Archive heading.
  @param {string} [intro] - Short archive description.
  @param {string} [archive_id] - Optional unique section id.
{% enddoc %}

{% liquid
  assign archive_heading = heading | default: 'Selected posts from our archive'
  assign archive_intro = intro | default: 'Highlights from Best Hydrate social, deduplicated across platforms and linked back to the originals.'
  assign archive_dom_id = archive_id | default: section.id | prepend: 'BhdSocialArchive-'
%}

<section id="social-archive" class="bhd-social-archive" aria-labelledby="{{ archive_dom_id }}">
  <div class="bhd-social-archive__head">
    <p class="bhd-page__kicker">From Best Hydrate Social</p>
    <h2 id="{{ archive_dom_id }}">{{ archive_heading }}</h2>
    <p>{{ archive_intro }}</p>
  </div>

  <div class="bhd-social-archive__grid">
    {% render 'bhd-social-archive-items' %}
  </div>

  <nav class="bhd-social-archive__more" aria-label="Best Hydrate social profiles">
    <span>Follow Best Hydrate:</span>
    <a href="https://www.instagram.com/besthydrate/" target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href="https://www.facebook.com/104214145395682" target="_blank" rel="noopener noreferrer">Facebook</a>
    <a href="https://www.tiktok.com/@besthydrate" target="_blank" rel="noopener noreferrer">TikTok</a>
    <a href="https://www.youtube.com/channel/UCXqEmkYOnl-iU2AUaYS9kkA" target="_blank" rel="noopener noreferrer">YouTube</a>
  </nav>
</section>

{% stylesheet %}
  .bhd-social-archive{margin:clamp(3rem,6vw,6rem) 0;padding:clamp(2.2rem,4vw,3.6rem);border:1px solid rgba(16,42,97,.10);border-radius:1.8rem;background:#f7fbff}
  .bhd-social-archive__head{max-width:760px;margin:0 auto 2rem;text-align:center}
  .bhd-social-archive__head h2{margin:.2rem 0 .8rem;color:#102a61;font-size:clamp(2.6rem,4vw,4rem);line-height:1.08}
  .bhd-social-archive__head>p:last-child{margin:0;color:#526078;font-size:1.45rem;line-height:1.5}
  .bhd-social-archive__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .bhd-social-archive__card{overflow:hidden;border:1px solid rgba(16,42,97,.11);border-radius:1.35rem;background:#fff;color:#102a61;box-shadow:0 .7rem 2rem rgba(31,66,116,.06);transition:transform .16s ease,box-shadow .16s ease}
  .bhd-social-archive__card:hover{transform:translateY(-2px);box-shadow:0 1rem 2.5rem rgba(31,66,116,.10)}
  .bhd-social-archive__card:focus-within{outline:3px solid #078ee7;outline-offset:3px}
  .bhd-social-archive__media{display:block;text-decoration:none}
  .bhd-social-archive__media img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:contain;background:#f3f6fa}
  .bhd-social-archive__body{display:grid;gap:.35rem;padding:1.2rem 1.25rem 1.35rem}
  .bhd-social-archive__body time{color:#6b7890;font-size:1.05rem;font-weight:700}
  .bhd-social-archive__body strong{font-size:1.45rem;line-height:1.25}
  .bhd-social-archive__sources{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.35rem}
  .bhd-social-archive__sources a{display:inline-flex;align-items:center;padding:.35rem .7rem;border:1px solid rgba(36,95,143,.18);border-radius:999px;background:#f7fbff;color:#245f8f;font-size:1rem;font-weight:800;line-height:1;text-decoration:none}
  .bhd-social-archive__sources a:hover{text-decoration:underline}
  .bhd-social-archive__more{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:.55rem 1rem;margin:1.6rem 0 0;color:#526078;font-size:1.1rem}
  .bhd-social-archive__more a{color:#245f8f;font-weight:800;text-underline-offset:.18em}
  @media screen and (max-width:989px){.bhd-social-archive__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media screen and (max-width:599px){.bhd-social-archive{padding:1.5rem}.bhd-social-archive__grid{grid-template-columns:1fr}.bhd-social-archive__media img{aspect-ratio:1/1;object-fit:contain}}
  @media (prefers-reduced-motion:reduce){.bhd-social-archive__card{transition:none}.bhd-social-archive__card:hover{transform:none}}
{% endstylesheet %}
