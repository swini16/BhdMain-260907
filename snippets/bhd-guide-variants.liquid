{% stylesheet %}
  .bhd-guide__media {
    max-width: 680px;
    margin: 20px auto 28px;
  }
  .bhd-guide__media--product {
    max-width: 420px;
  }
  .bhd-guide__media img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 18px;
  }
  .bhd-guide__cta {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(8px, 2vw, 16px);
    width: 100%;
    align-items: start;
    margin-top: 30px;
    padding-top: 26px;
    border-top: 1px solid rgba(8, 47, 107, 0.18);
  }
  .bhd-guide__button {
    display: inline-flex;
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding: 12px clamp(10px, 2vw, 22px);
    border: 2px solid #082f6b;
    border-radius: 999px;
    font-size: clamp(0.82rem, 2.3vw, 1rem);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .bhd-guide__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(8, 47, 107, 0.14);
  }
  .bhd-guide__button--read,
  .bhd-guide__button--read:visited {
    background: #ffffff;
    color: #082f6b;
  }
  .bhd-guide__button--buy,
  .bhd-guide__button--buy:visited,
  .bhd-guide__button--buy:hover,
  .bhd-guide__button--buy:focus,
  .bhd-guide__button--buy:active {
    background: #082f6b;
    color: #ffffff !important;
    border-color: #082f6b;
    text-decoration: none;
  }
  .bhd-guide__buy {
    display: inline-flex;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
  }
  .bhd-guide__shipping {
    margin-top: 6px;
    color: #315a32;
    font-size: 0.9rem;
    line-height: 1.1;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }
  .bhd-guide-variants {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px clamp(18px, 4vw, 44px) 34px;
    border-top: 1px solid rgba(8, 47, 107, 0.14);
  }
  .bhd-guide-variants h2 {
    margin: 0 0 12px;
  }
  .bhd-guide-variants__featured {
    margin: 0 0 18px;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }
  .bhd-guide-variants__featured a,
  .bhd-guide-variants__links a,
  .bhd-explore-guides a {
    color: #082f6b;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .bhd-guide-variants__subheading {
    margin: 16px 0 8px;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bhd-guide-variants__links {
    display: grid;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bhd-guide-variants__links li {
    margin: 0;
  }
  .bhd-explore-guides > p {
    margin-bottom: 28px;
  }
  .bhd-explore-guides__category {
    padding: 24px 0;
    border-top: 1px solid rgba(8, 47, 107, 0.14);
  }
  .bhd-explore-guides__category h2,
  .bhd-explore-guides__category h3,
  .bhd-explore-guides__category h4 {
    margin-top: 0;
  }
  .bhd-explore-guides__main {
    margin-bottom: 16px;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .bhd-explore-guides__subheading {
    margin-bottom: 8px;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bhd-explore-guides__links {
    display: grid;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .bhd-guide__cta {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      gap: 8px;
      align-items: start;
    }
    .bhd-guide__button {
      min-height: 44px;
      padding: 10px 8px;
      font-size: clamp(0.7rem, 3.2vw, 0.9rem);
    }
    .bhd-guide__buy {
      width: 100%;
      min-width: 0;
    }
    .bhd-guide__shipping {
      font-size: 0.7rem;
    }
  }
{% endstylesheet %}