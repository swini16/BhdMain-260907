{% stylesheet %}
  .bhd-guide__media {
    max-width: 680px;
    margin: 20px auto 28px;
  }
  .bhd-guide__media--product {
    max-width: 420px;
  }
  .bhd-guide__media img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 18px;
  }
  .bhd-guide__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px;
    margin-top: 30px;
    padding-top: 26px;
    border-top: 1px solid rgba(8, 47, 107, 0.18);
  }
  .bhd-guide__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border: 2px solid #082f6b;
    border-radius: 999px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .bhd-guide__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(8, 47, 107, 0.14);
  }
  .bhd-guide__button--read {
    background: #ffffff;
    color: #082f6b;
  }
  .bhd-guide__button--buy {
    background: #082f6b;
    color: #ffffff;
  }
  .bhd-guide__buy {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }
  .bhd-guide__shipping {
    color: #315a32;
    font-weight: 700;
  }
  .bhd-guide-variants {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px clamp(18px, 4vw, 44px) 34px;
    border-top: 1px solid rgba(8, 47, 107, 0.14);
  }
  .bhd-guide-variants h2 {
    margin: 0 0 12px;
  }
  .bhd-guide-variants__featured {
    margin: 0 0 18px;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }
  .bhd-guide-variants__featured a,
  .bhd-guide-variants__links a,
  .bhd-explore-guides a {
    color: #082f6b;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .bhd-guide-variants__subheading {
    margin: 16px 0 8px;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bhd-guide-variants__links {
    display: grid;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bhd-guide-variants__links li {
    margin: 0;
  }
  .bhd-explore-guides > p {
    margin-bottom: 28px;
  }
  .bhd-explore-guides__category {
    padding: 24px 0;
    border-top: 1px solid rgba(8, 47, 107, 0.14);
  }
  .bhd-explore-guides__category h2,
  .bhd-explore-guides__category h3,
  .bhd-explore-guides__category h4 {
    margin-top: 0;
  }
  .bhd-explore-guides__main {
    margin-bottom: 16px;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .bhd-explore-guides__subheading {
    margin-bottom: 8px;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bhd-explore-guides__links {
    display: grid;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .bhd-guide__cta {
      align-items: stretch;
    }
    .bhd-guide__button,
    .bhd-guide__buy {
      width: 100%;
    }
  }
{% endstylesheet %}
