{% doc %}
  Shared direct-response close for consumer Best Hydrate landing pages.
  The educational body establishes context; this layer resolves the buying
  question with taste, differentiation, mechanism, objections and a clear offer.
{% enddoc %}

{% liquid
  assign lp_handle = page.handle | default: ''
  assign product_url = '/products/lemonade-best-hydrate'
  if localization.country.iso_code == 'US'
    assign product_url = '/products/lemonade-electrolyte-best-hydrate'
  endif

  assign lp_context = 'everyday'
  if lp_handle contains 'run' or lp_handle contains 'marathon' or lp_handle contains 'endurance' or lp_handle contains 'session'
    assign lp_context = 'performance'
  elsif lp_handle contains 'work' or lp_handle contains 'shift'
    assign lp_context = 'work'
  elsif lp_handle contains 'travel'
    assign lp_context = 'travel'
  elsif lp_handle contains 'recover'
    assign lp_context = 'recovery'
  elsif lp_handle contains 'cold' or lp_handle contains 'winter'
    assign lp_context = 'winter'
  elsif lp_handle contains 'summer' or lp_handle contains 'hot-days'
    assign lp_context = 'summer'
  endif
%}

<section class="bhd-lp-close" data-bhd-lp-close data-lp-context="{{ lp_context }}">
  <div class="bhd-lp-close__proof" data-lp-section="taste">
    <p class="bhd-lp-close__eyebrow">MADE TO KEEP DRINKING</p>
    <h2>Tastes great. Not too sweet.</h2>
    <p>A lighter-tasting electrolyte mix for the moments when a prepared hydration option fits your day.</p>
  </div>

  <div class="bhd-lp-close__grid" data-lp-section="why">
    <article>
      <strong>Low sugar, on purpose.</strong>
      <span>Zero sugar leaves helpful glucose out. Traditional sports drinks bring a heavy sugar load. Best Hydrate hits the hydration middle.</span>
    </article>
    <article>
      <strong>Purposeful sodium + glucose.</strong>
      <span>701 mg sodium per 500 mL, with glucose retained for sodium-glucose transport rather than removed to reach zero sugar.</span>
    </article>
    <article>
      <strong>Bicarb Bonus™ hydration, but not a megadose.</strong>
      <span>Sodium bicarbonate contributes sodium + bicarbonate to the electrolyte profile. High-dose bicarbonate-loading protocols are a different intervention.</span>
    </article>
  </div>

  <div class="bhd-lp-close__cycle" data-lp-section="cycle" aria-label="Prepare perform recover">
    <span><strong>PREP</strong><small>Start with a plan that fits the day.</small></span>
    <b>→</b>
    <span><strong>PERFORM</strong><small>Keep fluid access practical.</small></span>
    <b>→</b>
    <span><strong>RECOVER</strong><small>Return to your normal routine.</small></span>
  </div>

  <div class="bhd-lp-close__compare" data-lp-section="compare">
    <p class="bhd-lp-close__eyebrow">THE HYDRATION MIDDLE</p>
    <h2>Not zero. Not overloaded.</h2>
    <div class="bhd-lp-close__compare-grid">
      <article><strong>Zero sugar</strong><span>Leaves glucose out of the formula.</span></article>
      <article class="is-best"><strong>Best Hydrate</strong><span>Keeps purposeful glucose while total sugar stays low.</span></article>
      <article><strong>Heavy sugar load</strong><span>Can bring much more sugar and sweetness than you want from hydration.</span></article>
    </div>
  </div>

  <div class="bhd-lp-close__faq" data-lp-section="faq">
    <h2>Quick answers</h2>
    <details><summary>Is it very sweet?</summary><p>No. Best Hydrate is designed to taste great without the heavy sweetness of many traditional sports drinks.</p></details>
    <details><summary>When can I use it?</summary><p>Use it when a prepared electrolyte drink fits the activity, conditions and routine. PREP → PERFORM → RECOVER is the simple framework.</p></details>
    <details><summary>Is the container portable?</summary><p>Yes. The compact powder container is easy to keep in your bag so your hydration routine can travel with you.</p></details>
  </div>

  <div class="bhd-lp-close__offer" data-lp-section="offer">
    <p class="bhd-lp-close__eyebrow">READY FOR YOUR BEST DAY?</p>
    <h2>Hydrate for YOUR Best Day!</h2>
    <p>32 servings per container. Free &amp; Fast Delivery where available.</p>
    <a class="bhd-lp-close__button" href="{{ product_url }}" data-lp-cta="final">Shop Best Hydrate</a>
  </div>

  <a class="bhd-lp-close__mobile-buy" href="{{ product_url }}" data-lp-cta="sticky">Shop Best Hydrate</a>
</section>

<style>
  .bhd-lp-close{max-width:95rem;margin:3rem auto 0;display:grid;gap:1.6rem}
  .bhd-lp-close__proof,.bhd-lp-close__compare,.bhd-lp-close__faq,.bhd-lp-close__offer{padding:clamp(2rem,4vw,3.6rem);border:1px solid rgba(11,45,103,.12);border-radius:1.7rem;background:#fff}
  .bhd-lp-close__eyebrow{margin:0 0 .7rem!important;color:#078ee7!important;font-size:.82rem!important;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .bhd-lp-close h2{margin:0 0 1rem}
  .bhd-lp-close__proof>p:last-child,.bhd-lp-close__offer>p{max-width:70rem;color:#465774}
  .bhd-lp-close__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .bhd-lp-close__grid article,.bhd-lp-close__compare-grid article{padding:1.5rem;border:1px solid rgba(11,45,103,.12);border-radius:1.25rem;background:#f8fcff}
  .bhd-lp-close__grid strong,.bhd-lp-close__grid span,.bhd-lp-close__compare-grid strong,.bhd-lp-close__compare-grid span{display:block}
  .bhd-lp-close__grid strong,.bhd-lp-close__compare-grid strong{margin-bottom:.45rem;color:#0b2d67;font-size:1.1rem}
  .bhd-lp-close__grid span,.bhd-lp-close__compare-grid span{color:#5b6b82;line-height:1.5}
  .bhd-lp-close__cycle{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:.75rem;padding:1.4rem;border-radius:1.4rem;background:#eef7ff;color:#0b2d67;text-align:center}
  .bhd-lp-close__cycle span,.bhd-lp-close__cycle strong,.bhd-lp-close__cycle small{display:block}
  .bhd-lp-close__cycle strong{font-size:1.05rem}.bhd-lp-close__cycle small{margin-top:.25rem;color:#52657a}.bhd-lp-close__cycle b{color:#078ee7;font-size:1.4rem}
  .bhd-lp-close__compare-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.2rem}
  .bhd-lp-close__compare-grid .is-best{border-color:#078ee7;background:#eef8ff}
  .bhd-lp-close__faq details{padding:1.1rem 0;border-top:1px solid rgba(11,45,103,.12)}
  .bhd-lp-close__faq summary{cursor:pointer;color:#0b2d67;font-size:1rem;font-weight:850}
  .bhd-lp-close__faq details p{margin:.65rem 0 0;color:#5b6b82}
  .bhd-lp-close__offer{text-align:center;background:linear-gradient(145deg,#0b2d67,#0f5092);color:#fff}
  .bhd-lp-close__offer h2,.bhd-lp-close__offer p{color:#fff!important;margin-left:auto;margin-right:auto}
  .bhd-lp-close__offer .bhd-lp-close__eyebrow{color:#75d5ff!important}
  .bhd-lp-close__button{display:inline-flex;align-items:center;justify-content:center;min-height:3.25rem;margin-top:.7rem;padding:.8rem 1.5rem;border-radius:999px;background:#fff;color:#0b2d67!important;font-weight:850;text-decoration:none}
  .bhd-lp-close__mobile-buy{display:none}
  @media(max-width:749px){
    .bhd-lp-close{gap:1rem;margin-top:2rem;padding-bottom:5rem}
    .bhd-lp-close__grid,.bhd-lp-close__compare-grid{grid-template-columns:1fr}
    .bhd-lp-close__cycle{grid-template-columns:1fr}.bhd-lp-close__cycle b{transform:rotate(90deg)}
    .bhd-lp-close__proof,.bhd-lp-close__compare,.bhd-lp-close__faq,.bhd-lp-close__offer{padding:1.6rem 1.3rem}
    .bhd-lp-close__button{width:100%}
    .bhd-lp-close__mobile-buy{display:block;position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:40;padding:.9rem 1rem;border-radius:999px;background:#0b2d67;color:#fff!important;text-align:center;text-decoration:none;font-weight:850;box-shadow:0 4px 18px rgba(0,0,0,.22)}
  }
</style>

{% comment %}Consumer direct-response close revised for Convert Like Crazy pass 1, 2026-09-26.{% endcomment %}
