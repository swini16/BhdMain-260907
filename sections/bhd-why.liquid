<section id="BhdWhy-{{ section.id }}" class="bhd-why color-{{ section.settings.color_scheme }} gradient" aria-labelledby="BhdWhyHeading-{{ section.id }}">
  <div class="page-width">
    <header class="bhd-why__head">
      <p class="bhd-why__eyebrow">WHY BEST HYDRATE</p>
      <h2 id="BhdWhyHeading-{{ section.id }}">Hydration, built deliberately.</h2>
      <p>Best Hydrate brings established oral hydration principles into one practical formula for performance, everyday life, recovery and access.</p>
    </header>

    <div class="bhd-why__grid">
      <a class="bhd-why__card" href="/pages/how-hydration-works">
        <span class="bhd-why__mark">01</span>
        <strong>Oral hydration principles</strong>
        <span>Designed around the physiology of replacing water and key electrolytes by mouth.</span>
        <em>How hydration works →</em>
      </a>
      <a class="bhd-why__card" href="/pages/glucose-water-absorption">
        <span class="bhd-why__mark">02</span>
        <strong>Sodium + glucose</strong>
        <span>A paired approach that reflects the sodium-glucose transport pathway used in oral rehydration.</span>
        <em>Explore absorption →</em>
      </a>
      <a class="bhd-why__card" href="/pages/five-essential-electrolytes">
        <span class="bhd-why__mark">03</span>
        <strong>Five electrolyte species</strong>
        <span>Sodium, potassium, chloride, bicarbonate and citrate, alongside glucose.</span>
        <em>Explore electrolytes →</em>
      </a>
      <a class="bhd-why__card" href="/pages/why-bicarbonate">
        <span class="bhd-why__mark">04</span>
        <strong>Bicarbonate included</strong>
        <span>A deliberate formula choice with a distinct role from the more common sports-drink template.</span>
        <em>Why bicarbonate →</em>
      </a>
    </div>
  </div>
</section>

<style>
  #BhdWhy-{{ section.id }}{padding:5.4rem 0;background:#fff}
  #BhdWhy-{{ section.id }} .bhd-why__head{max-width:820px;margin:0 auto 2.8rem;text-align:center}
  #BhdWhy-{{ section.id }} .bhd-why__eyebrow{margin:0 0 .7rem;color:#398ee1;font-size:1.15rem;font-weight:850;letter-spacing:.16em}
  #BhdWhy-{{ section.id }} h2{margin:0;color:#102a61;font-size:clamp(3rem,4vw,4.5rem);line-height:1.02;letter-spacing:-.025em}
  #BhdWhy-{{ section.id }} .bhd-why__head>p:last-child{max-width:700px;margin:1rem auto 0;color:#526078;font-size:1.55rem;line-height:1.5}
  #BhdWhy-{{ section.id }} .bhd-why__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}
  #BhdWhy-{{ section.id }} .bhd-why__card{display:flex;flex-direction:column;min-height:220px;padding:1.7rem;border:1px solid #b7cbe3;border-radius:1.35rem;background:#f4f8fd;color:#17315f;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
  #BhdWhy-{{ section.id }} .bhd-why__card:hover{transform:translateY(-2px);border-color:#7fa3ca;box-shadow:0 .8rem 2rem rgba(31,66,116,.09)}
  #BhdWhy-{{ section.id }} .bhd-why__mark{display:inline-flex;align-items:center;justify-content:center;width:3.1rem;height:3.1rem;margin-bottom:1.2rem;border-radius:999px;background:#dbe8f6;color:#0b2d67;font-size:1.05rem;font-weight:850}
  #BhdWhy-{{ section.id }} .bhd-why__card strong{color:#102a61;font-size:1.65rem;line-height:1.18}
  #BhdWhy-{{ section.id }} .bhd-why__card>span:not(.bhd-why__mark){margin-top:.75rem;color:#526078;font-size:1.31rem;line-height:1.45}
  #BhdWhy-{{ section.id }} .bhd-why__card em{margin-top:auto;padding-top:1.2rem;color:#245f8f;font-size:1.2rem;font-style:normal;font-weight:800}
  @media screen and (max-width:989px){#BhdWhy-{{ section.id }} .bhd-why__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media screen and (max-width:749px){#BhdWhy-{{ section.id }}{padding:4rem 0}#BhdWhy-{{ section.id }} .bhd-why__grid{grid-template-columns:1fr}#BhdWhy-{{ section.id }} .bhd-why__card{min-height:0}#BhdWhy-{{ section.id }} .bhd-why__head>p:last-child{font-size:1.4rem}}
</style>

{% schema %}
{
  "name":"Why Best Hydrate",
  "settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],
  "presets":[{"name":"Why Best Hydrate"}]
}
{% endschema %}