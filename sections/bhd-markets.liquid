<section id="BhdMarkets-{{ section.id }}" class="bhd-markets color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="bhd-markets__intro">
      {% if section.settings.heading != blank %}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte bhd-markets__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bhd-markets__sections">
      <article class="bhd-markets__segment bhd-markets__segment--athletes">
        <div class="bhd-markets__segment-head">
          <div class="bhd-markets__eyebrow">Performance</div>
          <h3>{{ section.settings.athlete_label }}</h3>
          <p>{{ section.settings.athlete_intro }}</p>
        </div>
        <div class="bhd-markets__uses">
          <span>Training & competition</span>
          <span>Endurance</span>
          <span>Recovery</span>
          <span>Heat & high-sweat environments</span>
        </div>
      </article>

      <article class="bhd-markets__segment bhd-markets__segment--daily">
        <div class="bhd-markets__segment-head">
          <div class="bhd-markets__eyebrow">Everyday</div>
          <h3>{{ section.settings.daily_label }}</h3>
          <p>{{ section.settings.daily_intro }}</p>
        </div>
        <div class="bhd-markets__uses">
          <span>Everyday hydration</span>
          <span>Work & long shifts</span>
          <span>Hot labour</span>
          <span>Focus, travel & busy routines</span>
        </div>
      </article>

      <article class="bhd-markets__segment bhd-markets__segment--medical">
        <div class="bhd-markets__segment-head">
          <div class="bhd-markets__eyebrow">Health</div>
          <h3>{{ section.settings.medical_label }}</h3>
          <p>{{ section.settings.medical_intro }}</p>
        </div>
        <div class="bhd-markets__uses">
          <span>Illness & recovery</span>
          <span>Active aging</span>
          <span>Rehabilitation</span>
          <span>Clinician-guided hydration needs</span>
        </div>
      </article>
    </div>

    {% if section.settings.medical_note != blank %}
      <p class="bhd-markets__note">{{ section.settings.medical_note }}</p>
    {% endif %}
  </div>
</section>

<style>
  #BhdMarkets-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.6rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro .title {
    margin-bottom: 1rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__text {
    max-width: 740px;
    margin: 0 auto;
    font-size: 1.7rem;
    line-height: 1.55;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__sections {
    display: grid;
    gap: 1.8rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment {
    display: grid;
    grid-template-columns: minmax(260px, .72fr) minmax(0, 1.28fr);
    gap: 3rem;
    align-items: center;
    padding: 3rem 3.2rem;
    border-radius: 1.6rem;
    border: 1px solid rgba(var(--color-foreground), .11);
    background: rgb(var(--color-background));
    box-shadow: 0 1.2rem 3.8rem rgba(13,33,78,.07);
    position: relative;
    overflow: hidden;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: .65rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--athletes::before { background: #d93445; }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--daily::before { background: #20a9cf; }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--medical::before { background: #355fa6; }
  #BhdMarkets-{{ section.id }} .bhd-markets__eyebrow {
    text-transform: uppercase;
    letter-spacing: .13em;
    font-size: 1.08rem;
    font-weight: 700;
    opacity: .58;
  }
  #BhdMarkets-{{ section.id }} h3 {
    margin: .65rem 0 .8rem;
    font-size: clamp(2.7rem, 3.2vw, 4rem);
    line-height: 1.02;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment-head p {
    margin: 0;
    max-width: 510px;
    line-height: 1.5;
    opacity: .78;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__uses {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__uses span {
    display: flex;
    align-items: center;
    min-height: 5.4rem;
    padding: 1.2rem 1.5rem;
    border-radius: 1rem;
    background: rgba(var(--color-foreground), .045);
    font-weight: 600;
    line-height: 1.35;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--athletes .bhd-markets__uses span { border-left: 3px solid rgba(217,52,69,.72); }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--daily .bhd-markets__uses span { border-left: 3px solid rgba(32,169,207,.72); }
  #BhdMarkets-{{ section.id }} .bhd-markets__segment--medical .bhd-markets__uses span { border-left: 3px solid rgba(53,95,166,.72); }
  #BhdMarkets-{{ section.id }} .bhd-markets__note {
    max-width: 860px;
    margin: 2.2rem auto 0;
    text-align: center;
    font-size: 1.25rem;
    line-height: 1.45;
    opacity: .62;
  }

  @media screen and (max-width: 899px) {
    #BhdMarkets-{{ section.id }} .bhd-markets__segment {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
  }

  @media screen and (max-width: 749px) {
    #BhdMarkets-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__intro { margin-bottom: 2.6rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__segment { padding: 2.3rem 2rem 2.3rem 2.4rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__uses { grid-template-columns: 1fr; gap: .75rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__uses span { min-height: 0; }
  }
</style>

{% schema %}
{
  "name": "Hydration markets",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hydration for real life"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {"value": "h2", "label": "Small"},
        {"value": "h1", "label": "Medium"},
        {"value": "h0", "label": "Large"}
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Overview",
      "default": "<p>Best Hydrate is built around three main hydration contexts: athletic performance, everyday life and medical or recovery-related needs.</p>"
    },
    {"type": "text", "id": "athlete_label", "label": "Athlete label", "default": "Athletes"},
    {"type": "textarea", "id": "athlete_intro", "label": "Athlete overview", "default": "For training, competition and demanding physical performance where hydration and electrolyte replacement matter."},
    {"type": "text", "id": "daily_label", "label": "Daily label", "default": "Daily Use"},
    {"type": "textarea", "id": "daily_intro", "label": "Daily overview", "default": "For ordinary days that still demand a lot: work, heat, travel, focus and keeping hydration consistent."},
    {"type": "text", "id": "medical_label", "label": "Medical label", "default": "Medical"},
    {"type": "textarea", "id": "medical_intro", "label": "Medical overview", "default": "For recovery, active aging and situations where hydration needs may be more important or require professional guidance."},
    {"type": "textarea", "id": "medical_note", "label": "Medical note", "default": "Medical hydration needs vary. Follow the product label and seek clinician guidance when appropriate."},
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {"name": "Hydration markets"}
  ]
}
{% endschema %}
