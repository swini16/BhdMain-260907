<section id="BhdMarkets-{{ section.id }}" class="bhd-markets color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="bhd-markets__intro">
      {% if section.settings.heading != blank %}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte bhd-markets__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bhd-markets__grid">
      <article class="bhd-markets__card bhd-markets__card--athletes">
        <div class="bhd-markets__eyebrow">Performance</div>
        <h3>{{ section.settings.athlete_label }}</h3>
        <ul>
          <li>Training & competition</li>
          <li>Endurance & recovery</li>
          <li>{{ section.settings.athlete_daily_title }}</li>
          <li>{{ section.settings.athlete_medical_title }}</li>
        </ul>
      </article>

      <article class="bhd-markets__card bhd-markets__card--daily">
        <div class="bhd-markets__eyebrow">Everyday</div>
        <h3>{{ section.settings.daily_label }}</h3>
        <ul>
          <li>Everyday hydration</li>
          <li>Hot labour & long shifts</li>
          <li>Intensive brain work</li>
          <li>Travel & daily routines</li>
        </ul>
      </article>

      <article class="bhd-markets__card bhd-markets__card--medical">
        <div class="bhd-markets__eyebrow">Health</div>
        <h3>{{ section.settings.medical_label }}</h3>
        <ul>
          <li>Illness & recovery</li>
          <li>Active aging</li>
          <li>{{ section.settings.daily_medical_title }}</li>
          <li>Rehabilitation & return to activity</li>
        </ul>
      </article>
    </div>

    <div class="bhd-markets__clinical">
      <strong>{{ section.settings.center_title }}</strong>
      <span>{{ section.settings.center_text }}</span>
    </div>
  </div>
</section>

<style>
  #BhdMarkets-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro .title {
    margin-bottom: 1rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__text {
    max-width: 720px;
    margin: 0 auto;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__card {
    min-height: 310px;
    padding: 2.8rem;
    border-radius: 1.4rem;
    border: 1px solid rgba(var(--color-foreground), .12);
    background: rgb(var(--color-background));
    box-shadow: 0 1.2rem 3.5rem rgba(13,33,78,.08);
    position: relative;
    overflow: hidden;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: .5rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__card--athletes::before { background: #d93445; }
  #BhdMarkets-{{ section.id }} .bhd-markets__card--daily::before { background: #20a9cf; }
  #BhdMarkets-{{ section.id }} .bhd-markets__card--medical::before { background: #355fa6; }
  #BhdMarkets-{{ section.id }} .bhd-markets__eyebrow {
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: 1.15rem;
    font-weight: 700;
    opacity: .58;
  }
  #BhdMarkets-{{ section.id }} h3 {
    margin: .8rem 0 1.6rem;
    font-size: clamp(2.5rem, 2.8vw, 3.5rem);
    line-height: 1.05;
  }
  #BhdMarkets-{{ section.id }} ul {
    margin: 0;
    padding-left: 2rem;
    line-height: 1.55;
  }
  #BhdMarkets-{{ section.id }} li + li { margin-top: .55rem; }
  #BhdMarkets-{{ section.id }} .bhd-markets__clinical {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 1rem;
    margin: 2.2rem auto 0;
    padding: 1.3rem 1.8rem;
    max-width: 820px;
    text-align: center;
    border-radius: 999px;
    background: rgba(var(--color-foreground), .055);
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__clinical strong {
    white-space: nowrap;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__clinical span {
    opacity: .72;
  }
  @media screen and (max-width: 899px) {
    #BhdMarkets-{{ section.id }} .bhd-markets__grid {
      grid-template-columns: 1fr;
      max-width: 700px;
      margin: 0 auto;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__card {
      min-height: 0;
    }
  }
  @media screen and (max-width: 749px) {
    #BhdMarkets-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__card { padding: 2.2rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__clinical {
      display: block;
      border-radius: 1rem;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__clinical strong,
    #BhdMarkets-{{ section.id }} .bhd-markets__clinical span { display: block; }
    #BhdMarkets-{{ section.id }} .bhd-markets__clinical span { margin-top: .35rem; }
  }
</style>

{% schema %}
{
  "name": "Hydration markets",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hydration across real life"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {"value": "h2", "label": "Small"},
        {"value": "h1", "label": "Medium"},
        {"value": "h0", "label": "Large"}
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Best Hydrate supports hydration across three broad real-life contexts.</p>"
    },
    {"type": "text", "id": "athlete_label", "label": "Athlete label", "default": "Athletes"},
    {"type": "text", "id": "daily_label", "label": "Daily label", "default": "Daily Use"},
    {"type": "text", "id": "medical_label", "label": "Medical label", "default": "Medical"},
    {"type": "text", "id": "athlete_daily_title", "label": "Athlete + daily title", "default": "High-demand performance"},
    {"type": "text", "id": "athlete_daily_text", "label": "Athlete + daily text", "default": "Hot labour, long shifts, intensive cognitive work"},
    {"type": "text", "id": "daily_medical_title", "label": "Daily + medical title", "default": "Recovery & resilience"},
    {"type": "text", "id": "daily_medical_text", "label": "Daily + medical text", "default": "Illness recovery, active aging, vulnerable everyday hydration"},
    {"type": "text", "id": "athlete_medical_title", "label": "Athlete + medical title", "default": "Rehab & return to performance"},
    {"type": "text", "id": "athlete_medical_text", "label": "Athlete + medical text", "default": "Rehabilitation and medically managed training"},
    {"type": "text", "id": "center_title", "label": "Center title", "default": "Clinical"},
    {"type": "text", "id": "center_text", "label": "Center text", "default": "Clinical hydration can span all three contexts when professional guidance is appropriate."},
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {"name": "Hydration markets"}
  ]
}
{% endschema %}
