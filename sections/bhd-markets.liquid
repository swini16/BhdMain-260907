<section id="BhdMarkets-{{ section.id }}" class="bhd-markets color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="bhd-markets__intro">
      {% if section.settings.heading != blank %}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte bhd-markets__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="bhd-markets__venn-wrap">
      <div class="bhd-markets__venn" aria-label="Best Hydrate markets and their intersections">
        <div class="bhd-markets__circle bhd-markets__circle--athlete">
          <span>{{ section.settings.athlete_label }}</span>
        </div>
        <div class="bhd-markets__circle bhd-markets__circle--daily">
          <span>{{ section.settings.daily_label }}</span>
        </div>
        <div class="bhd-markets__circle bhd-markets__circle--medical">
          <span>{{ section.settings.medical_label }}</span>
        </div>

        <div class="bhd-markets__overlap bhd-markets__overlap--athlete-daily">
          <strong>{{ section.settings.athlete_daily_title }}</strong>
          <small>{{ section.settings.athlete_daily_text }}</small>
        </div>
        <div class="bhd-markets__overlap bhd-markets__overlap--daily-medical">
          <strong>{{ section.settings.daily_medical_title }}</strong>
          <small>{{ section.settings.daily_medical_text }}</small>
        </div>
        <div class="bhd-markets__overlap bhd-markets__overlap--athlete-medical">
          <strong>{{ section.settings.athlete_medical_title }}</strong>
          <small>{{ section.settings.athlete_medical_text }}</small>
        </div>
        <div class="bhd-markets__center">
          <strong>{{ section.settings.center_title }}</strong>
        </div>
      </div>
    </div>

    <div class="bhd-markets__mobile-overlaps">
      <div><strong>{{ section.settings.athlete_daily_title }}</strong><span>{{ section.settings.athlete_daily_text }}</span></div>
      <div><strong>{{ section.settings.daily_medical_title }}</strong><span>{{ section.settings.daily_medical_text }}</span></div>
      <div><strong>{{ section.settings.athlete_medical_title }}</strong><span>{{ section.settings.athlete_medical_text }}</span></div>
      <div><strong>{{ section.settings.center_title }}</strong><span>{{ section.settings.center_text }}</span></div>
    </div>
  </div>
</section>

<style>
  #BhdMarkets-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.4rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro .title {
    margin-bottom: 1.2rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__text {
    max-width: 720px;
    margin: 0 auto;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__venn-wrap {
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__venn {
    position: relative;
    width: 920px;
    height: 520px;
    max-width: 100%;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__circle {
    position: absolute;
    width: 370px;
    height: 370px;
    border-radius: 50%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 5.2rem;
    border: 2px solid rgba(255,255,255,.72);
    box-shadow: 0 1.5rem 4rem rgba(13,33,78,.10);
    color: #fff;
    text-align: center;
    font-size: clamp(2rem, 2.4vw, 3rem);
    font-weight: 700;
    letter-spacing: .01em;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__circle--athlete {
    left: 92px;
    top: 36px;
    background: rgba(225, 38, 48, .74);
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__circle--daily {
    left: 275px;
    top: 116px;
    background: rgba(21, 157, 200, .72);
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__circle--medical {
    left: 458px;
    top: 36px;
    background: rgba(34, 77, 154, .74);
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap,
  #BhdMarkets-{{ section.id }} .bhd-markets__center {
    position: absolute;
    z-index: 4;
    color: #fff;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,.28);
    line-height: 1.16;
    pointer-events: none;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap strong,
  #BhdMarkets-{{ section.id }} .bhd-markets__center strong {
    display: block;
    font-size: 1.45rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap small {
    display: block;
    margin-top: .35rem;
    font-size: 1.08rem;
    line-height: 1.22;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap--athlete-daily {
    left: 294px;
    top: 260px;
    width: 150px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap--daily-medical {
    left: 478px;
    top: 260px;
    width: 150px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__overlap--athlete-medical {
    left: 384px;
    top: 118px;
    width: 154px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__center {
    left: 393px;
    top: 222px;
    width: 136px;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__center strong {
    font-size: 1.7rem;
  }
  #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #BhdMarkets-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__venn {
      width: 350px;
      height: 330px;
      transform: none;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__circle {
      width: 205px;
      height: 205px;
      padding-top: 3.2rem;
      font-size: 1.6rem;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__circle--athlete {
      left: 0;
      top: 8px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__circle--daily {
      left: 72px;
      top: 108px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__circle--medical {
      left: 145px;
      top: 8px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__overlap {
      display: none;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__center {
      left: 123px;
      top: 151px;
      width: 104px;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__center strong {
      font-size: 1.35rem;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps {
      display: grid;
      gap: 1rem;
      margin-top: .8rem;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps > div {
      border: 1px solid rgba(var(--color-foreground), .14);
      border-radius: 1rem;
      padding: 1.2rem 1.4rem;
      background: rgba(var(--color-background), .82);
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps strong,
    #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps span {
      display: block;
    }
    #BhdMarkets-{{ section.id }} .bhd-markets__mobile-overlaps span {
      margin-top: .25rem;
      opacity: .75;
    }
  }
</style>

{% schema %}
{
  "name": "Hydration markets",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hydration across real life"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {"value": "h2", "label": "Small"},
        {"value": "h1", "label": "Medium"},
        {"value": "h0", "label": "Large"}
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Best Hydrate is designed around three major hydration contexts, with the most interesting needs often living where they overlap.</p>"
    },
    {"type": "text", "id": "athlete_label", "label": "Athlete label", "default": "Athletes"},
    {"type": "text", "id": "daily_label", "label": "Daily label", "default": "Daily Use"},
    {"type": "text", "id": "medical_label", "label": "Medical label", "default": "Medical"},
    {"type": "text", "id": "athlete_daily_title", "label": "Athlete + daily title", "default": "High-demand performance"},
    {"type": "text", "id": "athlete_daily_text", "label": "Athlete + daily text", "default": "Hot labour, long shifts, intensive cognitive work"},
    {"type": "text", "id": "daily_medical_title", "label": "Daily + medical title", "default": "Recovery & resilience"},
    {"type": "text", "id": "daily_medical_text", "label": "Daily + medical text", "default": "Illness recovery, active aging, vulnerable everyday hydration"},
    {"type": "text", "id": "athlete_medical_title", "label": "Athlete + medical title", "default": "Rehab & return to performance"},
    {"type": "text", "id": "athlete_medical_text", "label": "Athlete + medical text", "default": "Rehabilitation and medically managed training"},
    {"type": "text", "id": "center_title", "label": "Center title", "default": "Clinical"},
    {"type": "text", "id": "center_text", "label": "Center text", "default": "Where sport, daily demands and medical hydration converge"},
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {"name": "Hydration markets"}
  ]
}
{% endschema %}
