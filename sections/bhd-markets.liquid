<section id="BhdMarkets-{{ section.id }}" class="bhd-markets color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="bhd-markets__intro">
      <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      <div class="rte bhd-markets__text">{{ section.settings.text }}</div>
    </div>

    <div class="bhd-markets__grid">
      <article class="bhd-market-card bhd-market-card--athlete">
        <div class="bhd-market-card__media">
          <a class="bhd-market-card__media-link" href="/pages/performance-hydration" aria-label="Explore performance hydration">
            <img src="https://hmentca-my.sharepoint.com/:i:/g/personal/austin_besthydrate_com/IQCRhZWgRQA6TboPx97M53aOAf2KCw_UJVG_fOtcHwZ2v5M?download=1" alt="Asian female athlete hydrating during performance" width="1200" height="800" loading="lazy" decoding="async" fetchpriority="low">
          </a>
        </div>
        <div class="bhd-market-card__body">
          <div class="bhd-market-card__icon">↗</div>
          <h3><a href="/pages/performance-hydration">{{ section.settings.athlete_label }}</a></h3>
          <p class="bhd-market-card__tag">Train. Perform. Recover.</p>
          <p>{{ section.settings.athlete_intro }}</p>
          <ul>
            <li>Training and competition</li>
            <li>Endurance and high intensity</li>
            <li>Recovery and repeated effort</li>
            <li>Heat and high-sweat environments</li>
          </ul>
        </div>
      </article>

      <article class="bhd-market-card bhd-market-card--daily">
        <div class="bhd-market-card__media">
          <a class="bhd-market-card__media-link" href="/pages/everyday-wellness" aria-label="Explore everyday wellness hydration">
            <img src="https://hmentca-my.sharepoint.com/:i:/g/personal/austin_besthydrate_com/IQDvszEUjCr4Q5Wl2L8v1bBWASpseDaT65G8-G2v6fqDiAk?download=1" alt="Construction workers hydrating during a demanding workday" width="1200" height="800" loading="lazy" decoding="async" fetchpriority="low">
          </a>
        </div>
        <div class="bhd-market-card__body">
          <div class="bhd-market-card__icon">⌁</div>
          <h3><a href="/pages/everyday-wellness">{{ section.settings.daily_label }}</a></h3>
          <p class="bhd-market-card__tag">Hydration for what you do.</p>
          <p>{{ section.settings.daily_intro }}</p>
          <ul>
            <li>Work and physically demanding jobs</li>
            <li>Focus and cognitive performance</li>
            <li>Travel and on the go</li>
            <li>Everyday hydration and wellness</li>
          </ul>
        </div>
      </article>

      <article class="bhd-market-card bhd-market-card--medical">
        <div class="bhd-market-card__media">
          <a class="bhd-market-card__media-link" href="/pages/clinical-hydration" aria-label="Explore clinical hydration">
            <img src="https://images.pexels.com/photos/8413217/pexels-photo-8413217.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Medical professional consulting with an older patient" width="1200" height="800" loading="lazy" decoding="async" fetchpriority="low">
          </a>
        </div>
        <div class="bhd-market-card__body">
          <div class="bhd-market-card__icon">+</div>
          <h3><a href="/pages/clinical-hydration">{{ section.settings.medical_label }}</a></h3>
          <p class="bhd-market-card__tag">Support when hydration matters most.</p>
          <p>{{ section.settings.medical_intro }}</p>
          <ul>
            <li>Illness and dehydration</li>
            <li>Recovery and rehabilitation</li>
            <li>Active aging</li>
            <li>Clinician-guided hydration needs</li>
          </ul>
        </div>
      </article>
    </div>

    {% if section.settings.medical_note != blank %}<p class="bhd-markets__note">{{ section.settings.medical_note }}</p>{% endif %}
  </div>
</section>

<style>
  #BhdMarkets-{{ section.id }} { padding:5.8rem 0 6.2rem; background:linear-gradient(180deg,#f7fbff 0%,#eef4fb 100%); }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro { text-align:center; max-width:850px; margin:0 auto 3.7rem; }
  #BhdMarkets-{{ section.id }} .bhd-markets__intro .title { margin:0 0 1rem; color:#102a61; font-size:clamp(3.6rem,4.5vw,5.2rem); letter-spacing:-.025em; }
  #BhdMarkets-{{ section.id }} .bhd-markets__text { max-width:720px; margin:0 auto; font-size:1.72rem; line-height:1.55; color:#465573; }
  #BhdMarkets-{{ section.id }} .bhd-markets__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2rem; align-items:stretch; }
  #BhdMarkets-{{ section.id }} .bhd-market-card { overflow:hidden; border-radius:2rem; border:1px solid rgba(16,42,97,.09); box-shadow:0 1.6rem 4.2rem rgba(31,66,116,.10); background:#fff; display:flex; flex-direction:column; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--athlete { background:linear-gradient(180deg,#fff 0%,#fff1f3 100%); }
  #BhdMarkets-{{ section.id }} .bhd-market-card--daily { background:linear-gradient(180deg,#fff 0%,#edf7ff 100%); }
  #BhdMarkets-{{ section.id }} .bhd-market-card--medical { background:linear-gradient(180deg,#fff 0%,#eefaf7 100%); }
  #BhdMarkets-{{ section.id }} .bhd-market-card__media { aspect-ratio:1.55/1; overflow:hidden; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__media-link { display:block; width:100%; height:100%; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__media img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .25s ease; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--athlete .bhd-market-card__media img { object-position:center 42%; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--daily .bhd-market-card__media img { object-position:center 48%; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--medical .bhd-market-card__media img { object-position:center 40%; }
  #BhdMarkets-{{ section.id }} .bhd-market-card:hover .bhd-market-card__media img { transform:scale(1.025); }
  #BhdMarkets-{{ section.id }} .bhd-market-card__body { position:relative; padding:3.3rem 2.5rem 2.8rem; text-align:center; flex:1; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__icon { position:absolute; top:-2.35rem; left:50%; transform:translateX(-50%); width:5rem; height:5rem; border-radius:999px; display:grid; place-items:center; color:#fff; font-size:2.2rem; font-weight:800; border:4px solid #fff; box-shadow:0 .6rem 1.8rem rgba(17,47,86,.12); }
  #BhdMarkets-{{ section.id }} .bhd-market-card--athlete .bhd-market-card__icon { background:#ef5d6c; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--daily .bhd-market-card__icon { background:#398ee1; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--medical .bhd-market-card__icon { background:#48b49e; }
  #BhdMarkets-{{ section.id }} h3 { margin:.25rem 0 .45rem; color:#102a61; font-size:3.15rem; line-height:1.05; letter-spacing:-.02em; }
  #BhdMarkets-{{ section.id }} h3 a { color:inherit; text-decoration:none; }
  #BhdMarkets-{{ section.id }} h3 a:hover { text-decoration:underline; text-underline-offset:.16em; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__media-link:focus-visible,
  #BhdMarkets-{{ section.id }} h3 a:focus-visible { outline:3px solid #102a61; outline-offset:3px; border-radius:.4rem; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__tag { margin:.15rem 0 1rem; font-size:1.58rem; font-weight:700; color:#17315f; }
  #BhdMarkets-{{ section.id }} .bhd-market-card__body > p:not(.bhd-market-card__tag) { margin:0 auto 1.7rem; line-height:1.48; color:#526078; max-width:32rem; }
  #BhdMarkets-{{ section.id }} ul { list-style:none; padding:0; margin:0; display:grid; gap:.82rem; text-align:left; }
  #BhdMarkets-{{ section.id }} li { position:relative; padding:.82rem 1rem .82rem 3rem; border-radius:.9rem; background:rgba(255,255,255,.62); color:#344461; line-height:1.32; font-size:1.38rem; }
  #BhdMarkets-{{ section.id }} li::before { content:'✓'; position:absolute; left:.85rem; top:.82rem; width:1.6rem; height:1.6rem; border-radius:999px; display:grid; place-items:center; color:#fff; font-size:.95rem; font-weight:800; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--athlete li::before { background:#ef5d6c; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--daily li::before { background:#398ee1; }
  #BhdMarkets-{{ section.id }} .bhd-market-card--medical li::before { background:#48b49e; }
  #BhdMarkets-{{ section.id }} .bhd-markets__note { max-width:840px; margin:2.2rem auto 0; text-align:center; font-size:1.18rem; line-height:1.45; color:#6c7485; }

  @media screen and (max-width:989px){
    #BhdMarkets-{{ section.id }} .bhd-markets__grid { grid-template-columns:1fr; max-width:700px; margin:0 auto; gap:1.7rem; }
    #BhdMarkets-{{ section.id }} .bhd-market-card { display:grid; grid-template-columns:minmax(220px,.8fr) 1.2fr; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__media { aspect-ratio:auto; min-height:360px; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__icon { left:0; top:2rem; transform:translateX(-50%); }
  }
  @media screen and (max-width:749px){
    #BhdMarkets-{{ section.id }} { padding:3.8rem 0 4.2rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__intro { margin-bottom:2.7rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__intro .title { font-size:3.2rem; }
    #BhdMarkets-{{ section.id }} .bhd-markets__text { font-size:1.46rem; }
    #BhdMarkets-{{ section.id }} .bhd-market-card { display:block; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__media { aspect-ratio:1.5/1; min-height:0; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__body { padding:3.1rem 1.7rem 2.2rem; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__icon { left:50%; top:-2.25rem; transform:translateX(-50%); }
    #BhdMarkets-{{ section.id }} h3 { font-size:2.7rem; }
    #BhdMarkets-{{ section.id }} .bhd-market-card__tag { font-size:1.42rem; }
    #BhdMarkets-{{ section.id }} li { font-size:1.3rem; }
  }
</style>

{% schema %}
{
  "name":"Hydration markets",
  "settings":[
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Hydration for real life."},
    {"type":"select","id":"heading_size","options":[{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}],"default":"h1","label":"Heading size"},
    {"type":"richtext","id":"text","label":"Overview","default":"<p>Best Hydrate is designed for people who want to feel and perform their best. Whether you're training, working, recovering or simply taking care of yourself, proper hydration makes a difference.</p>"},
    {"type":"text","id":"athlete_label","label":"Athlete label","default":"Athletes"},
    {"type":"textarea","id":"athlete_intro","label":"Athlete overview","default":"For training, competition and recovery when hydration and electrolyte replacement matter."},
    {"type":"text","id":"daily_label","label":"Daily label","default":"Daily"},
    {"type":"textarea","id":"daily_intro","label":"Daily overview","default":"For work, heat, travel, focus and keeping hydration consistent through everyday life."},
    {"type":"text","id":"medical_label","label":"Medical label","default":"Medical"},
    {"type":"textarea","id":"medical_intro","label":"Medical overview","default":"For recovery, active aging and situations where hydration needs may require extra attention or professional guidance."},
    {"type":"textarea","id":"medical_note","label":"Medical note","default":"Medical hydration needs vary. Follow the product label and seek clinician guidance when appropriate."},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "presets":[{"name":"Hydration markets"}]
}
{% endschema %}
