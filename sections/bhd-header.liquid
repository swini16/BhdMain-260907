<style>
  .bhd-header { position:relative; z-index:40; border-bottom:1px solid rgba(var(--color-foreground),.09); background:rgb(var(--color-background)); }
  .bhd-header [data-menu-panel][hidden] { display:none !important; }
  .bhd-header .bhd-header__inner { min-height:82px; display:grid; grid-template-columns:max-content minmax(0,1fr) max-content; align-items:center; gap:3rem; }
  .bhd-header .bhd-header__brand { display:inline-flex; align-items:center; justify-self:start; gap:.8rem; text-decoration:none; min-width:max-content; }
  .bhd-header .bhd-header__logo { display:block; width:46px; height:46px; object-fit:contain; flex:0 0 auto; }
  .bhd-header .bhd-header__brand-copy { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:0; }
  .bhd-header .bhd-header__site-name { display:block; color:rgb(var(--color-foreground)); font-family:var(--font-heading-family); font-size:2.5rem; font-weight:700; line-height:.92; white-space:nowrap; }
  .bhd-header .bhd-header__tagline { display:block; margin-top:.02rem; color:rgba(var(--color-foreground),.72); font-family:var(--font-heading-family); font-size:1.05rem; font-weight:500; line-height:.95; white-space:nowrap; }
  .bhd-header .bhd-header__nav { display:flex; align-items:center; justify-content:center; gap:1.6rem; }
  .bhd-header .bhd-header__main-item { position:relative; }
  .bhd-header .bhd-header__split-button { display:flex; align-items:stretch; min-height:4.2rem; border:1px solid transparent; border-radius:999px; overflow:hidden; transition:background .15s ease,border-color .15s ease,box-shadow .15s ease; }
  .bhd-header .bhd-header__main-link,.bhd-header .bhd-header__main-toggle { color:rgb(var(--color-foreground)); background:transparent; border:0; font-family:inherit; font-size:1.5rem; letter-spacing:.03em; }
  .bhd-header .bhd-header__main-link { display:flex; align-items:center; padding:0 .9rem 0 1.25rem; text-decoration:none; white-space:nowrap; }
  .bhd-header .bhd-header__main-toggle { width:3.5rem; display:grid; place-items:center; padding:0; border-left:1px solid rgba(var(--color-foreground),.12); cursor:pointer; }
  .bhd-header .bhd-header__main-toggle span { display:block; font-size:1.45rem; line-height:1; transform:translateY(-.08rem); transition:transform .16s ease; }
  .bhd-header .bhd-header__main-item:hover .bhd-header__split-button { background:rgba(var(--color-foreground),.035); }
  .bhd-header .bhd-header__main-item.is-open .bhd-header__split-button { background:rgba(var(--color-button),.12); border-color:rgba(var(--color-button),.42); box-shadow:0 .55rem 1.8rem rgba(13,33,78,.12); }
  .bhd-header .bhd-header__main-item.is-open .bhd-header__main-link,.bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle { color:rgb(var(--color-button)); font-weight:700; }
  .bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle span { transform:rotate(180deg) translateY(.08rem); }
  .bhd-header .bhd-header__shop-cta { display:inline-flex; align-items:center; justify-content:center; min-height:4.2rem; padding:0 2rem; border-radius:999px; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)) !important; font-size:1.5rem; font-weight:700; text-decoration:none; letter-spacing:.02em; box-shadow:0 .6rem 1.8rem rgba(var(--color-button),.18); }
  .bhd-header .bhd-header__dropdown-menu { position:absolute; top:calc(100% + 1rem); left:50%; transform:translateX(-50%); width:min(920px,90vw); padding:1.6rem; border-radius:14px; background:rgb(var(--color-background)); box-shadow:0 18px 46px rgba(0,0,0,.14); border:1px solid rgba(var(--color-foreground),.08); display:grid; grid-template-columns:repeat(5,minmax(150px,1fr)); gap:.8rem 1rem; }
  .bhd-header .bhd-header__dropdown-menu--wide { width:min(1040px,92vw); grid-template-columns:repeat(6,minmax(135px,1fr)); }
  .bhd-header .bhd-header__dropdown-child { min-width:0; padding:.45rem .5rem .6rem; border-radius:10px; }
  .bhd-header .bhd-header__dropdown-child:hover { background:rgba(var(--color-foreground),.025); }
  .bhd-header .bhd-header__dropdown-menu a { display:block; color:rgb(var(--color-foreground)); text-decoration:none; }
  .bhd-header .bhd-header__dropdown-parent { font-weight:700; font-size:1.42rem; padding:.6rem .65rem; line-height:1.22; white-space:normal; }
  .bhd-header .bhd-header__dropdown-grandchildren { margin-top:.2rem; }
  .bhd-header .bhd-header__dropdown-grandchildren a { font-size:1.26rem; opacity:.78; padding:.44rem .65rem; line-height:1.28; white-space:normal; }
  .bhd-header .bhd-header__actions { display:flex; align-items:center; justify-self:end; gap:.7rem; }
  .bhd-header .bhd-header__icon-button { width:4rem; height:4rem; display:inline-flex; align-items:center; justify-content:center; color:rgb(var(--color-foreground)); text-decoration:none; position:relative; cursor:pointer; }
  .bhd-header .bhd-header__icon-button svg { width:2.1rem; height:2.1rem; }
  .bhd-header .bhd-header__cart-button svg { width:2.8rem; height:2.8rem; }
  .bhd-header .bhd-header__cart-count { position:absolute; top:.2rem; right:.1rem; min-width:1.7rem; height:1.7rem; border-radius:999px; display:grid; place-items:center; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)); font-size:1rem; }
  .bhd-header .bhd-header__mobile-menu { display:none; }

  @media screen and (min-width:990px) {
    .bhd-header .bhd-header__inner { position:relative; }
    .bhd-header .bhd-header__nav { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); }
  }

  @media screen and (max-width:1180px) and (min-width:990px) {
    .bhd-header .bhd-header__inner { gap:1.4rem; }
    .bhd-header .bhd-header__nav { gap:.9rem; }
    .bhd-header .bhd-header__main-link,.bhd-header .bhd-header__main-toggle,.bhd-header .bhd-header__shop-cta { font-size:1.3rem; }
    .bhd-header .bhd-header__main-link { padding-left:.95rem; padding-right:.65rem; }
    .bhd-header .bhd-header__main-toggle { width:3rem; }
    .bhd-header .bhd-header__shop-cta { padding:0 1.35rem; }
    .bhd-header .bhd-header__site-name { font-size:2.15rem; }
    .bhd-header .bhd-header__tagline { font-size:.94rem; }
    .bhd-header .bhd-header__logo { width:42px; height:42px; }
  }

  @media screen and (max-width:989px) {
    .bhd-header .bhd-header__inner { min-height:84px; grid-template-columns:auto 1fr auto; gap:.65rem; padding-top:.6rem; padding-bottom:.6rem; }
    .bhd-header .bhd-header__mobile-menu { display:block; position:relative; }
    .bhd-header .bhd-header__nav { display:none; }
    .bhd-header .bhd-header__brand { justify-self:center; gap:.5rem; min-width:0; }
    .bhd-header .bhd-header__logo { width:38px; height:38px; }
    .bhd-header .bhd-header__site-name { font-size:1.82rem; }
    .bhd-header .bhd-header__tagline { font-size:.9rem; line-height:.95; white-space:nowrap; }
    .bhd-header .bhd-header__actions { justify-self:end; }
    .bhd-header .bhd-header__actions > a:first-child { display:none; }
    .bhd-header .bhd-header__cart-button svg { width:2.35rem; height:2.35rem; }
    .bhd-header .bhd-header__mobile-menu > summary { list-style:none; font-size:2.3rem; }
    .bhd-header .bhd-header__mobile-menu > summary::-webkit-details-marker { display:none; }
    .bhd-header .bhd-header__mobile-panel { position:absolute; top:calc(100% + 1rem); left:0; width:min(350px,92vw); max-height:78vh; overflow:auto; padding:1rem; background:rgb(var(--color-background)); border:1px solid rgba(var(--color-foreground),.08); border-radius:12px; box-shadow:0 12px 30px rgba(0,0,0,.14); }
    .bhd-header .bhd-header__mobile-main { border-radius:10px; margin-bottom:.25rem; }
    .bhd-header .bhd-header__mobile-main-row { display:grid; grid-template-columns:1fr 4.5rem; align-items:stretch; border:1px solid rgba(var(--color-foreground),.08); border-radius:10px; overflow:hidden; }
    .bhd-header .bhd-header__mobile-main-row > a { display:flex; align-items:center; padding:.95rem 1rem; color:rgb(var(--color-foreground)); text-decoration:none; font-size:1.55rem; font-weight:600; }
    .bhd-header .bhd-header__mobile-toggle { border:0; border-left:1px solid rgba(var(--color-foreground),.10); background:transparent; color:rgb(var(--color-foreground)); font-size:1.7rem; cursor:pointer; }
    .bhd-header .bhd-header__mobile-toggle span { display:block; transition:transform .16s ease; }
    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-main-row { background:rgba(var(--color-button),.10); border-color:rgba(var(--color-button),.30); }
    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-main-row > a,.bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-toggle { color:rgb(var(--color-button)); font-weight:700; }
    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-toggle span { transform:rotate(180deg); }
    .bhd-header .bhd-header__mobile-level-one { padding:.4rem .45rem .65rem .75rem; }
    .bhd-header .bhd-header__mobile-group summary,.bhd-header .bhd-header__mobile-submenu a { display:block; padding:.8rem .9rem; color:rgb(var(--color-foreground)); text-decoration:none; font-size:1.42rem; cursor:pointer; list-style:none; }
    .bhd-header .bhd-header__mobile-submenu { padding-left:.9rem; }
    .bhd-header .bhd-header__mobile-submenu a { font-size:1.3rem; opacity:.82; padding:.6rem .8rem; }
    .bhd-header .bhd-header__mobile-shop { display:block; margin:.7rem .2rem .1rem; padding:1rem; text-align:center; border-radius:999px; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)) !important; text-decoration:none; font-size:1.55rem; font-weight:700; }
  }

  @media screen and (max-width:480px) {
    .bhd-header .bhd-header__inner { min-height:82px; }
    .bhd-header .bhd-header__logo { width:36px; height:36px; }
    .bhd-header .bhd-header__site-name { font-size:1.72rem; }
    .bhd-header .bhd-header__tagline { font-size:.84rem; }
    .bhd-header .bhd-header__actions { gap:0; }
  }
</style>

<script>
  (() => {
    const closeItem = (item) => {
      if (!item) return;
      item.classList.remove('is-open');
      const toggle = item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle], :scope > .bhd-header__mobile-main-row [data-menu-toggle]');
      const panel = item.querySelector(':scope > [data-menu-panel]');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    };

    const closeSiblings = (item) => {
      const header = item.closest('.bhd-header');
      if (!header) return;
      const desktop = item.matches('[data-main-item]');
      const selector = desktop ? '[data-main-item].is-open' : '[data-mobile-main].is-open';
      header.querySelectorAll(selector).forEach((other) => { if (other !== item) closeItem(other); });
    };

    const openItem = (item) => {
      if (!item) return;
      closeSiblings(item);
      item.classList.add('is-open');
      const toggle = item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle], :scope > .bhd-header__mobile-main-row [data-menu-toggle]');
      const panel = item.querySelector(':scope > [data-menu-panel]');
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
      if (panel) panel.hidden = false;
    };

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('.bhd-header [data-menu-toggle]');
      if (toggle) {
        event.preventDefault();
        event.stopPropagation();
        const item = toggle.closest('[data-main-item], [data-mobile-main]');
        if (!item) return;
        if (item.classList.contains('is-open')) closeItem(item); else openItem(item);
        return;
      }

      if (!event.target.closest('.bhd-header__main-item')) {
        document.querySelectorAll('.bhd-header [data-main-item].is-open').forEach(closeItem);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') document.querySelectorAll('.bhd-header [data-main-item].is-open, .bhd-header [data-mobile-main].is-open').forEach(closeItem);
    });
  })();
</script>

