<style>
  .bhd-header{position:relative;z-index:40;border-bottom:1px solid rgba(var(--color-foreground),.09);background:rgb(var(--color-background))}
  .bhd-header .bhd-header__inner{min-height:82px;display:grid;grid-template-columns:max-content minmax(0,1fr) max-content;align-items:center;gap:3rem}
  .bhd-header__brand{display:inline-flex;align-items:center;justify-self:start;gap:.8rem;text-decoration:none;min-width:max-content}
  .bhd-header__logo{display:block;width:46px;height:46px;object-fit:contain;flex:0 0 auto}
  .bhd-header__brand-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
  .bhd-header__site-name{display:block;color:rgb(var(--color-foreground));font-family:var(--font-heading-family);font-size:2.5rem;font-weight:700;line-height:.92;white-space:nowrap}
  .bhd-header__tagline{display:block;margin-top:.02rem;color:rgba(var(--color-foreground),.72);font-family:var(--font-heading-family);font-size:1.05rem;font-weight:500;line-height:.95;white-space:nowrap}
  .bhd-header__nav{display:flex;align-items:center;justify-content:center;gap:1.6rem}
  .bhd-header__main-item{position:relative}
  .bhd-header__split-button{display:flex;align-items:stretch;min-height:4.2rem;border:1px solid transparent;border-radius:999px;overflow:hidden;transition:.15s ease}
  .bhd-header__main-link,.bhd-header__main-toggle{color:rgb(var(--color-foreground));background:transparent;border:0;font-family:inherit;font-size:1.5rem;letter-spacing:.03em}
  .bhd-header__main-link{display:flex;align-items:center;padding:0 .9rem 0 1.25rem;text-decoration:none;white-space:nowrap}
  .bhd-header__main-toggle{width:3.5rem;display:grid;place-items:center;padding:0;border-left:1px solid rgba(var(--color-foreground),.12);cursor:pointer}
  .bhd-header__main-toggle span{display:block;font-size:1.45rem;line-height:1;transition:transform .16s ease}
  .bhd-header__main-item:hover .bhd-header__split-button,.bhd-header__main-item:focus-within .bhd-header__split-button{background:rgba(var(--color-foreground),.04)}
  .bhd-header__main-item.is-open .bhd-header__split-button{background:rgba(var(--color-button),.12);border-color:rgba(var(--color-button),.42);box-shadow:0 .55rem 1.8rem rgba(13,33,78,.12)}
  .bhd-header__main-item.is-open .bhd-header__main-toggle span{transform:rotate(180deg)}
  .bhd-header__dropdown-menu{position:absolute;top:calc(100% + 1rem);left:50%;transform:translateX(calc(-50% + var(--menu-shift-x,0px)));width:min(860px,calc(100vw - 32px));padding:1.35rem;border-radius:14px;background:rgb(var(--color-background));box-shadow:0 18px 46px rgba(0,0,0,.14);border:1px solid rgba(var(--color-foreground),.1);display:none;grid-template-columns:repeat(4,minmax(0,1fr));gap:.9rem}
  .bhd-header__main-item.is-open .bhd-header__dropdown-menu,.bhd-header__main-item:hover .bhd-header__dropdown-menu,.bhd-header__main-item:focus-within .bhd-header__dropdown-menu{display:grid}
  .bhd-header__dropdown-child{min-width:0}
