<script>
  (() => {
    const qsa=(root,sel)=>Array.from(root.querySelectorAll(sel));
    const closeTier2=(item)=>{item.classList.remove('is-tier2-open');const btn=item.querySelector(':scope > .bhd-header__tier2-split .bhd-header__tier2-toggle, :scope > .bhd-header__mobile-tier2-split .bhd-header__mobile-tier2-toggle');if(btn)btn.setAttribute('aria-expanded','false')};
    const closeMain=(item)=>{item.classList.remove('is-open');const btn=item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle], :scope > .bhd-header__mobile-main-row [data-menu-toggle]');if(btn)btn.setAttribute('aria-expanded','false');qsa(item,'.is-tier2-open').forEach(closeTier2)};
    const openMain=(item)=>{const header=item.closest('.bhd-header');const selector=item.matches('[data-main-item]')?'[data-main-item].is-open':'[data-mobile-main].is-open';qsa(header,selector).forEach(other=>{if(other!==item)closeMain(other)});item.classList.add('is-open');const btn=item.querySelector(':scope > .bhd-header__split-button [data-menu-toggle], :scope > .bhd-header__mobile-main-row [data-menu-toggle]');if(btn)btn.setAttribute('aria-expanded','true');positionMenu(item)};
    const positionMenu=(item)=>{if(!item.matches('[data-main-item]')||window.innerWidth<990)return;const menu=item.querySelector(':scope > .bhd-header__dropdown-menu');if(!menu)return;menu.style.setProperty('--menu-shift-x','0px');requestAnimationFrame(()=>{const rect=menu.getBoundingClientRect(),margin=16;let shift=0;if(rect.left<margin)shift+=margin-rect.left;if(rect.right>window.innerWidth-margin)shift-=rect.right-(window.innerWidth-margin);menu.style.setProperty('--menu-shift-x',`${shift}px`)})};
    document.addEventListener('click',(event)=>{
      const mainToggle=event.target.closest('.bhd-header [data-menu-toggle]');if(mainToggle){event.preventDefault();event.stopPropagation();const item=mainToggle.closest('[data-main-item],[data-mobile-main]');if(item)item.classList.contains('is-open')?closeMain(item):openMain(item);return}
      const tierToggle=event.target.closest('.bhd-header__tier2-toggle,.bhd-header__mobile-tier2-toggle');if(tierToggle){event.preventDefault();event.stopPropagation();const item=tierToggle.closest('.bhd-header__dropdown-child,.bhd-header__mobile-tier2');const scope=item.closest('.bhd-header__dropdown-menu,.bhd-header__mobile-level-one');qsa(scope,'.is-tier2-open').forEach(other=>{if(other!==item)closeTier2(other)});const open=item.classList.toggle('is-tier2-open');tierToggle.setAttribute('aria-expanded',open?'true':'false');return}
      if(!event.target.closest('.bhd-header__main-item'))qsa(document,'.bhd-header [data-main-item].is-open').forEach(closeMain)
    });
    document.addEventListener('keydown',(event)=>{if(event.key==='Escape')qsa(document,'.bhd-header [data-main-item].is-open,.bhd-header [data-mobile-main].is-open').forEach(closeMain)});
    window.addEventListener('resize',()=>qsa(document,'.bhd-header [data-main-item].is-open').forEach(positionMenu),{passive:true});
  })();
</script>

