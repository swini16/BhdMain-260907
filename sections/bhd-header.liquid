{% assign header_menu = section.settings.menu %}
{% if header_menu == blank or header_menu.links == blank %}
  {% assign header_menu = linklists['new-menu'] %}
{% endif %}
{% if header_menu == blank or header_menu.links == blank %}
  {% assign header_menu = linklists['main-menu'] %}
{% endif %}

<header id="BhdHeader-{{ section.id }}" class="bhd-header color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width bhd-header__inner">
    <details class="bhd-header__mobile-menu">
      <summary class="bhd-header__icon-button" aria-label="Menu"><span aria-hidden="true">☰</span></summary>
      <div class="bhd-header__mobile-panel">
        {% for link in header_menu.links %}
          {% assign normalized_title = link.title | downcase | strip %}
          {% if normalized_title == 'shop' %}
            <a href="{{ link.url }}" class="bhd-header__mobile-shop">{{ link.title }}</a>
          {% elsif link.links != blank %}
            <details class="bhd-header__mobile-group">
              <summary>{{ link.title }}</summary>
              <div class="bhd-header__mobile-submenu">
                {% for childlink in link.links %}
                  {% if childlink.links != blank %}
                    <details class="bhd-header__mobile-group bhd-header__mobile-group--nested">
                      <summary>{{ childlink.title }}</summary>
                      <div class="bhd-header__mobile-submenu bhd-header__mobile-submenu--nested">
                        {% for grandchildlink in childlink.links %}
                          <a href="{{ grandchildlink.url }}">{{ grandchildlink.title }}</a>
                        {% endfor %}
                      </div>
                    </details>
                  {% else %}
                    <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </details>

    <a href="{{ routes.root_url }}" class="bhd-header__brand link link--text focus-inset" aria-label="{{ shop.name | escape }}">
      <span class="bhd-header__brand-main">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 200 | image_tag: class: 'bhd-header__logo', widths: '80,120,160,200', loading: 'eager', alt: shop.name }}
        {% endif %}
        <span class="bhd-header__site-name">{{ section.settings.site_name | escape }}</span>
      </span>
      {% if section.settings.tagline != blank %}<span class="bhd-header__tagline">{{ section.settings.tagline | escape }}</span>{% endif %}
    </a>

    <nav class="bhd-header__nav" aria-label="Primary navigation">
      {% for link in header_menu.links %}
        {% assign normalized_title = link.title | downcase | strip %}
        {% if normalized_title == 'shop' %}
          <a href="{{ link.url }}" class="bhd-header__shop-cta">{{ link.title }}</a>
        {% elsif link.links != blank %}
          <details class="bhd-header__dropdown">
            <summary>{{ link.title }}</summary>
            <div class="bhd-header__dropdown-menu">
              {% for childlink in link.links %}
                <div class="bhd-header__dropdown-child">
                  {% if childlink.links != blank %}
                    <a class="bhd-header__dropdown-parent" href="{{ childlink.url }}">{{ childlink.title }}</a>
                    <div class="bhd-header__dropdown-grandchildren">
                      {% for grandchildlink in childlink.links %}
                        <a href="{{ grandchildlink.url }}">{{ grandchildlink.title }}</a>
                      {% endfor %}
                    </div>
                  {% else %}
                    <a class="bhd-header__dropdown-parent bhd-header__dropdown-parent--solo" href="{{ childlink.url }}">{{ childlink.title }}</a>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="bhd-header__actions">
      <a href="{{ routes.search_url }}" class="bhd-header__icon-button" aria-label="Search"><span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span></a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="bhd-header__icon-button" aria-label="Account"><span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span></a>
      {% endif %}
      <a href="{{ routes.cart_url }}" class="bhd-header__icon-button bhd-header__cart-button" aria-label="Cart">
        <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% if cart.item_count > 0 %}<span class="bhd-header__cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
</header>

<style>
  .bhd-header { position:relative; z-index:40; border-bottom:1px solid rgba(var(--color-foreground),.09); background:rgb(var(--color-background)); }
  .bhd-header .bhd-header__inner { min-height:82px; display:grid; grid-template-columns:max-content minmax(0,1fr) max-content; align-items:center; gap:3rem; }
  .bhd-header .bhd-header__brand { display:inline-flex; flex-direction:column; align-items:center; justify-self:start; gap:.3rem; text-decoration:none; min-width:max-content; }
  .bhd-header .bhd-header__brand-main { display:inline-flex; align-items:center; gap:.8rem; }
  .bhd-header .bhd-header__logo { display:block; width:46px; height:46px; object-fit:contain; flex:0 0 auto; }
  .bhd-header .bhd-header__site-name { display:block; color:rgb(var(--color-foreground)); font-family:var(--font-heading-family); font-size:2.5rem; font-weight:700; line-height:.95; white-space:nowrap; }
  .bhd-header .bhd-header__tagline { display:block; width:100%; text-align:center; color:rgba(var(--color-foreground),.72); font-family:var(--font-heading-family); font-size:1.1rem; font-weight:500; line-height:1.1; white-space:nowrap; }
  .bhd-header .bhd-header__nav { display:flex; align-items:center; justify-content:center; gap:2.4rem; }
  .bhd-header .bhd-header__nav > a,
  .bhd-header .bhd-header__dropdown > summary { color:rgb(var(--color-foreground)); text-decoration:none; font-size:1.55rem; letter-spacing:.035em; cursor:pointer; list-style:none; }
  .bhd-header .bhd-header__shop-cta { display:inline-flex; align-items:center; justify-content:center; min-height:4.2rem; padding:0 2rem; border-radius:999px; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)) !important; font-weight:700; letter-spacing:.02em !important; box-shadow:0 .6rem 1.8rem rgba(var(--color-button),.18); transition:transform .15s ease,box-shadow .15s ease; }
  .bhd-header .bhd-header__shop-cta:hover { transform:translateY(-1px); box-shadow:0 .8rem 2.2rem rgba(var(--color-button),.24); }
  .bhd-header .bhd-header__dropdown { position:relative; }
  .bhd-header .bhd-header__dropdown > summary::-webkit-details-marker { display:none; }
  .bhd-header .bhd-header__dropdown > summary::after { content:'⌄'; display:inline-block; margin-left:.45rem; font-size:1.35rem; }
  .bhd-header .bhd-header__dropdown-menu { position:absolute; top:calc(100% + 1.2rem); left:50%; transform:translateX(-50%); width:min(880px,88vw); padding:1.6rem; border-radius:14px; background:rgb(var(--color-background)); box-shadow:0 18px 46px rgba(0,0,0,.14); border:1px solid rgba(var(--color-foreground),.08); display:grid; grid-template-columns:repeat(auto-fit,minmax(175px,1fr)); gap:.8rem 1rem; }
  .bhd-header .bhd-header__dropdown-child { min-width:0; padding:.45rem .5rem .6rem; border-radius:10px; }
  .bhd-header .bhd-header__dropdown-child:hover { background:rgba(var(--color-foreground),.025); }
  .bhd-header .bhd-header__dropdown-menu a { display:block; color:rgb(var(--color-foreground)); text-decoration:none; }
  .bhd-header .bhd-header__dropdown-parent { font-weight:700; font-size:1.45rem; padding:.6rem .65rem; line-height:1.25; white-space:normal; }
  .bhd-header .bhd-header__dropdown-parent--solo { font-weight:600; }
  .bhd-header .bhd-header__dropdown-grandchildren { margin-top:.2rem; }
  .bhd-header .bhd-header__dropdown-grandchildren a { font-size:1.3rem; opacity:.78; padding:.45rem .65rem; line-height:1.3; white-space:normal; }
  .bhd-header .bhd-header__dropdown-grandchildren a:hover,.bhd-header .bhd-header__dropdown-parent:hover { opacity:1; text-decoration:underline; text-underline-offset:.25rem; }
  .bhd-header .bhd-header__actions { display:flex; align-items:center; justify-self:end; gap:.7rem; }
  .bhd-header .bhd-header__icon-button { width:4rem; height:4rem; display:inline-flex; align-items:center; justify-content:center; color:rgb(var(--color-foreground)); text-decoration:none; position:relative; cursor:pointer; }
  .bhd-header .bhd-header__icon-button svg { width:2.1rem; height:2.1rem; }
  .bhd-header .bhd-header__cart-button svg { width:2.8rem; height:2.8rem; }
  .bhd-header .bhd-header__cart-count { position:absolute; top:.2rem; right:.1rem; min-width:1.7rem; height:1.7rem; border-radius:999px; display:grid; place-items:center; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)); font-size:1rem; }
  .bhd-header .bhd-header__mobile-menu { display:none; }

  @media screen and (min-width:990px) {
    .bhd-header .bhd-header__inner { position:relative; }
    .bhd-header .bhd-header__nav { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); justify-self:auto; }
    .bhd-header--floating { position:fixed; top:0; left:0; right:0; width:100%; z-index:3000; transform:translateY(calc(-100% - 4px)); transition:transform .18s ease,box-shadow .18s ease; box-shadow:0 8px 24px rgba(0,0,0,.09); pointer-events:none; }
    .bhd-header--floating.bhd-header--visible { transform:translateY(0); pointer-events:auto; }
  }

  @media screen and (max-width:989px) {
    .bhd-header .bhd-header__inner { min-height:84px; grid-template-columns:auto 1fr auto; gap:.65rem; padding-top:.6rem; padding-bottom:.6rem; }
    .bhd-header .bhd-header__mobile-menu { display:block; position:relative; }
    .bhd-header .bhd-header__nav { display:none; position:static; transform:none; }
    .bhd-header .bhd-header__brand { justify-self:center; gap:.28rem; min-width:0; }
    .bhd-header .bhd-header__brand-main { gap:.55rem; }
    .bhd-header .bhd-header__logo { width:38px; height:38px; }
    .bhd-header .bhd-header__site-name { font-size:1.82rem; }
    .bhd-header .bhd-header__tagline { font-size:.98rem; max-width:230px; white-space:normal; overflow:visible; text-overflow:clip; line-height:1.15; }
    .bhd-header .bhd-header__actions { justify-self:end; }
    .bhd-header .bhd-header__actions > a:first-child { display:none; }
    .bhd-header .bhd-header__cart-button svg { width:2.35rem; height:2.35rem; }
    .bhd-header .bhd-header__mobile-menu > summary { list-style:none; font-size:2.3rem; }
    .bhd-header .bhd-header__mobile-menu > summary::-webkit-details-marker { display:none; }
    .bhd-header .bhd-header__mobile-panel { position:absolute; top:calc(100% + 1rem); left:0; width:min(340px,90vw); max-height:78vh; overflow:auto; padding:1.2rem; background:rgb(var(--color-background)); border:1px solid rgba(var(--color-foreground),.08); border-radius:12px; box-shadow:0 12px 30px rgba(0,0,0,.14); }
    .bhd-header .bhd-header__mobile-panel > a,
    .bhd-header .bhd-header__mobile-panel summary,
    .bhd-header .bhd-header__mobile-submenu a { display:block; padding:.9rem 1rem; color:rgb(var(--color-foreground)); text-decoration:none; font-size:1.6rem; cursor:pointer; list-style:none; }
    .bhd-header .bhd-header__mobile-panel summary::-webkit-details-marker { display:none; }
    .bhd-header .bhd-header__mobile-submenu { padding-left:1rem; }
    .bhd-header .bhd-header__mobile-group--nested summary { font-size:1.45rem; font-weight:600; }
    .bhd-header .bhd-header__mobile-submenu--nested a { font-size:1.35rem; opacity:.82; }
    .bhd-header .bhd-header__mobile-shop { margin:.6rem .7rem .2rem; text-align:center; border-radius:999px; background:rgb(var(--color-button)); color:rgb(var(--color-button-text)) !important; font-weight:700; }
  }

  @media screen and (max-width:480px) {
    .bhd-header .bhd-header__inner { min-height:82px; }
    .bhd-header .bhd-header__logo { width:36px; height:36px; }
    .bhd-header .bhd-header__site-name { font-size:1.72rem; }
    .bhd-header .bhd-header__tagline { font-size:.9rem; max-width:205px; }
    .bhd-header .bhd-header__actions { gap:0; }
  }
</style>

<script>
  (() => {
    const original=document.getElementById('BhdHeader-{{ section.id }}'); if(!original)return;
    let floating=null,lastY=window.scrollY||0;
    const ensureFloating=()=>{ if(floating||!window.matchMedia('(min-width: 990px)').matches)return; floating=original.cloneNode(true); floating.id='BhdHeaderFloating-{{ section.id }}'; floating.classList.add('bhd-header--floating'); floating.setAttribute('aria-hidden','false'); document.body.appendChild(floating); };
    const show=()=>{ ensureFloating(); if(floating&&window.scrollY>original.offsetHeight)floating.classList.add('bhd-header--visible'); };
    const hide=()=>{ if(floating)floating.classList.remove('bhd-header--visible'); };
    const onScroll=()=>{ const y=Math.max(window.scrollY||0,0); if(!window.matchMedia('(min-width: 990px)').matches){hide();lastY=y;return;} if(y<=original.offsetHeight)hide(); else if(y<lastY-2)show(); else if(y>lastY+2)hide(); lastY=y; };
    window.addEventListener('wheel',event=>{ if(!window.matchMedia('(min-width: 990px)').matches)return; if(event.deltaY<-1)show(); if(event.deltaY>1)hide(); },{passive:true});
    window.addEventListener('scroll',onScroll,{passive:true});
    window.addEventListener('resize',()=>{ if(!window.matchMedia('(min-width: 990px)').matches)hide(); else ensureFloating(); lastY=window.scrollY||0; },{passive:true});
    ensureFloating();
  })();
</script>

{% schema %}
{
  "name":"Best Hydrate header",
  "enabled_on":{"groups":["header"]},
  "settings":[
    {"type":"text","id":"site_name","label":"Site name","default":"Best Hydrate"},
    {"type":"text","id":"tagline","label":"Tagline","default":"The Science of Hydration"},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}
  ],
  "presets":[{"name":"Best Hydrate header"}]
}
{% endschema %}
