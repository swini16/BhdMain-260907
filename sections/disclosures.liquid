{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .bhd-product-guide{padding-top:18px;padding-bottom:48px}
  .bhd-product-guide__breadcrumbs{display:flex;flex-wrap:wrap;gap:7px;align-items:center;font-size:1.3rem;margin-bottom:24px}
  .bhd-product-guide__breadcrumbs a{text-decoration:none}
  .bhd-product-guide__intro{max-width:820px;margin-bottom:24px}
  .bhd-product-guide__eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:1.2rem;font-weight:700;margin:0 0 8px}
  .bhd-product-guide__intro h2{margin:0 0 12px}
  .bhd-product-guide__intro p{margin:0}
  .bhd-product-guide__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  .bhd-product-guide__grid a{display:flex;flex-direction:column;gap:8px;padding:20px;border:1px solid rgba(var(--color-foreground),.14);border-radius:16px;text-decoration:none;color:rgb(var(--color-foreground));background:rgba(var(--color-background),1)}
  .bhd-product-guide__grid a:hover{border-color:rgba(var(--color-foreground),.34)}
  .bhd-product-guide__grid strong{font-size:1.7rem}
  .bhd-product-guide__grid span{font-size:1.4rem;line-height:1.5}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width:990px){.bhd-product-guide__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media screen and (max-width:600px){.bhd-product-guide{padding-bottom:34px}.bhd-product-guide__grid{grid-template-columns:1fr}}
{%- endstyle -%}

<section class="bhd-product-guide page-width" aria-labelledby="BhdProductGuide-{{ section.id }}">
  <nav class="bhd-product-guide__breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span>Solutions</span><span aria-hidden="true">›</span><span>Products</span><span aria-hidden="true">›</span><span aria-current="page">{{ product.title }}</span>
  </nav>
  <div class="bhd-product-guide__intro">
    <p class="bhd-product-guide__eyebrow">Know what you are mixing</p>
    <h2 id="BhdProductGuide-{{ section.id }}">Simple formula. Clear directions. Deeper science when you want it.</h2>
    <p>The current Best Hydrate formula lists glucose, sodium chloride, citric acid, sodium bicarbonate, potassium chloride and lemon powder. The public product page identifies NPN 80118664.</p>
  </div>
  <div class="bhd-product-guide__grid">
    <a href="/pages/product-details"><strong>Product Details</strong><span>Ingredients, formula roles, regulatory context and what the product is designed to do.</span></a>
    <a href="/pages/directions"><strong>Directions</strong><span>Label-first preparation, 500 mL serving context, handling and practical use.</span></a>
    <a href="/pages/our-formula"><strong>Our Formula</strong><span>See how glucose and the listed electrolyte sources fit together.</span></a>
    <a href="/pages/hydration-science"><strong>Hydration Science</strong><span>Understand fluid balance, electrolytes and intestinal absorption.</span></a>
  </div>
</section>

{%- capture disclosures_content -%}
  {%- render 'product-disclosures',
    product: product,
    heading: section.settings.heading,
    heading_size: section.settings.heading_size,
    open_by_default: section.settings.open_by_default,
    surface: 'product_page'
  -%}
{%- endcapture -%}

{%- unless disclosures_content == blank -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {{ disclosures_content }}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.disclosures.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.disclosures.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.disclosures.settings.heading.label",
      "default": "t:sections.disclosures.name"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:sections.disclosures.settings.open_by_default.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.disclosures.name"
    }
  ]
}
{% endschema %}