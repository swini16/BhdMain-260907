<section id="BhdMainPage-{{ section.id }}" class="bhd-page bhd-page--{{ page.handle }}">
  <div class="bhd-page__inner page-width">
    {% render 'bhd-page-dispatch' %}
  </div>
</section>

<style>
  #BhdMainPage-{{ section.id }}{--bhd-navy:#0b2d67;--bhd-blue:#078ee7;--bhd-ink:#1d3151;--bhd-muted:#5b6b82;--bhd-line:rgba(11,45,103,.12);--bhd-pale:#eef8fd;background:linear-gradient(180deg,#f9fcff 0%,#fff 24%,#f7fbff 100%);color:var(--bhd-ink);padding:2.4rem 0 6.5rem}
  #BhdMainPage-{{ section.id }} *{box-sizing:border-box}
  #BhdMainPage-{{ section.id }} .bhd-breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:0 0 2rem;font-size:1.28rem;color:#66758a}
  #BhdMainPage-{{ section.id }} .bhd-breadcrumbs a{color:var(--bhd-navy);text-decoration:none}#BhdMainPage-{{ section.id }} .bhd-breadcrumbs a:hover{text-decoration:underline}
  #BhdMainPage-{{ section.id }} .bhd-page-hero{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:clamp(2.6rem,5vw,7rem);align-items:center;margin-bottom:3.4rem;padding:clamp(2.2rem,4vw,4.5rem);border:1px solid var(--bhd-line);border-radius:2.4rem;background:#fff;box-shadow:0 2rem 5rem rgba(21,58,105,.08)}
  #BhdMainPage-{{ section.id }} .bhd-page__eyebrow,#BhdMainPage-{{ section.id }} .bhd-page__kicker{margin:0 0 .7rem;color:var(--bhd-blue);font-size:1.25rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  #BhdMainPage-{{ section.id }} h1{margin:0;color:var(--bhd-navy);font-size:clamp(4.3rem,6vw,7.2rem);line-height:.95;letter-spacing:-.045em}
  #BhdMainPage-{{ section.id }} .bhd-page-hero__lede{max-width:72rem;margin:1.6rem 0 0;color:#42536f;font-size:clamp(1.7rem,2vw,2.15rem);line-height:1.5}
  #BhdMainPage-{{ section.id }} .bhd-page-hero__media{overflow:hidden;border-radius:1.8rem;aspect-ratio:1.28/1;background:#dcecf5}#BhdMainPage-{{ section.id }} .bhd-page-hero__media img{display:block;width:100%;height:100%;object-fit:cover}
  #BhdMainPage-{{ section.id }} .bhd-page__keypoints{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem;margin:0 0 5.2rem}#BhdMainPage-{{ section.id }} .bhd-page__keypoints>div{padding:1.8rem 1.9rem;border:1px solid var(--bhd-line);border-radius:1.4rem;background:#fff}#BhdMainPage-{{ section.id }} .bhd-page__keypoints strong{display:block;margin-bottom:.5rem;color:var(--bhd-navy);font-size:1.65rem}#BhdMainPage-{{ section.id }} .bhd-page__keypoints span{display:block;color:var(--bhd-muted);font-size:1.38rem;line-height:1.42}
  #BhdMainPage-{{ section.id }} h2{margin:0 0 1.4rem;color:var(--bhd-navy);font-size:clamp(2.8rem,3.4vw,4.2rem);line-height:1.04;letter-spacing:-.025em}#BhdMainPage-{{ section.id }} h3{color:var(--bhd-navy)}#BhdMainPage-{{ section.id }} p,#BhdMainPage-{{ section.id }} li{font-size:1.6rem;line-height:1.6}
  #BhdMainPage-{{ section.id }} .bhd-page__prose-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:3rem;align-items:start;margin:0 0 5.5rem}#BhdMainPage-{{ section.id }} .bhd-page__prose{max-width:82rem}#BhdMainPage-{{ section.id }} .bhd-page__prose p{color:#465774}
  #BhdMainPage-{{ section.id }} .bhd-page__callout{padding:2.4rem;border-radius:1.8rem;background:linear-gradient(160deg,#0b2d67,#0f5092);color:#fff;box-shadow:0 1.5rem 4rem rgba(11,45,103,.16)}#BhdMainPage-{{ section.id }} .bhd-page__callout-label{font-size:1.15rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.75}#BhdMainPage-{{ section.id }} .bhd-page__callout h3{margin:.7rem 0 1rem;color:#fff;font-size:2.25rem;line-height:1.12}#BhdMainPage-{{ section.id }} .bhd-page__callout p{margin:0;color:rgba(255,255,255,.87);font-size:1.42rem}
  #BhdMainPage-{{ section.id }} .bhd-page__split{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(3rem,5vw,6rem);align-items:center;margin:0 0 6rem;padding:2.2rem;border-radius:2.2rem;background:var(--bhd-pale)}#BhdMainPage-{{ section.id }} .bhd-page__split-media{overflow:hidden;border-radius:1.6rem;aspect-ratio:1.1/1}#BhdMainPage-{{ section.id }} .bhd-page__split-media img{display:block;width:100%;height:100%;object-fit:cover}#BhdMainPage-{{ section.id }} .bhd-page__split-copy{padding:1.5rem 2rem 1.5rem 0}#BhdMainPage-{{ section.id }} .bhd-page__split-copy ul{margin:1.5rem 0 1.7rem;padding-left:2rem;color:#465774}#BhdMainPage-{{ section.id }} .bhd-page__split-copy li+li{margin-top:.75rem}
  #BhdMainPage-{{ section.id }} .bhd-page__text-link{display:inline-flex;gap:.6rem;color:var(--bhd-blue);font-size:1.5rem;font-weight:800;text-decoration:none}
  #BhdMainPage-{{ section.id }} .bhd-page__feature{margin:0 0 6rem;padding:clamp(2.6rem,5vw,5rem);border-radius:2.2rem;background:linear-gradient(135deg,#f7fcff 0%,#e7f7fd 100%);border:1px solid rgba(7,142,231,.13)}#BhdMainPage-{{ section.id }} .bhd-page__feature>div{max-width:92rem;margin:0 auto;text-align:center}#BhdMainPage-{{ section.id }} .bhd-page__feature p{color:#465774}
  #BhdMainPage-{{ section.id }} .bhd-page__button{display:inline-flex;align-items:center;justify-content:center;margin-top:1.2rem;padding:1.15rem 1.8rem;border-radius:999px;background:var(--bhd-navy);color:#fff;font-size:1.42rem;font-weight:800;text-decoration:none}#BhdMainPage-{{ section.id }} .bhd-page__button--secondary{background:#fff;color:var(--bhd-navy);border:1px solid rgba(11,45,103,.18)}
  #BhdMainPage-{{ section.id }} .bhd-page__cards-section{margin:0 0 6rem}#BhdMainPage-{{ section.id }} .bhd-page__cards{display:grid;gap:1.35rem}#BhdMainPage-{{ section.id }} .bhd-page__cards--4{grid-template-columns:repeat(4,minmax(0,1fr))}#BhdMainPage-{{ section.id }} .bhd-page__cards--3{grid-template-columns:repeat(3,minmax(0,1fr))}#BhdMainPage-{{ section.id }} .bhd-page__cards article{padding:2rem;border:1px solid var(--bhd-line);border-radius:1.6rem;background:#fff}#BhdMainPage-{{ section.id }} .bhd-page__cards h3{margin:0 0 .7rem;font-size:1.85rem}#BhdMainPage-{{ section.id }} .bhd-page__cards p{margin:0 0 1rem;color:var(--bhd-muted);font-size:1.38rem;line-height:1.45}#BhdMainPage-{{ section.id }} .bhd-page__cards a{color:var(--bhd-blue);font-size:1.35rem;font-weight:800;text-decoration:none}
  #BhdMainPage-{{ section.id }} .bhd-page__brand-context{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3rem;align-items:center;margin:0 0 6rem;padding:clamp(2.5rem,4vw,4rem);border-radius:2rem;background:#0b2d67;color:#fff}#BhdMainPage-{{ section.id }} .bhd-page__brand-context h2{color:#fff}#BhdMainPage-{{ section.id }} .bhd-page__brand-context p{max-width:86rem;color:rgba(255,255,255,.83)}#BhdMainPage-{{ section.id }} .bhd-page__brand-context .bhd-page__kicker{color:#75d5ff}#BhdMainPage-{{ section.id }} .bhd-page__brand-actions{display:flex;flex-direction:column;min-width:20rem}#BhdMainPage-{{ section.id }} .bhd-page__brand-context .bhd-page__button{background:#fff;color:var(--bhd-navy)}#BhdMainPage-{{ section.id }} .bhd-page__brand-context .bhd-page__button--secondary{background:transparent;color:#fff;border-color:rgba(255,255,255,.35)}
  #BhdMainPage-{{ section.id }} .bhd-page__related{margin:0 0 5rem}#BhdMainPage-{{ section.id }} .bhd-page__related-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.3rem}#BhdMainPage-{{ section.id }} .bhd-page__related-grid a{display:block;padding:2rem;border:1px solid var(--bhd-line);border-radius:1.5rem;background:#fff;color:inherit;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease}#BhdMainPage-{{ section.id }} .bhd-page__related-grid a:hover{transform:translateY(-2px);box-shadow:0 1rem 2.5rem rgba(11,45,103,.08)}#BhdMainPage-{{ section.id }} .bhd-page__related-grid strong{display:block;margin-bottom:.55rem;color:var(--bhd-navy);font-size:1.6rem}#BhdMainPage-{{ section.id }} .bhd-page__related-grid span{display:block;color:var(--bhd-muted);font-size:1.3rem;line-height:1.42}
  #BhdMainPage-{{ section.id }} .bhd-page__references{padding-top:2.7rem;border-top:1px solid var(--bhd-line)}#BhdMainPage-{{ section.id }} .bhd-page__references h2{font-size:2.35rem}#BhdMainPage-{{ section.id }} .bhd-page__references ol{padding-left:2.2rem}#BhdMainPage-{{ section.id }} .bhd-page__references li{font-size:1.28rem;line-height:1.5;color:#56667d}#BhdMainPage-{{ section.id }} .bhd-page__references li+li{margin-top:.65rem}#BhdMainPage-{{ section.id }} .bhd-page__references a{color:#315b91}#BhdMainPage-{{ section.id }} .bhd-page__reference-note{margin-top:1.2rem;color:#778397;font-size:1.18rem}
  #BhdMainPage-{{ section.id }} .bhd-page__steps{display:grid;gap:1rem;counter-reset:bhdstep;margin:0 0 5.5rem}#BhdMainPage-{{ section.id }} .bhd-page__step{position:relative;padding:1.8rem 2rem 1.8rem 6rem;border-radius:1.4rem;background:#fff;border:1px solid var(--bhd-line)}#BhdMainPage-{{ section.id }} .bhd-page__step:before{counter-increment:bhdstep;content:counter(bhdstep);position:absolute;left:1.5rem;top:1.5rem;width:3.2rem;height:3.2rem;border-radius:50%;display:grid;place-items:center;background:var(--bhd-navy);color:#fff;font-weight:800}#BhdMainPage-{{ section.id }} .bhd-page__step h3{margin:.1rem 0 .45rem;font-size:1.8rem}#BhdMainPage-{{ section.id }} .bhd-page__step p{margin:0;color:var(--bhd-muted);font-size:1.4rem}
  #BhdMainPage-{{ section.id }} .bhd-page__table-wrap{overflow:auto;margin:0 0 5.5rem;border:1px solid var(--bhd-line);border-radius:1.5rem;background:#fff}#BhdMainPage-{{ section.id }} table{width:100%;border-collapse:collapse;min-width:650px}#BhdMainPage-{{ section.id }} th,#BhdMainPage-{{ section.id }} td{padding:1.2rem 1.4rem;border-bottom:1px solid var(--bhd-line);text-align:left;vertical-align:top;font-size:1.35rem;line-height:1.45}#BhdMainPage-{{ section.id }} th{color:var(--bhd-navy);background:#eef8fd;font-weight:800}
  #BhdMainPage-{{ section.id }} .bhd-page-fallback__content{max-width:95rem;margin:0 auto}#BhdMainPage-{{ section.id }} .bhd-page-fallback__content h1{margin-bottom:2rem}
  @media screen and (max-width:989px){#BhdMainPage-{{ section.id }} .bhd-page-hero{grid-template-columns:1fr;gap:2.2rem}#BhdMainPage-{{ section.id }} .bhd-page-hero__media{aspect-ratio:1.8/1}#BhdMainPage-{{ section.id }} .bhd-page__prose-grid{grid-template-columns:1fr}#BhdMainPage-{{ section.id }} .bhd-page__split{grid-template-columns:1fr}#BhdMainPage-{{ section.id }} .bhd-page__split-media{aspect-ratio:1.8/1}#BhdMainPage-{{ section.id }} .bhd-page__split-copy{padding:1rem}#BhdMainPage-{{ section.id }} .bhd-page__cards--4,#BhdMainPage-{{ section.id }} .bhd-page__related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#BhdMainPage-{{ section.id }} .bhd-page__cards--3{grid-template-columns:1fr}#BhdMainPage-{{ section.id }} .bhd-page__brand-context{grid-template-columns:1fr}#BhdMainPage-{{ section.id }} .bhd-page__brand-actions{flex-direction:row;flex-wrap:wrap;min-width:0}}
  @media screen and (max-width:749px){#BhdMainPage-{{ section.id }}{padding-top:1.4rem;padding-bottom:4.5rem}#BhdMainPage-{{ section.id }} .bhd-breadcrumbs{margin-bottom:1.3rem;font-size:1.15rem}#BhdMainPage-{{ section.id }} .bhd-page-hero{padding:1.5rem;border-radius:1.7rem;margin-bottom:2rem}#BhdMainPage-{{ section.id }} h1{font-size:4rem}#BhdMainPage-{{ section.id }} .bhd-page-hero__lede{font-size:1.55rem}#BhdMainPage-{{ section.id }} .bhd-page-hero__media{aspect-ratio:1.45/1;border-radius:1.3rem}#BhdMainPage-{{ section.id }} .bhd-page__keypoints{grid-template-columns:1fr;margin-bottom:4rem}#BhdMainPage-{{ section.id }} .bhd-page__prose-grid,#BhdMainPage-{{ section.id }} .bhd-page__split,#BhdMainPage-{{ section.id }} .bhd-page__feature,#BhdMainPage-{{ section.id }} .bhd-page__cards-section,#BhdMainPage-{{ section.id }} .bhd-page__brand-context{margin-bottom:4.5rem}#BhdMainPage-{{ section.id }} .bhd-page__split{padding:1.2rem}#BhdMainPage-{{ section.id }} .bhd-page__split-media{aspect-ratio:1.4/1}#BhdMainPage-{{ section.id }} .bhd-page__cards--4,#BhdMainPage-{{ section.id }} .bhd-page__related-grid{grid-template-columns:1fr}#BhdMainPage-{{ section.id }} .bhd-page__brand-context{padding:2rem}#BhdMainPage-{{ section.id }} .bhd-page__brand-actions{flex-direction:column}}
</style>

{% schema %}
{
  "name":"Best Hydrate page system",
  "tag":"section",
  "class":"section",
  "settings":[
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":0},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":0}
  ]
}
{% endschema %}
