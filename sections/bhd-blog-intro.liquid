{% if blog.handle == 'news' %}
<section id="BhdBlogIntro-{{ section.id }}" class="bhd-blog-intro">
  <div class="page-width">
    <nav class="bhd-blog-intro__breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span>Connect</span><span aria-hidden="true">›</span><span aria-current="page">News & Insights</span></nav>

    <div class="bhd-blog-intro__hero">
      <div class="bhd-blog-intro__copy">
        <p class="bhd-blog-intro__eyebrow">News, Science & Performance</p>
        <h1>News & Insights</h1>
        <p>Company updates, athlete stories, hydration education and research commentary from Best Hydrate. Older articles remain part of the archive, while the rebuilt Science pages provide the controlling reference for current scientific and product claims.</p>
        <div class="bhd-blog-intro__actions"><a href="/pages/hydration-science">Hydration Science</a><a href="/pages/press">Press & Media</a></div>
      </div>
      {% assign featured_article = blog.articles.first %}
      {% if featured_article != blank %}
        <a class="bhd-blog-intro__featured" href="{{ featured_article.url }}">
          {% if featured_article.image != blank %}
            {{ featured_article.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', alt: featured_article.title }}
          {% endif %}
          <div class="bhd-blog-intro__featured-body"><span>Latest article</span><strong>{{ featured_article.title }}</strong><small>{{ featured_article.published_at | time_tag: format: 'date' }}</small></div>
        </a>
      {% endif %}
    </div>

    {% if blog.all_tags.size > 0 %}
      <div class="bhd-blog-intro__tags" aria-label="News topics"><span>Browse topics</span><a href="{{ blog.url }}">All</a>{% for tag in blog.all_tags limit: 10 %}<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% endfor %}</div>
    {% endif %}

    <aside class="bhd-blog-intro__startup" aria-label="About our newsroom">
      <span class="bhd-blog-intro__startup-icon" aria-hidden="true">📰</span>
      <p><strong>Our newsroom is growing with us.</strong> Best Hydrate is still a startup, so the archive will expand as research, partnerships, product milestones and community work become ready to share. Thank you for being patient as we build the story in public rather than filling the page with noise.</p>
    </aside>
  </div>
</section>

<style>
  #BhdBlogIntro-{{ section.id }}{padding:2.4rem 0 1rem;background:linear-gradient(180deg,#f7fbff,#fff);color:#1d3151}
  #BhdBlogIntro-{{ section.id }} *{box-sizing:border-box}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:0 0 2rem;color:#66758a;font-size:1.28rem}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__breadcrumbs a{color:#0b2d67;text-decoration:none}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.9fr);gap:clamp(2.5rem,5vw,6rem);align-items:center;padding:clamp(2.4rem,4vw,4.5rem);border:1px solid rgba(11,45,103,.12);border-radius:2.4rem;background:#fff;box-shadow:0 2rem 5rem rgba(21,58,105,.08)}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__eyebrow{margin:0 0 .8rem;color:#078ee7;font-size:1.25rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  #BhdBlogIntro-{{ section.id }} h1{margin:0;color:#0b2d67;font-size:clamp(4.2rem,6vw,7rem);line-height:.95;letter-spacing:-.045em}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__copy>p:not(.bhd-blog-intro__eyebrow){max-width:70rem;margin:1.5rem 0 0;color:#42536f;font-size:1.75rem;line-height:1.55}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__actions{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__actions a{padding:1rem 1.5rem;border-radius:999px;background:#0b2d67;color:#fff;font-size:1.35rem;font-weight:800;text-decoration:none}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__actions a+ a{background:#fff;color:#0b2d67;border:1px solid rgba(11,45,103,.18)}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured{position:relative;display:block;overflow:hidden;min-height:34rem;border-radius:1.8rem;background:#dcecf5;color:#fff;text-decoration:none}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,28,60,.05),rgba(7,28,60,.82))}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured-body{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:2.2rem}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured-body span{display:block;margin-bottom:.6rem;font-size:1.1rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#80d8ff}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured-body strong{display:block;font-size:2.25rem;line-height:1.12}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured-body small{display:block;margin-top:.7rem;font-size:1.2rem;color:rgba(255,255,255,.78)}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__tags{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;padding:2rem 0 .5rem}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__tags>span{margin-right:.35rem;color:#0b2d67;font-size:1.25rem;font-weight:800}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__tags a{padding:.65rem 1rem;border:1px solid rgba(11,45,103,.12);border-radius:999px;background:#fff;color:#315b91;font-size:1.2rem;text-decoration:none}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup{display:grid;grid-template-columns:4.8rem minmax(0,1fr);gap:1.2rem;align-items:center;margin:2rem 0 1rem;padding:1.45rem 1.6rem;border:1px solid rgba(11,45,103,.12);border-radius:1.4rem;background:rgba(11,45,103,.035)}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup-icon{width:4.8rem;height:4.8rem;display:grid;place-items:center;border-radius:1.2rem;background:#fff;border:1px solid rgba(11,45,103,.12);font-size:2.2rem}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup p{margin:0;color:#42536f;font-size:1.4rem;line-height:1.55}
  #BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup strong{color:#0b2d67}
  @media screen and (max-width:989px){#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__hero{grid-template-columns:1fr}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured{min-height:30rem}}
  @media screen and (max-width:749px){#BhdBlogIntro-{{ section.id }}{padding-top:1.4rem}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__hero{padding:2rem;border-radius:1.7rem}#BhdBlogIntro-{{ section.id }} h1{font-size:4.2rem}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__copy>p:not(.bhd-blog-intro__eyebrow){font-size:1.55rem}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__featured{min-height:25rem}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup{grid-template-columns:1fr;align-items:start}#BhdBlogIntro-{{ section.id }} .bhd-blog-intro__startup-icon{width:4.2rem;height:4.2rem;font-size:1.9rem}}
</style>
{% endif %}

{% comment %}Startup newsroom enrichment sync marker 2026-09-09.{% endcomment %}

