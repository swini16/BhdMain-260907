<section id="BhdScienceResearch-{{ section.id }}" class="bhd-science-research color-{{ section.settings.color_scheme }} gradient" aria-labelledby="BhdScienceResearchHeading-{{ section.id }}">
  <div class="page-width">
    <div class="bhd-science-research__wedge">
      <div class="bhd-science-research__wedge-copy">
        <p class="bhd-science-research__wedge-eyebrow">FLAGSHIP FORMULATION DIFFERENCE</p>
        <h2>LOW SUGAR HITS THE HYDRATION SWEET SPOT.</h2>
        <p><strong>1 g of sugar per 100 mL prepared.</strong> Best Hydrate keeps purposeful glucose in the formula for sodium-glucose transport, without carrying the high sugar load common in conventional sports and energy drinks.</p>
        <p class="bhd-science-research__wedge-line"><strong>Low sugar, on purpose. Not zero. Not overloaded.</strong></p>
        <div class="bhd-science-research__wedge-actions">
          <a href="/pages/low-sugar-hydration-glucose-sglt1">Read the low-sugar science →</a>
          <a class="is-shop" href="/products/lemonade-best-hydrate">Shop Best Hydrate</a>
        </div>
      </div>
      <div class="bhd-science-research__wedge-facts" aria-label="Best Hydrate low-sugar formula highlights">
        <div><strong>1.0 g</strong><span>sugar / 100 mL</span></div>
        <div><strong>SGLT1</strong><span>sodium + glucose transport</span></div>
        <div><strong>5</strong><span>electrolyte species</span></div>
      </div>
    </div>

    <div class="bhd-science-research__shell">
      <div class="bhd-science-research__intro">
        <p class="bhd-science-research__eyebrow">SCIENCE UPDATE</p>
        <span class="bhd-science-research__status">PUBLICATION COMING SOON</span>
        <h2 id="BhdScienceResearchHeading-{{ section.id }}">Peer-reviewed hydration research is nearing publication.</h2>
        <p>Our oral hydration review has been accepted by <em>Frontiers in Nutrition</em> and is now in final production. We’ll add the final article here as soon as it is released.</p>
        <a class="bhd-science-research__cta" href="/pages/publications">Follow the publication →</a>
      </div>

      <div class="bhd-science-research__grid">
        <a class="bhd-science-research__card" href="/pages/publications">
          <span class="bhd-science-research__label">FINAL PRODUCTION</span>
          <strong>Peer-reviewed oral hydration review</strong>
          <span>Accepted by <em>Frontiers in Nutrition</em>. The final formatted publication is being prepared.</span>
          <b>View publication status →</b>
        </a>
        <a class="bhd-science-research__card" href="/pages/current-research">
          <span class="bhd-science-research__label">IN PROGRESS</span>
          <strong>Current research program</strong>
          <span>See what is accepted, planned, exploratory and still awaiting data.</span>
          <b>Current research →</b>
        </a>
        <a class="bhd-science-research__card" href="/pages/research-partners">
          <span class="bhd-science-research__label">COLLABORATION</span>
          <strong>Research partners &amp; contributors</strong>
          <span>Meet the people and affiliations contributing to the scientific work, with roles kept explicit.</span>
          <b>Meet collaborators →</b>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #BhdScienceResearch-{{ section.id }}{padding:5.6rem 0;background:linear-gradient(180deg,#f7fbff 0%,#eef5fb 100%);border-top:1px solid #d8e7f5;border-bottom:1px solid #d8e7f5}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:1.5rem;align-items:stretch;margin-bottom:2.2rem;padding:2.2rem;border:1px solid #aed5ee;border-radius:1.7rem;background:linear-gradient(135deg,#fff 0%,#eef9ff 62%,#fffbe9 100%);box-shadow:0 1rem 2.8rem rgba(16,42,97,.08)}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-copy{max-width:880px}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-eyebrow{margin:0 0 .65rem;color:#1681d8;font-size:1.05rem;font-weight:900;letter-spacing:.16em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge h2{margin:0;color:#102a61;font-size:clamp(3.2rem,4.8vw,5.7rem);line-height:.98;letter-spacing:-.035em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-copy>p:not(.bhd-science-research__wedge-eyebrow){max-width:830px;margin:1rem 0 0;color:#425675;font-size:1.48rem;line-height:1.5}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-line{color:#0d568f!important}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.45rem}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:4rem;padding:.8rem 1.2rem;border:1px solid #7daed0;border-radius:999px;background:#fff;color:#0b477f;font-size:1.18rem;font-weight:850;text-decoration:none}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-actions .is-shop{border-color:#0c5798;background:#0c5798;color:#fff}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts{display:grid;grid-template-columns:1fr;gap:.7rem}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts div{display:flex;flex-direction:column;justify-content:center;padding:1.15rem;border:1px solid #c6ddeb;border-radius:1.15rem;background:rgba(255,255,255,.9);text-align:center}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts strong{display:block;color:#0b477f;font-size:2rem;line-height:1}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts span{display:block;margin-top:.35rem;color:#5d6f84;font-size:1.05rem;line-height:1.2}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__shell{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.5fr);gap:2.2rem;align-items:stretch}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__intro{padding:2.3rem;border-radius:1.6rem;background:#102a61;color:#fff;box-shadow:0 1.4rem 3.5rem rgba(16,42,97,.13)}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__eyebrow{margin:0 0 .7rem;color:#9fd6ff;font-size:1.1rem;font-weight:850;letter-spacing:.16em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__status{display:inline-flex;margin:0 0 1rem;padding:.48rem .78rem;border-radius:999px;background:#dff5ff;color:#0b4b82;font-size:.98rem;font-weight:900;letter-spacing:.08em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__intro h2{margin:0;color:#fff;font-size:clamp(3rem,3.7vw,4.3rem);line-height:1.02;letter-spacing:-.025em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__intro>p:not(.bhd-science-research__eyebrow){margin:1.1rem 0 1.7rem;color:rgba(255,255,255,.84);font-size:1.42rem;line-height:1.5}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__cta{display:inline-flex;align-items:center;justify-content:center;min-height:4rem;padding:.8rem 1.2rem;border-radius:999px;background:#fff;color:#102a61;font-size:1.25rem;font-weight:850;text-decoration:none}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card{display:flex;flex-direction:column;padding:2rem;border:1px solid #bfd0e3;border-radius:1.45rem;background:#fff;color:#17315f;text-decoration:none;box-shadow:0 .7rem 2rem rgba(31,66,116,.06);transition:transform .16s ease,border-color .16s ease}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card:hover{transform:translateY(-2px);border-color:#7fa3ca}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__label{margin-bottom:1rem;color:#398ee1;font-size:1.02rem;font-weight:850;letter-spacing:.12em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card strong{color:#102a61;font-size:1.7rem;line-height:1.2}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card>span:not(.bhd-science-research__label){margin-top:.85rem;color:#526078;font-size:1.3rem;line-height:1.48}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card b{margin-top:auto;padding-top:1.45rem;color:#245f8f;font-size:1.18rem}
  @media screen and (max-width:989px){#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge{grid-template-columns:1fr}#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts{grid-template-columns:repeat(3,minmax(0,1fr))}#BhdScienceResearch-{{ section.id }} .bhd-science-research__shell{grid-template-columns:1fr}#BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media screen and (max-width:749px){#BhdScienceResearch-{{ section.id }}{padding:4rem 0}#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge{padding:1.6rem}#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-facts{grid-template-columns:1fr}#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-actions{flex-direction:column}#BhdScienceResearch-{{ section.id }} .bhd-science-research__wedge-actions a{width:100%}#BhdScienceResearch-{{ section.id }} .bhd-science-research__intro{padding:2rem}#BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{grid-template-columns:1fr}}
</style>

