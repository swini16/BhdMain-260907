<section id="BhdScienceResearch-{{ section.id }}" class="bhd-science-research color-{{ section.settings.color_scheme }} gradient" aria-labelledby="BhdScienceResearchHeading-{{ section.id }}">
  <div class="page-width">
    <div class="bhd-science-research__shell">
      <div class="bhd-science-research__intro">
        <p class="bhd-science-research__eyebrow">SCIENCE &amp; RESEARCH</p>
        <h2 id="BhdScienceResearchHeading-{{ section.id }}">Built to be examined.</h2>
        <p>Best Hydrate separates established hydration science, published review work and research in progress so each claim stays tied to the right level of evidence.</p>
        <a class="bhd-science-research__cta" href="/pages/science-overview">Explore the Science →</a>
      </div>

      <div class="bhd-science-research__grid">
        <a class="bhd-science-research__card" href="/pages/publications">
          <span class="bhd-science-research__label">PUBLICATION</span>
          <strong>Peer-reviewed oral hydration review</strong>
          <span>A Best Hydrate and University of Alberta-affiliated review accepted by <em>Frontiers in Nutrition</em>.</span>
          <b>View publication →</b>
        </a>
        <a class="bhd-science-research__card" href="/pages/current-research">
          <span class="bhd-science-research__label">IN PROGRESS</span>
          <strong>Current research program</strong>
          <span>See what is published, planned, exploratory and still awaiting data.</span>
          <b>Current research →</b>
        </a>
        <a class="bhd-science-research__card" href="/pages/research-partners">
          <span class="bhd-science-research__label">COLLABORATION</span>
          <strong>Research partners &amp; contributors</strong>
          <span>Meet the people and affiliations contributing to the scientific work, with roles kept explicit.</span>
          <b>Meet collaborators →</b>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #BhdScienceResearch-{{ section.id }}{padding:5.6rem 0;background:linear-gradient(180deg,#f7fbff 0%,#eef5fb 100%)}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__shell{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.5fr);gap:2.2rem;align-items:stretch}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__intro{padding:2.3rem;border-radius:1.6rem;background:#102a61;color:#fff;box-shadow:0 1.4rem 3.5rem rgba(16,42,97,.13)}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__eyebrow{margin:0 0 .8rem;color:#9fd6ff;font-size:1.1rem;font-weight:850;letter-spacing:.16em}
  #BhdScienceResearch-{{ section.id }} h2{margin:0;color:#fff;font-size:clamp(3rem,3.7vw,4.3rem);line-height:1.02;letter-spacing:-.025em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__intro>p:not(.bhd-science-research__eyebrow){margin:1.1rem 0 1.7rem;color:rgba(255,255,255,.82);font-size:1.42rem;line-height:1.5}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__cta{display:inline-flex;align-items:center;justify-content:center;min-height:4rem;padding:.8rem 1.2rem;border-radius:999px;background:#fff;color:#102a61;font-size:1.25rem;font-weight:850;text-decoration:none}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card{display:flex;flex-direction:column;padding:2rem;border:1px solid #bfd0e3;border-radius:1.45rem;background:#fff;color:#17315f;text-decoration:none;box-shadow:0 .7rem 2rem rgba(31,66,116,.06);transition:transform .16s ease,border-color .16s ease}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card:hover{transform:translateY(-2px);border-color:#7fa3ca}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__label{margin-bottom:1rem;color:#398ee1;font-size:1.02rem;font-weight:850;letter-spacing:.12em}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card strong{color:#102a61;font-size:1.7rem;line-height:1.2}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card>span:not(.bhd-science-research__label){margin-top:.85rem;color:#526078;font-size:1.3rem;line-height:1.48}
  #BhdScienceResearch-{{ section.id }} .bhd-science-research__card b{margin-top:auto;padding-top:1.45rem;color:#245f8f;font-size:1.18rem}
  @media screen and (max-width:989px){#BhdScienceResearch-{{ section.id }} .bhd-science-research__shell{grid-template-columns:1fr}#BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media screen and (max-width:749px){#BhdScienceResearch-{{ section.id }}{padding:4rem 0}#BhdScienceResearch-{{ section.id }} .bhd-science-research__intro{padding:2rem}#BhdScienceResearch-{{ section.id }} .bhd-science-research__grid{grid-template-columns:1fr}}
</style>

{% schema %}
{
  "name":"Science and research",
  "settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}],
  "presets":[{"name":"Science and research"}]
}
{% endschema %}