    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__eyebrow{margin-bottom:.65rem;font-size:.84rem;font-weight:950}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{font-size:clamp(2.05rem,3.2vw,2.55rem);letter-spacing:-.04em}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{margin:.78rem 0 .55rem;font-size:1.1rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{font-size:1rem;line-height:1.48;font-weight:560}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions{gap:.65rem;margin-top:1rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__button{min-height:4rem;padding:.7rem 1rem;font-size:1.08rem;font-weight:900}
