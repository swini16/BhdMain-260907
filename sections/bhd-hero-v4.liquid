{% assign hero_product_url = '/products/lemonade-best-hydrate' %}
{% assign hero_scene_url = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/hydrate_for_your_best_day.png?v=1790043208' %}
{% assign hero_product_image_url = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/best-hydrate-lemonade-powder-jar-hero-v2-20260921.png?v=1790018423' %}

<section id="BhdHeroV4-{{ section.id }}" class="bhd-hero-v4" data-bhd-hero-v4>
  <div class="bhd-hero-v4__shell">
    <div class="bhd-hero-v4__copy">
      <p class="bhd-hero-v4__eyebrow">LOW-SUGAR PERFORMANCE HYDRATION</p>

      <h1 class="bhd-hero-v4__title">
        <span>Your best performance deserves</span>
        <span><em>low sugar,</em> not sugar</span>
        <span>extremes.</span>
      </h1>

      <p class="bhd-hero-v4__middle">Not zero. Not overloaded. The hydration middle.</p>

      <p class="bhd-hero-v4__body">
        Zero sugar leaves helpful glucose out. Traditional sports drinks bring a heavy sugar load.
        Best Hydrate hits the hydration sweet spot, with purposeful glucose, five electrolyte species,
        and just 1 g sugar per 100 mL prepared. And it fits in your bag :D
      </p>

      <div class="bhd-hero-v4__actions">
        <a class="bhd-hero-v4__button bhd-hero-v4__primary" href="{{ hero_product_url }}">
          Shop Best Hydrate <span aria-hidden="true">→</span>
        </a>
        <a class="bhd-hero-v4__button bhd-hero-v4__secondary" href="/pages/low-sugar-hydration-glucose-sglt1">
          <strong>Why low sugar?</strong>
          <small>See the SGLT science →</small>
        </a>
      </div>

      <div class="bhd-hero-v4__proof" aria-label="Best Hydrate product highlights">
        <a class="bhd-hero-v4__proof-card bhd-hero-v4__proof-card--green" href="/pages/low-sugar-hydration-glucose-sglt1" aria-label="Learn why Best Hydrate uses low sugar">
          <span class="bhd-hero-v4__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 4C12 4 6 8.5 6 15c0 2.8 2.2 5 5 5 6.5 0 9-8 9-16Z"/><path d="M5 21c2-6 6-9 11-12"/></svg>
          </span>
          <span><b>1 g sugar /</b><br>100 mL prepared</span>
        </a>
        <a class="bhd-hero-v4__proof-card bhd-hero-v4__proof-card--blue" href="/pages/five-essential-electrolytes" aria-label="Learn about Best Hydrate's five electrolyte species">
          <span class="bhd-hero-v4__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3S6 10 6 15a6 6 0 1 0 12 0c0-5-6-12-6-12Z"/></svg>
          </span>
          <span><b>5 electrolyte</b><br>species</span>
        </a>
        <a class="bhd-hero-v4__proof-card bhd-hero-v4__proof-card--purple" href="{{ hero_product_url }}" aria-label="Shop Best Hydrate 32 serving jar">
          <span class="bhd-hero-v4__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 5h10l-1 15H8L7 5Z"/><path d="M6 5h12M9 2h6v3"/></svg>
          </span>
          <span><b>32 servings</b></span>
        </a>
        <a class="bhd-hero-v4__proof-card bhd-hero-v4__proof-card--orange" href="{{ hero_product_url }}" aria-label="Shop Best Hydrate with Free and Fast Delivery">
          <span class="bhd-hero-v4__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 6h11v10H3V6Zm11 4h4l3 3v3h-7v-6Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
          </span>
          <span><b>Free &amp; Fast</b><br>Delivery</span>
        </a>
      </div>

      <div class="bhd-hero-v4__cycle" aria-label="Athlete hydration cycle">
        <a class="bhd-hero-v4__cycle-pill bhd-hero-v4__cycle-pill--prep" href="/pages/prep" aria-label="Learn about prep hydration">
          <span class="bhd-hero-v4__cycle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5h8M9 3v4M15 3v4M4 9h16v10H4V9Z"/><path d="m8 14 2 2 5-5"/></svg>
          </span>
          <span>PREP</span>
        </a>
        <a class="bhd-hero-v4__cycle-pill bhd-hero-v4__cycle-pill--perform" href="/pages/perform" aria-label="Learn about performance hydration">
          <span class="bhd-hero-v4__cycle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 20v-5h3v5H4Zm6 0V9h3v11h-3Zm6 0V4h3v16h-3Z"/></svg>
          </span>
          <span>PERFORM</span>
        </a>
        <a class="bhd-hero-v4__cycle-pill bhd-hero-v4__cycle-pill--recover" href="/pages/recover" aria-label="Learn about recovery hydration">
          <span class="bhd-hero-v4__cycle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2 5.3"/><path d="M20 5v6h-6"/></svg>
          </span>
          <span>RECOVER</span>
        </a>
      </div>
    </div>

    <div class="bhd-hero-v4__visual">
      <img
        class="bhd-hero-v4__scene"
        src="{{ hero_scene_url }}"
        srcset="{{ hero_scene_url }}&width=384 384w,
                {{ hero_scene_url }}&width=576 576w,
                {{ hero_scene_url }}&width=768 768w,
                {{ hero_scene_url }}&width=960 960w,
                {{ hero_scene_url }}&width=1200 1200w,
                {{ hero_scene_url }}&width=1536 1536w"
        sizes="(max-width: 749px) 100vw, (max-width: 1680px) 51vw, 857px"
        alt="Athlete mixing hydration beside a mountain lake"
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async">

    </div>
  </div>
</section>

<style>
  #BhdHeroV4-{{ section.id }}{
    --bhd-navy:#0d1d53;
    --bhd-blue:#1475ef;
    --bhd-muted:#52657f;
    --bhd-line:#d9e6f5;
    width:100%;
    overflow:hidden;
    background:#fff;
    box-sizing:border-box;
    padding:0;
  }
  #BhdHeroV4-{{ section.id }} *{box-sizing:border-box}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__shell{
    position:relative;
    width:min(1680px,100%);
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,49%) minmax(0,51%);
    min-height:620px;
    overflow:hidden;
    background:#fff;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__copy{
    position:relative;
    z-index:5;
    min-width:0;
    padding:clamp(32px,3.4vw,58px) clamp(26px,2.7vw,46px);
    display:flex;
    flex-direction:column;
    justify-content:center;
    background:linear-gradient(90deg,#fff 0%,#fff 88%,rgba(255,255,255,.94) 94%,rgba(255,255,255,0) 100%);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__eyebrow{
    margin:0 0 .8rem;
    color:#0b63d1;
    font-size:clamp(.9rem,.98vw,1.08rem);
    font-weight:950;
    letter-spacing:.135em;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{
    max-width:760px;
    margin:0;
    color:var(--bhd-navy);
    font-size:clamp(2.2rem,2.75vw,3.75rem);
    line-height:.98;
    letter-spacing:-.047em;
    font-weight:900;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title span{display:block}
  @media screen and (min-width:1200px){
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title span{white-space:nowrap}
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title em{color:var(--bhd-blue);font-style:normal}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{
    margin:1rem 0 .65rem;
    color:var(--bhd-navy);
    font-size:clamp(1.18rem,1.48vw,1.7rem);
    line-height:1.18;
    font-weight:850;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{
    max-width:760px;
    margin:0;
    color:#344b69;
    font-size:clamp(1.03rem,1.12vw,1.24rem);
    line-height:1.48;
    font-weight:560;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions{
    width:min(100%,760px);
    display:grid;
    grid-template-columns:minmax(0,1.12fr) minmax(0,.94fr);
    gap:.8rem;
    margin-top:1.35rem;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__button{
    min-height:4.65rem;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:999px;
    padding:.8rem 1.35rem;
    text-decoration:none;
    font-size:1.2rem;
    font-weight:900;
    line-height:1.05;
    transition:transform .16s ease,box-shadow .16s ease;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__button:hover{transform:translateY(-1px)}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__primary{
    gap:.4rem;
    color:#fff;
    background:linear-gradient(135deg,#1684ff,#1269df);
    box-shadow:0 .55rem 1.2rem rgba(20,117,239,.18);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary{
    flex-direction:column;
    border:2px solid var(--bhd-navy);
    color:var(--bhd-navy);
    background:rgba(255,255,255,.92);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary strong{font-size:1.02em}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary small{
    margin-top:.22rem;
    color:var(--bhd-blue);
    font-size:.8rem;
    font-weight:900;
  }

  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof{
    width:min(100%,760px);
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:.65rem;
    margin-top:1rem;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card{
    min-width:0;
    min-height:4.4rem;
    display:flex;
    align-items:center;
    gap:.65rem;
    padding:.65rem .72rem;
    border:1px solid rgba(13,29,83,.08);
    border-radius:1.2rem;
    background:rgba(255,255,255,.93);
    box-shadow:0 .3rem .85rem rgba(19,57,108,.08);
    color:var(--bhd-navy);
    font-size:.84rem;
    line-height:1.18;
    font-weight:650;
    text-decoration:none;
    cursor:pointer;
    transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card:hover,
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card:focus-visible{
    transform:translateY(-2px);
    box-shadow:0 .55rem 1.15rem rgba(19,57,108,.14);
    border-color:rgba(20,117,239,.28);
    outline:none;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card b{font-weight:900}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon{
    flex:0 0 2.1rem;
    width:2.1rem;
    height:2.1rem;
    display:grid;
    place-items:center;
    border-radius:50%;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon svg{
    width:1.35rem;height:1.35rem;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card--green .bhd-hero-v4__icon{color:#14936c;background:#e4f7ef}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card--blue .bhd-hero-v4__icon{color:#187be8;background:#e3f2ff}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card--purple .bhd-hero-v4__icon{color:#8b4fe7;background:#f0e8ff}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card--orange .bhd-hero-v4__icon{color:#ee7b22;background:#fff0e5}

  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{
    width:min(100%,650px);
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:.8rem;
    margin-top:.85rem;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill{
    min-height:3.5rem;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:.6rem;
    padding:.55rem .9rem;
    border-radius:999px;
    font-size:.92rem;
    font-weight:950;
    letter-spacing:.02em;
    text-decoration:none;
    cursor:pointer;
    transition:transform .16s ease,box-shadow .16s ease,filter .16s ease;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill:hover,
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill:focus-visible{
    transform:translateY(-2px);
    box-shadow:0 .45rem .95rem rgba(19,57,108,.11);
    filter:saturate(1.08);
    outline:none;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-icon{display:grid;place-items:center}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-icon svg{
    width:1.55rem;height:1.55rem;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill--prep{color:#0e8f70;background:linear-gradient(90deg,#e5f7f0,#dff5eb)}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill--perform{color:#1875df;background:linear-gradient(90deg,#e8f2ff,#dfedff)}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill--recover{color:#df3f53;background:linear-gradient(90deg,#fdecef,#f9dfe5)}

  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual{
    position:relative;
    min-width:0;
    min-height:620px;
    overflow:hidden;
    background:#d8ecfb;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__scene{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:center center;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual::before{
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    z-index:1;
    width:4%;
    pointer-events:none;
    background:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.35) 42%,rgba(255,255,255,0));
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline{
    position:absolute;
    z-index:3;
    top:6%;
    left:6%;
    width:59%;
    color:#0754aa;
    text-align:center;
    text-shadow:0 1px 7px rgba(255,255,255,.72);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span,
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong{
    display:block;
    font-style:italic;
    line-height:.96;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span{font-size:clamp(2rem,3vw,3.7rem);font-weight:500}
