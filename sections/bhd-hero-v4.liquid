  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong::after{
    content:"";
    display:block;
    width:52%;
    height:.22rem;
    margin:.32rem auto 0;
    border-radius:999px;
    background:#1475ef;
    transform:rotate(-3deg);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline small{
    display:block;
    margin-top:.55rem;
    font-size:clamp(.68rem,.76vw,.86rem);
    font-style:normal;
    font-weight:850;
    letter-spacing:.2em;
    text-transform:uppercase;
  }

  @media screen and (max-width:1399px) and (min-width:1200px){
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__shell{grid-template-columns:minmax(0,50%) minmax(0,50%)}
