{% assign hero_product_url = '/products/lemonade-best-hydrate' %}
{% assign hero_scene_url = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/bhd-customer-performance-hero-20260921.png?v=1790010487' %}
{% assign hero_product_image_url = 'https://cdn.shopify.com/s/files/1/0741/2170/7804/files/best-hydrate-lemonade-clean-20260910.png?v=1789057777' %}

<section id="BhdHeroV4-{{ section.id }}" class="bhd-hero-v4" data-bhd-hero-v4>
  <div class="bhd-hero-v4__shell">
    <div class="bhd-hero-v4__copy">
      <p class="bhd-hero-v4__eyebrow">LOW-SUGAR PERFORMANCE HYDRATION</p>

      <h1 class="bhd-hero-v4__title">
        <span>Your best performance deserves</span>
        <span><em>low sugar,</em> not sugar</span>
        <span>extremes.</span>
      </h1>

      <p class="bhd-hero-v4__middle">Not zero. Not overloaded. The hydration middle.</p>

      <p class="bhd-hero-v4__body">
        <span class="bhd-hero-v4__body-line">Zero sugar leaves helpful glucose out. Traditional sports drinks bring a heavy sugar load.</span>
        <span class="bhd-hero-v4__body-line">Best Hydrate hits the hydration sweet spot with purposeful glucose, five electrolyte species,</span>
        <span class="bhd-hero-v4__body-line">and just 1 g sugar per 100 mL prepared.</span>
      </p>

      <div class="bhd-hero-v4__actions">
        <a class="button button--primary bhd-hero-v4__primary" href="{{ hero_product_url }}">Shop Best Hydrate <span aria-hidden="true">→</span></a>
        <a class="button button--secondary bhd-hero-v4__secondary" href="/pages/low-sugar-hydration-glucose-sglt1">
          <span>Why low sugar?</span>
          <small>See the SGLT science →</small>
        </a>
      </div>

      <div class="bhd-hero-v4__proof" aria-label="Best Hydrate product highlights">
        <span>1 g sugar / 100 mL prepared</span>
        <span>5 electrolyte species</span>
        <span>32 servings</span>
        <span>Free &amp; Fast Delivery</span>
      </div>

      <div class="bhd-hero-v4__cycle" aria-label="Athlete hydration cycle">
        <span>PREP</span>
        <span>PERFORM</span>
        <span>RECOVER</span>
      </div>
    </div>

    <div class="bhd-hero-v4__visual">
      <img
        class="bhd-hero-v4__scene"
        src="{{ hero_scene_url }}"
        alt="Athlete mixing hydration beside a mountain lake"
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async">

      <div class="bhd-hero-v4__tagline" aria-label="Hydrate For YOUR Best Day">
        <span>Hydrate For</span>
        <strong>YOUR Best Day!</strong>
        <small>Purposeful hydration. Real results.</small>
      </div>

      <a class="bhd-hero-v4__product" href="{{ hero_product_url }}" aria-label="Shop Best Hydrate Lemonade">
        <img
          src="{{ hero_product_image_url }}&width=520"
          srcset="{{ hero_product_image_url }}&width=260 260w, {{ hero_product_image_url }}&width=390 390w, {{ hero_product_image_url }}&width=520 520w"
          sizes="(max-width: 749px) 22vw, (max-width: 1199px) 18vw, 14vw"
          alt="Best Hydrate Lemonade electrolyte powder jar"
          width="520"
          height="520"
          loading="eager"
          decoding="async">
      </a>
    </div>
  </div>
</section>

<style>
  #BhdHeroV4-{{ section.id }}{
    --bhd-navy:#0c1f4e;
    --bhd-blue:#1873e8;
    --bhd-muted:#425268;
    --bhd-line:#dce7f2;
    width:100%;
    overflow:hidden;
    background:#eef6fb;
    box-sizing:border-box;
    padding:clamp(12px,1.8vw,28px);
  }
  #BhdHeroV4-{{ section.id }} *{box-sizing:border-box}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__shell{
    width:min(1600px,100%);
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,48%) minmax(0,52%);
    min-height:520px;
    overflow:hidden;
    border-radius:18px;
    background:linear-gradient(135deg,#fff 0%,#f8fbff 52%,#edf6fc 100%);
    box-shadow:0 .65rem 1.8rem rgba(7,43,104,.09);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__copy{
    min-width:0;
    padding:clamp(26px,3vw,48px) clamp(22px,2.8vw,46px);
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__eyebrow{
    margin:0 0 .75rem;
    color:var(--bhd-blue);
    font-size:clamp(.78rem,.88vw,.98rem);
    font-weight:850;
    letter-spacing:.12em;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{
    margin:0;
    color:var(--bhd-navy);
    font-size:clamp(2.7rem,3.6vw,4.65rem);
    line-height:.98;
    letter-spacing:-.045em;
    font-weight:900;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title span{display:block;white-space:nowrap}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title em{
    color:var(--bhd-blue);
    font-style:normal;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{
    margin:1rem 0 .7rem;
    color:var(--bhd-navy);
    font-size:clamp(1.16rem,1.45vw,1.65rem);
    line-height:1.2;
    font-weight:850;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{
    margin:0;
    color:var(--bhd-muted);
    font-size:clamp(.98rem,1.08vw,1.2rem);
    line-height:1.45;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body-line{display:block}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions{
    display:flex;
    align-items:stretch;
    gap:.8rem;
    flex-wrap:wrap;
    margin-top:1.35rem;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions .button{
    min-height:4.8rem;
    padding:.8rem 1.7rem;
    border-radius:999px;
    font-size:1.12rem;
    font-weight:850;
    line-height:1.05;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__primary{
    min-width:17rem;
    background:var(--bhd-blue);
    color:#fff;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary{
    min-width:17rem;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    border:1.5px solid var(--bhd-navy);
    background:#fff;
    color:var(--bhd-navy);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary small{
    margin-top:.22rem;
    color:var(--bhd-blue);
    font-size:.72rem;
    font-weight:800;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof,
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{
    display:flex;
    gap:.55rem;
    flex-wrap:wrap;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof{margin-top:1rem}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof span{
    padding:.58rem .78rem;
    border:1px solid var(--bhd-line);
    border-radius:999px;
    background:#fff;
    color:#50647a;
    font-size:.78rem;
    font-weight:750;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{margin-top:.8rem}
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle span{
    min-width:7.5rem;
    padding:.65rem .95rem;
    border:1px solid #d7e5fb;
    border-radius:999px;
    background:#edf5ff;
    color:var(--bhd-navy);
    text-align:center;
    font-size:.82rem;
    font-weight:850;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual{
    position:relative;
    min-width:0;
    min-height:520px;
    overflow:hidden;
    background:#dcecf5;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__scene{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:62% center;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual::before{
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    z-index:1;
    width:16%;
    background:linear-gradient(90deg,rgba(248,252,255,.38),rgba(248,252,255,0));
    pointer-events:none;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline{
    position:absolute;
    z-index:3;
    top:7%;
    left:8%;
    width:min(60%,34rem);
    color:#0754aa;
    text-align:center;
    text-shadow:0 1px 8px rgba(255,255,255,.75);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span,
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong{
    display:block;
    font-style:italic;
    line-height:1;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span{
    font-size:clamp(2rem,3.2vw,3.8rem);
    font-weight:500;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong{
    margin-top:.15rem;
    font-size:clamp(2.5rem,3.8vw,4.6rem);
    font-weight:800;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline small{
    display:block;
    margin-top:.7rem;
    font-size:clamp(.72rem,.82vw,.92rem);
    font-style:normal;
    font-weight:850;
    letter-spacing:.2em;
    text-transform:uppercase;
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__product{
    position:absolute;
    z-index:4;
    right:3.5%;
    bottom:3%;
    width:min(27%,17rem);
    aspect-ratio:1;
    display:block;
    filter:drop-shadow(0 16px 22px rgba(7,43,104,.24));
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__product::before{
    content:"";
    position:absolute;
    left:8%;
    right:8%;
    bottom:3%;
    height:7%;
    z-index:-1;
    border-radius:50%;
    background:rgba(7,43,104,.22);
    filter:blur(10px);
  }
  #BhdHeroV4-{{ section.id }} .bhd-hero-v4__product img{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
  }

  @media screen and (max-width:1199px) and (min-width:750px){
    #BhdHeroV4-{{ section.id }}{padding:14px}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__shell{
      grid-template-columns:minmax(0,49%) minmax(0,51%);
      min-height:470px;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__copy{
      padding:24px 22px 22px;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__eyebrow{
      margin-bottom:.55rem;
      font-size:.72rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{
      font-size:clamp(2.1rem,3.45vw,2.95rem);
      letter-spacing:-.04em;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{
      margin:.75rem 0 .55rem;
      font-size:clamp(.98rem,1.35vw,1.18rem);
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{
      font-size:clamp(.78rem,1.08vw,.92rem);
      line-height:1.42;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions{
      gap:.55rem;
      margin-top:1rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions .button{
      min-height:3.8rem;
      padding:.65rem 1.05rem;
      font-size:.9rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__primary,
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary{
      min-width:12.7rem;
      flex:1 1 12.7rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary small{font-size:.58rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof{margin-top:.7rem;gap:.38rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof span{
      padding:.42rem .55rem;
      font-size:.61rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{margin-top:.55rem;gap:.4rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle span{
      min-width:5.6rem;
      padding:.48rem .65rem;
      font-size:.66rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual{min-height:470px}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__scene{object-position:66% center}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline{
      top:6%;
      left:5%;
      width:58%;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span{font-size:clamp(1.6rem,3.1vw,2.6rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong{font-size:clamp(2rem,3.6vw,3.1rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline small{font-size:.58rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__product{width:min(28%,10rem)}
  }

  @media screen and (max-width:749px){
    #BhdHeroV4-{{ section.id }}{padding:0;background:#fff}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__shell{
      display:flex;
      flex-direction:column;
      min-height:0;
      border-radius:0;
      box-shadow:none;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual{
      order:1;
      min-height:0;
      height:clamp(320px,92vw,390px);
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__scene{object-position:68% center}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual::before{display:none}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline{
      top:7%;
      left:5%;
      width:48%;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline span{font-size:clamp(1.45rem,7vw,2rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline strong{font-size:clamp(1.85rem,8.2vw,2.6rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline small{
      margin-top:.45rem;
      font-size:.48rem;
      letter-spacing:.13em;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__product{
      right:2.5%;
      bottom:2%;
      width:min(24%,6rem);
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__copy{
      order:2;
      padding:24px 18px 26px;
      text-align:center;
      align-items:center;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__eyebrow{
      margin-bottom:.65rem;
      font-size:.66rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{
      width:100%;
      font-size:clamp(1.75rem,8vw,2.35rem);
      line-height:1;
      letter-spacing:-.038em;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title span{white-space:nowrap}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{
      margin:.75rem 0 .6rem;
      font-size:.98rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{
      max-width:35rem;
      font-size:.82rem;
      line-height:1.45;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body-line{display:inline}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body-line:not(:last-child)::after{content:" "}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions{
      width:100%;
      display:grid;
      grid-template-columns:1fr;
      gap:.6rem;
      margin-top:1.1rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__actions .button{
      width:100%;
      min-width:0;
      min-height:4.4rem;
      font-size:1rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__secondary small{font-size:.64rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof,
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{
      justify-content:center;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof{margin-top:.9rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof span{
      padding:.52rem .62rem;
      font-size:.66rem;
    }
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{margin-top:.7rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle span{
      min-width:6.2rem;
      flex:1 1 6.2rem;
      max-width:9rem;
      font-size:.72rem;
    }
  }

  @media screen and (max-width:390px){
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{font-size:clamp(1.62rem,7.3vw,2rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__tagline{width:51%}
  }
</style>

{% schema %}
{
  "name": "Best Hydrate responsive hero",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Best Hydrate responsive hero"
    }
  ]
}
{% endschema %}