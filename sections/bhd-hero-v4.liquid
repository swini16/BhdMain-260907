    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon{flex-basis:1.85rem;width:1.85rem;height:1.85rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon svg{width:1.1rem;height:1.1rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle{width:100%;gap:.5rem;margin-top:.7rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-pill{min-height:3rem;padding:.45rem .6rem;font-size:.82rem;gap:.4rem;font-weight:950}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__cycle-icon svg{width:1.2rem;height:1.2rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__visual{min-height:470px}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__scene{object-position:center center}
  }

