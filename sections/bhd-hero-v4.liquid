    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__title{font-size:clamp(2.3rem,2.85vw,2.72rem)}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__middle{font-size:1.12rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__body{font-size:1rem;font-weight:560;line-height:1.48}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__proof-card{font-size:.75rem;gap:.4rem;padding:.55rem;font-weight:650}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon{flex-basis:1.7rem;width:1.7rem;height:1.7rem}
    #BhdHeroV4-{{ section.id }} .bhd-hero-v4__icon svg{width:1.05rem;height:1.05rem}
  }

  @media screen and (max-width:1199px) and (min-width:900px){
