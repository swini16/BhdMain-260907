<section id="BhdSurfaceContext-{{ section.id }}" class="bhd-surface-context bhd-surface-context--{{ request.page_type }}">
  <div class="page-width">
    {% case request.page_type %}
      {% when 'article' %}
        <nav class="bhd-surface-context__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><a href="{{ blog.url }}">News &amp; Insights</a><span aria-hidden="true">›</span><span aria-current="page">{{ article.title }}</span></nav>
        <div class="bhd-surface-context__strip">
          <div><strong>Best Hydrate News &amp; Insights</strong><span>Articles are dated records. For current product composition and scientific positioning, use the canonical Science and Product pages.</span></div>
          <div class="bhd-surface-context__actions"><a href="/pages/hydration-science">Current Science</a><a href="/pages/product-details">Product Details</a></div>
        </div>

      {% when 'search' %}
        <nav class="bhd-surface-context__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">Search</span></nav>
        <div class="bhd-surface-context__strip">
          <div><strong>Search Best Hydrate</strong><span>Find science pages, hydration applications, company information, news and products across the site.</span></div>
          <div class="bhd-surface-context__actions"><a href="/pages/hydration-science">Browse Science</a><a href="/products/lemonade-best-hydrate">Shop</a></div>
        </div>

      {% when 'cart' %}
        <nav class="bhd-surface-context__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">Cart</span></nav>
        <div class="bhd-surface-context__strip">
          <div><strong>Before checkout</strong><span>Need preparation, formula or use-context details? They remain one click away without interrupting your cart.</span></div>
          <div class="bhd-surface-context__actions"><a href="/pages/directions">Directions</a><a href="/pages/our-formula">Our Formula</a></div>
        </div>

      {% when 'collection' %}
        <nav class="bhd-surface-context__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span>Shop</span><span aria-hidden="true">›</span><span aria-current="page">{{ collection.title }}</span></nav>
        <div class="bhd-surface-context__strip">
          <div><strong>Shop with the science beside you</strong><span>Compare products through current formula, directions and hydration-use context rather than marketing claims alone.</span></div>
          <div class="bhd-surface-context__actions"><a href="/pages/product-details">Product Details</a><a href="/pages/hydration-science">Hydration Science</a></div>
        </div>

      {% when 'list-collections' %}
        <nav class="bhd-surface-context__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">Shop</span></nav>
        <div class="bhd-surface-context__strip">
          <div><strong>Best Hydrate products</strong><span>Browse the current catalog, then use Product Details and Directions for the practical context behind each purchase.</span></div>
          <div class="bhd-surface-context__actions"><a href="/pages/product-details">Product Details</a><a href="/pages/directions">Directions</a></div>
        </div>

      {% when '404' %}
        <div class="bhd-surface-context__recovery">
          <p class="bhd-surface-context__eyebrow">Find the current route</p>
          <h2>The page moved, but the useful content probably did not.</h2>
          <p>Use the current Best Hydrate architecture instead of an old or mistyped link.</p>
          <div class="bhd-surface-context__recovery-grid">
            <a href="/pages/hydration-science"><strong>Science</strong><span>Hydration physiology, electrolytes, formula and research.</span></a>
            <a href="/pages/product-details"><strong>Solutions</strong><span>Product, performance, everyday, clinical and humanitarian contexts.</span></a>
            <a href="/pages/our-story"><strong>Connect</strong><span>Meet Us, partnerships, investors, news and contact.</span></a>
            <a href="/products/lemonade-best-hydrate"><strong>Shop</strong><span>Go directly to the current Best Hydrate product.</span></a>
          </div>
          <form action="{{ routes.search_url }}" method="get" role="search" class="bhd-surface-context__search"><label for="Bhd404Search-{{ section.id }}">Search Best Hydrate</label><div><input id="Bhd404Search-{{ section.id }}" type="search" name="q" placeholder="Science, directions, research..."><button type="submit">Search</button></div></form>
        </div>
    {% endcase %}
  </div>
</section>

<style>
  #BhdSurfaceContext-{{ section.id }}{padding:1.7rem 0 2.2rem;background:linear-gradient(180deg,#f8fcff,#fff);border-bottom:1px solid rgba(11,45,103,.08)}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-bottom:1.3rem;color:#68778b;font-size:1.2rem}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__crumbs a{color:#0b2d67;text-decoration:none}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__crumbs a:hover{text-decoration:underline}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__strip{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:center;padding:1.6rem 1.8rem;border:1px solid rgba(11,45,103,.1);border-radius:1.4rem;background:#fff}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__strip strong{display:block;margin-bottom:.35rem;color:#0b2d67;font-size:1.45rem}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__strip span{display:block;max-width:78rem;color:#5b6b82;font-size:1.28rem;line-height:1.45}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__actions{display:flex;gap:.7rem;flex-wrap:wrap;justify-content:flex-end}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__actions a{padding:.75rem 1.1rem;border:1px solid rgba(11,45,103,.15);border-radius:999px;color:#0b2d67;background:#f5fbff;font-size:1.2rem;font-weight:750;text-decoration:none}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery{max-width:105rem;margin:1rem auto 2rem;padding:clamp(2.4rem,5vw,5rem);border-radius:2rem;background:linear-gradient(135deg,#eef9ff,#fff);border:1px solid rgba(7,142,231,.14);text-align:center}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__eyebrow{margin:0 0 .7rem;color:#078ee7;font-size:1.2rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery h2{margin:0 auto 1rem;max-width:75rem;color:#0b2d67;font-size:clamp(2.8rem,4vw,4.5rem);line-height:1.05}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery>p:not(.bhd-surface-context__eyebrow){color:#5b6b82;font-size:1.5rem}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:2.4rem 0}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid a{padding:1.7rem;border:1px solid rgba(11,45,103,.1);border-radius:1.3rem;background:#fff;color:inherit;text-align:left;text-decoration:none}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid strong{display:block;color:#0b2d67;font-size:1.55rem}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid span{display:block;margin-top:.45rem;color:#64748a;font-size:1.2rem;line-height:1.4}
  #BhdSurfaceContext-{{ section.id }} .bhd-surface-context__search{max-width:62rem;margin:2.5rem auto 0;text-align:left}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__search label{display:block;margin-bottom:.55rem;color:#0b2d67;font-size:1.25rem;font-weight:750}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__search>div{display:grid;grid-template-columns:1fr auto;gap:.7rem}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__search input{min-width:0;padding:1rem 1.2rem;border:1px solid rgba(11,45,103,.2);border-radius:.9rem;font:inherit}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__search button{padding:1rem 1.5rem;border:0;border-radius:.9rem;background:#0b2d67;color:#fff;font-weight:750;cursor:pointer}
  @media(max-width:749px){#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__strip{grid-template-columns:1fr}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__actions{justify-content:flex-start}#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:480px){#BhdSurfaceContext-{{ section.id }} .bhd-surface-context__recovery-grid{grid-template-columns:1fr}}
</style>

{% schema %}
{"name":"Best Hydrate surface context","settings":[],"presets":[{"name":"Best Hydrate surface context"}]}
{% endschema %}
