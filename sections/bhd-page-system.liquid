  #BhdPage-{{ section.id }} .bhd-page__keypoints>div{padding:1.8rem 1.9rem;border:1px solid var(--bhd-line);border-radius:1.4rem;background:#fff}
  #BhdPage-{{ section.id }} .bhd-page__keypoints strong{display:block;margin-bottom:.5rem;color:var(--bhd-navy);font-size:1.65rem}
  #BhdPage-{{ section.id }} .bhd-page__keypoints span{display:block;color:var(--bhd-muted);font-size:1.38rem;line-height:1.42}
  #BhdPage-{{ section.id }} h2{margin:0 0 1.4rem;color:var(--bhd-navy);font-size:clamp(2.8rem,3.4vw,4.2rem);line-height:1.04;letter-spacing:-.025em}
  #BhdPage-{{ section.id }} h3{color:var(--bhd-navy)}
  #BhdPage-{{ section.id }} p,#BhdPage-{{ section.id }} li{font-size:1.6rem;line-height:1.6}
  #BhdPage-{{ section.id }} .bhd-page__prose-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:3rem;align-items:start;margin:0 0 5.5rem}
  #BhdPage-{{ section.id }} .bhd-page__prose{max-width:82rem}
  #BhdPage-{{ section.id }} .bhd-page__prose p{color:#465774}
  #BhdPage-{{ section.id }} .bhd-page__callout{padding:2.4rem;border-radius:1.8rem;background:linear-gradient(160deg,#0b2d67,#0f5092);color:#fff;box-shadow:0 1.5rem 4rem rgba(11,45,103,.16)}
  #BhdPage-{{ section.id }} .bhd-page__callout-label{font-size:1.15rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;opacity:.75}
  #BhdPage-{{ section.id }} .bhd-page__callout h3{margin:.7rem 0 1rem;color:#fff;font-size:2.25rem;line-height:1.12}
  #BhdPage-{{ section.id }} .bhd-page__callout p{margin:0;color:rgba(255,255,255,.87);font-size:1.42rem}
  #BhdPage-{{ section.id }} .bhd-page__split{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(3rem,5vw,6rem);align-items:center;margin:0 0 6rem;padding:2.2rem;border-radius:2.2rem;background:var(--bhd-pale)}
  #BhdPage-{{ section.id }} .bhd-page__split-media{overflow:hidden;border-radius:1.6rem;aspect-ratio:1.1/1}
  #BhdPage-{{ section.id }} .bhd-page__split-media img{display:block;width:100%;height:100%;object-fit:cover}
  #BhdPage-{{ section.id }} .bhd-page__split-copy{padding:1.5rem 2rem 1.5rem 0}
  #BhdPage-{{ section.id }} .bhd-page__split-copy ul{margin:1.5rem 0 1.7rem;padding-left:2rem;color:#465774}
  #BhdPage-{{ section.id }} .bhd-page__split-copy li+li{margin-top:.75rem}
  #BhdPage-{{ section.id }} .bhd-page__text-link{display:inline-flex;gap:.6rem;color:var(--bhd-blue);font-size:1.5rem;font-weight:800;text-decoration:none}
  #BhdPage-{{ section.id }} .bhd-page__feature{margin:0 0 6rem;padding:clamp(2.6rem,5vw,5rem);border-radius:2.2rem;background:linear-gradient(135deg,#f7fcff 0%,#e7f7fd 100%);border:1px solid rgba(7,142,231,.13)}
  #BhdPage-{{ section.id }} .bhd-page__feature>div{max-width:92rem;margin:0 auto;text-align:center}
  #BhdPage-{{ section.id }} .bhd-page__feature p{color:#465774}
  #BhdPage-{{ section.id }} .bhd-page__button{display:inline-flex;align-items:center;justify-content:center;margin-top:1.2rem;padding:1.15rem 1.8rem;border-radius:999px;background:var(--bhd-navy);color:#fff;font-size:1.42rem;font-weight:800;text-decoration:none}
  #BhdPage-{{ section.id }} .bhd-page__button--secondary{background:#fff;color:var(--bhd-navy);border:1px solid rgba(11,45,103,.18)}
  #BhdPage-{{ section.id }} .bhd-page__cards-section{margin:0 0 6rem}
  #BhdPage-{{ section.id }} .bhd-page__cards{display:grid;gap:1.35rem}
  #BhdPage-{{ section.id }} .bhd-page__cards--4{grid-template-columns:repeat(4,minmax(0,1fr))}
  #BhdPage-{{ section.id }} .bhd-page__cards article{padding:2rem;border:1px solid var(--bhd-line);border-radius:1.6rem;background:#fff}
  #BhdPage-{{ section.id }} .bhd-page__cards h3{margin:0 0 .7rem;font-size:1.85rem}
  #BhdPage-{{ section.id }} .bhd-page__cards p{margin:0 0 1rem;color:var(--bhd-muted);font-size:1.38rem;line-height:1.45}
  #BhdPage-{{ section.id }} .bhd-page__cards a{color:var(--bhd-blue);font-size:1.35rem;font-weight:800;text-decoration:none}
  #BhdPage-{{ section.id }} .bhd-page__brand-context{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3rem;align-items:center;margin:0 0 6rem;padding:clamp(2.5rem,4vw,4rem);border-radius:2rem;background:#0b2d67;color:#fff}
  #BhdPage-{{ section.id }} .bhd-page__brand-context h2{color:#fff}
  #BhdPage-{{ section.id }} .bhd-page__brand-context p{max-width:86rem;color:rgba(255,255,255,.83)}
  #BhdPage-{{ section.id }} .bhd-page__brand-context .bhd-page__kicker{color:#75d5ff}
  #BhdPage-{{ section.id }} .bhd-page__brand-actions{display:flex;flex-direction:column;min-width:20rem}
  #BhdPage-{{ section.id }} .bhd-page__brand-context .bhd-page__button{background:#fff;color:var(--bhd-navy)}
  #BhdPage-{{ section.id }} .bhd-page__brand-context .bhd-page__button--secondary{background:transparent;color:#fff;border-color:rgba(255,255,255,.35)}
  #BhdPage-{{ section.id }} .bhd-page__related{margin:0 0 5rem}
  #BhdPage-{{ section.id }} .bhd-page__related-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.3rem}
  #BhdPage-{{ section.id }} .bhd-page__related-grid a{display:block;padding:2rem;border:1px solid var(--bhd-line);border-radius:1.5rem;background:#fff;color:inherit;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease}
  #BhdPage-{{ section.id }} .bhd-page__related-grid a:hover{transform:translateY(-2px);box-shadow:0 1rem 2.5rem rgba(11,45,103,.08)}
  #BhdPage-{{ section.id }} .bhd-page__related-grid strong{display:block;margin-bottom:.55rem;color:var(--bhd-navy);font-size:1.6rem}
  #BhdPage-{{ section.id }} .bhd-page__related-grid span{display:block;color:var(--bhd-muted);font-size:1.3rem;line-height:1.42}
  #BhdPage-{{ section.id }} .bhd-page__references{padding-top:2.7rem;border-top:1px solid var(--bhd-line)}
