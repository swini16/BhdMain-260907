    #BhdPage-{{ section.id }} .bhd-page-hero__media{aspect-ratio:1.8/1}
    #BhdPage-{{ section.id }} .bhd-page__prose-grid{grid-template-columns:1fr}
    #BhdPage-{{ section.id }} .bhd-page__split{grid-template-columns:1fr}
    #BhdPage-{{ section.id }} .bhd-page__split-media{aspect-ratio:1.8/1}
    #BhdPage-{{ section.id }} .bhd-page__split-copy{padding:1rem}
    #BhdPage-{{ section.id }} .bhd-page__cards--4,#BhdPage-{{ section.id }} .bhd-page__related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    #BhdPage-{{ section.id }} .bhd-page__brand-context{grid-template-columns:1fr}
    #BhdPage-{{ section.id }} .bhd-page__brand-actions{flex-direction:row;flex-wrap:wrap;min-width:0}
  }
  @media screen and (max-width:749px){
    #BhdPage-{{ section.id }}{padding-top:1.4rem;padding-bottom:4.5rem}
    #BhdPage-{{ section.id }} .bhd-breadcrumbs{margin-bottom:1.3rem;font-size:1.15rem}
    #BhdPage-{{ section.id }} .bhd-page-hero{padding:1.5rem;border-radius:1.7rem;margin-bottom:2rem}
    #BhdPage-{{ section.id }} h1{font-size:4rem}
    #BhdPage-{{ section.id }} .bhd-page-hero__lede{font-size:1.55rem}
    #BhdPage-{{ section.id }} .bhd-page-hero__media{aspect-ratio:1.45/1;border-radius:1.3rem}
    #BhdPage-{{ section.id }} .bhd-page__keypoints{grid-template-columns:1fr;margin-bottom:4rem}
    #BhdPage-{{ section.id }} .bhd-page__prose-grid,#BhdPage-{{ section.id }} .bhd-page__split,#BhdPage-{{ section.id }} .bhd-page__feature,#BhdPage-{{ section.id }} .bhd-page__cards-section,#BhdPage-{{ section.id }} .bhd-page__brand-context{margin-bottom:4.5rem}
    #BhdPage-{{ section.id }} .bhd-page__split{padding:1.2rem}
    #BhdPage-{{ section.id }} .bhd-page__split-media{aspect-ratio:1.4/1}
    #BhdPage-{{ section.id }} .bhd-page__cards--4,#BhdPage-{{ section.id }} .bhd-page__related-grid{grid-template-columns:1fr}
    #BhdPage-{{ section.id }} .bhd-page__brand-context{padding:2rem}
    #BhdPage-{{ section.id }} .bhd-page__brand-actions{flex-direction:column}
  }
</style>

