{% liquid
  assign bhd_supported = false
  assign bhd_family = ''
  assign bhd_family_url = ''
  assign bhd_parent = ''
  assign bhd_parent_url = ''
  assign bhd_eyebrow = ''
  assign bhd_title = page.title
  assign bhd_intro = ''
  assign bhd_hero_image = ''
  assign bhd_hero_alt = ''

  case page.handle
    when 'hydration-science'
      assign bhd_supported = true
      assign bhd_family = 'Science'
      assign bhd_family_url = '/pages/hydration-science'
      assign bhd_parent = ''
      assign bhd_parent_url = ''
      assign bhd_eyebrow = 'Hydration Science'
      assign bhd_title = 'Hydration Science'
      assign bhd_intro = 'Hydration is more than drinking water. It is the coordinated movement and retention of water and dissolved electrolytes across the body, shaped by intake, losses, activity, temperature, diet and physiology.'
      assign bhd_hero_image = 'https://images.pexels.com/photos/9628840/pexels-photo-9628840.jpeg?auto=compress&cs=tinysrgb&w=1800'
      assign bhd_hero_alt = 'Laboratory glassware used in scientific research'
  endcase
%}

{% if bhd_supported %}
  <section id="BhdPage-{{ section.id }}" class="bhd-page bhd-page--{{ page.handle }}">
    <div class="bhd-page__inner page-width">
      <nav class="bhd-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        {% if bhd_family != blank and bhd_family_url != blank and bhd_family_url != page.url %}
          <a href="{{ bhd_family_url }}">{{ bhd_family }}</a>
          <span aria-hidden="true">›</span>
        {% elsif bhd_family != blank %}
          <span>{{ bhd_family }}</span>
          <span aria-hidden="true">›</span>
        {% endif %}
        {% if bhd_parent != blank and bhd_parent_url != blank %}
          <a href="{{ bhd_parent_url }}">{{ bhd_parent }}</a>
          <span aria-hidden="true">›</span>
        {% endif %}
        <span aria-current="page">{{ bhd_title }}</span>
      </nav>

      <header class="bhd-page-hero">
        <div class="bhd-page-hero__copy">
          {% if bhd_eyebrow != blank %}<p class="bhd-page__eyebrow">{{ bhd_eyebrow }}</p>{% endif %}
          <h1>{{ bhd_title }}</h1>
          <p class="bhd-page-hero__lede">{{ bhd_intro }}</p>
        </div>
        {% if bhd_hero_image != blank %}
          <div class="bhd-page-hero__media">
            <img src="{{ bhd_hero_image }}" alt="{{ bhd_hero_alt | escape }}" width="1800" height="1200" loading="eager" fetchpriority="high" decoding="async">
          </div>
        {% endif %}
      </header>

      {% case page.handle %}
        {% when 'hydration-science' %}
          <div class="bhd-page__keypoints" aria-label="Hydration science at a glance">
            <div><strong>Fluid balance</strong><span>Hydration reflects both water intake and the body’s ongoing regulation of water losses and distribution.</span></div>
            <div><strong>Electrolytes</strong><span>Sodium, potassium, chloride and bicarbonate help maintain electrical, osmotic and acid-base functions.</span></div>
            <div><strong>Absorption</strong><span>The small intestine moves water alongside absorbed solutes, including sodium and glucose.</span></div>
          </div>

          <div class="bhd-page__prose-grid">
            <article class="bhd-page__prose">
              <p class="bhd-page__kicker">Start with the basics</p>
              <h2>What hydration actually means</h2>
              <p>Water is distributed throughout the body rather than stored in one simple reservoir. Some is inside cells, while the rest is outside cells in blood plasma and the spaces around tissues. The body continuously adjusts this balance through thirst, kidney function, hormones, food and drink intake, and water lost through urine, breathing, skin and the gastrointestinal tract.</p>
              <p>That is why hydration is better understood as a <strong>dynamic balance</strong> than as a target number of glasses. A person’s needs can change with body size, climate, activity, illness, food intake, medications and individual physiology.</p>
            </article>
            <aside class="bhd-page__callout">
              <span class="bhd-page__callout-label">Practical idea</span>
              <h3>Water is essential, but context determines what else matters.</h3>
              <p>For many ordinary situations, water and normal meals are enough. When fluid and electrolyte losses are greater, replacing both water and relevant solutes can become more important.</p>
            </aside>
          </div>

          <section class="bhd-page__split">
            <div class="bhd-page__split-media">
              <img src="https://images.pexels.com/photos/8910768/pexels-photo-8910768.jpeg?auto=compress&cs=tinysrgb&w=1400" alt="Runner drinking during an endurance event" width="1400" height="950" loading="lazy" decoding="async">
            </div>
            <div class="bhd-page__split-copy">
              <p class="bhd-page__kicker">Electrolytes</p>
              <h2>Why dissolved minerals matter</h2>
              <p>Body water contains charged particles called electrolytes. Their distribution helps the body maintain fluid balance, electrical signalling and normal cellular function.</p>
              <ul>
                <li><strong>Sodium</strong> is the major cation in extracellular fluid and is closely tied to extracellular fluid volume.</li>
                <li><strong>Potassium</strong> is the major cation inside cells and is important to normal nerve and muscle function.</li>
                <li><strong>Chloride</strong> is a major extracellular anion and commonly accompanies sodium.</li>
                <li><strong>Bicarbonate</strong> is part of the body’s acid-base buffering system.</li>
              </ul>
              <a class="bhd-page__text-link" href="/pages/electrolytes">Explore electrolytes <span aria-hidden="true">→</span></a>
            </div>
          </section>

          <section class="bhd-page__feature">
            <div>
              <p class="bhd-page__kicker">Intestinal absorption</p>
              <h2>Why glucose appears in oral hydration science</h2>
              <p>One of the foundations of oral rehydration science is that glucose and sodium transport are coupled in the small intestine. The sodium-glucose cotransporter SGLT1 moves glucose and sodium from the intestinal lumen into absorptive cells, helping create conditions that favour water absorption.</p>
              <p>This mechanism is central to the success of glucose-electrolyte oral rehydration solutions used in medicine. It does <strong>not</strong> mean that more sugar is always better. Formulation, concentration, osmolality, the reason for drinking, and the person using the solution all matter.</p>
              <a class="bhd-page__button" href="/pages/glucose-water-absorption">How glucose &amp; water absorption works</a>
            </div>
          </section>

          <section class="bhd-page__cards-section">
            <p class="bhd-page__kicker">Hydration in context</p>
            <h2>Needs change with the situation</h2>
            <div class="bhd-page__cards bhd-page__cards--4">
              <article><h3>Everyday life</h3><p>Normal meals and fluids provide most people with water and electrolytes across an ordinary day.</p><a href="/pages/everyday-wellness">Everyday wellness</a></article>
              <article><h3>Exercise &amp; heat</h3><p>Sweat increases fluid and sodium losses, with large differences between people and environments.</p><a href="/pages/performance-hydration">Performance hydration</a></article>
              <article><h3>Illness &amp; recovery</h3><p>Vomiting, diarrhoea, fever and reduced intake can change hydration needs and may require medical guidance.</p><a href="/pages/clinical-hydration">Clinical hydration</a></article>
              <article><h3>Age &amp; circumstance</h3><p>Older age, travel, access to fluids and some health conditions can change both risk and practical hydration strategy.</p><a href="/pages/active-aging">Active aging</a></article>
            </div>
          </section>

          <section class="bhd-page__brand-context">
            <div>
              <p class="bhd-page__kicker">Our approach</p>
              <h2>Science translated into a practical formula</h2>
              <p>Best Hydrate uses established oral hydration principles as a starting point: water is consumed alongside sodium, potassium, chloride, bicarbonate and glucose. The product is designed as a practical electrolyte powder for real-world hydration, while our research program continues to examine performance, clinical and humanitarian applications.</p>
              <p>Best Hydrate is not presented as a substitute for individualized medical care or for WHO oral rehydration salts used to treat dehydration from acute diarrhoeal disease.</p>
            </div>
            <div class="bhd-page__brand-actions">
              <a class="bhd-page__button" href="/pages/our-formula">Explore our formula</a>
              <a class="bhd-page__button bhd-page__button--secondary" href="/products/lemonade-best-hydrate">Shop Best Hydrate</a>
            </div>
          </section>

          <section class="bhd-page__related" aria-labelledby="RelatedPages-{{ section.id }}">
            <p class="bhd-page__kicker">Continue learning</p>
            <h2 id="RelatedPages-{{ section.id }}">Related science</h2>
            <div class="bhd-page__related-grid">
              <a href="/pages/how-hydration-works"><strong>How Hydration Works</strong><span>Follow water from intake through absorption, circulation, regulation and loss.</span></a>
              <a href="/pages/electrolytes"><strong>Electrolytes</strong><span>Understand the major ions involved in fluid, nerve, muscle and acid-base physiology.</span></a>
              <a href="/pages/glucose-water-absorption"><strong>Glucose &amp; Water Absorption</strong><span>See why sodium-glucose cotransport matters to oral rehydration science.</span></a>
              <a href="/pages/our-formula"><strong>Our Formula</strong><span>Connect the science to the ingredients used in Best Hydrate.</span></a>
            </div>
          </section>

          <section class="bhd-page__references" aria-labelledby="References-{{ section.id }}">
            <h2 id="References-{{ section.id }}">Selected references &amp; further reading</h2>
            <ol>
              <li><a href="https://www.who.int/publications/i/item/WHO-FCH-CAH-06.1" target="_blank" rel="noopener">World Health Organization &amp; UNICEF. Oral Rehydration Salts: Production of the New ORS.</a></li>
              <li><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3950600/" target="_blank" rel="noopener">Binder HJ, Brown I, Ramakrishna BS, Young GP. Oral Rehydration Therapy in the Second Decade of the Twenty-first Century.</a></li>
              <li><a href="https://pubmed.ncbi.nlm.nih.gov/9694418/" target="_blank" rel="noopener">Leiper JB. Intestinal water absorption: implications for the formulation of rehydration solutions.</a></li>
              <li><a href="https://pubmed.ncbi.nlm.nih.gov/9303999/" target="_blank" rel="noopener">American College of Sports Medicine. Exercise and fluid replacement.</a></li>
            </ol>
            <p class="bhd-page__reference-note">These references explain general hydration and oral rehydration physiology. They are not product-specific clinical evidence for Best Hydrate.</p>
          </section>
      {% endcase %}
    </div>
  </section>
{% else %}
  <section class="bhd-page-fallback page-width">
    <nav class="bhd-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">{{ page.title }}</span>
    </nav>
    <div class="bhd-page-fallback__content">
      <h1>{{ page.title }}</h1>
      <div class="rte">{{ page.content }}</div>
    </div>
  </section>
{% endif %}

<style>
  #BhdPage-{{ section.id }}{--bhd-navy:#0b2d67;--bhd-blue:#078ee7;--bhd-ink:#1d3151;--bhd-muted:#5b6b82;--bhd-line:rgba(11,45,103,.12);--bhd-pale:#eef8fd;background:linear-gradient(180deg,#f9fcff 0%,#fff 24%,#f7fbff 100%);color:var(--bhd-ink);padding:2.4rem 0 6.5rem}
  #BhdPage-{{ section.id }} *{box-sizing:border-box}
  #BhdPage-{{ section.id }} .bhd-breadcrumbs,.bhd-page-fallback .bhd-breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:0 0 2rem;font-size:1.28rem;color:#66758a}
  #BhdPage-{{ section.id }} .bhd-breadcrumbs a,.bhd-page-fallback .bhd-breadcrumbs a{color:var(--bhd-navy,#0b2d67);text-decoration:none}
  #BhdPage-{{ section.id }} .bhd-breadcrumbs a:hover{text-decoration:underline}
  #BhdPage-{{ section.id }} .bhd-page-hero{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:clamp(2.6rem,5vw,7rem);align-items:center;margin-bottom:3.4rem;padding:clamp(2.2rem,4vw,4.5rem);border:1px solid var(--bhd-line);border-radius:2.4rem;background:#fff;box-shadow:0 2rem 5rem rgba(21,58,105,.08)}
  #BhdPage-{{ section.id }} .bhd-page__eyebrow,#BhdPage-{{ section.id }} .bhd-page__kicker{margin:0 0 .7rem;color:var(--bhd-blue);font-size:1.25rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  #BhdPage-{{ section.id }} h1{margin:0;color:var(--bhd-navy);font-size:clamp(4.3rem,6vw,7.2rem);line-height:.95;letter-spacing:-.045em}
  #BhdPage-{{ section.id }} .bhd-page-hero__lede{max-width:72rem;margin:1.6rem 0 0;color:#42536f;font-size:clamp(1.7rem,2vw,2.15rem);line-height:1.5}
  #BhdPage-{{ section.id }} .bhd-page-hero__media{overflow:hidden;border-radius:1.8rem;aspect-ratio:1.28/1;background:#dcecf5}
  #BhdPage-{{ section.id }} .bhd-page-hero__media img{display:block;width:100%;height:100%;object-fit:cover}
