  #BhdPage-{{ section.id }} .bhd-page__references ol{padding-left:2.2rem}
  #BhdPage-{{ section.id }} .bhd-page__references li{font-size:1.28rem;line-height:1.5;color:#56667d}
  #BhdPage-{{ section.id }} .bhd-page__references li+li{margin-top:.65rem}
  #BhdPage-{{ section.id }} .bhd-page__references a{color:#315b91}
  #BhdPage-{{ section.id }} .bhd-page__reference-note{margin-top:1.2rem;color:#778397;font-size:1.18rem}
  .bhd-page-fallback{padding-top:2.4rem;padding-bottom:5rem}.bhd-page-fallback__content{max-width:95rem;margin:0 auto}.bhd-page-fallback__content h1{color:#0b2d67}
  @media screen and (max-width:989px){
