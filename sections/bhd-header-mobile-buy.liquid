<style>
  .bhd-header__mobile-buy-wrap{display:none}

  @media screen and (max-width:989px){
    .bhd-header__mobile-buy-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 auto;margin-right:.15rem;line-height:1}
    .bhd-header__mobile-buy{display:inline-flex;align-items:center;justify-content:center;min-height:3.55rem;padding:0 1.05rem;border-radius:999px;background:rgb(var(--color-button));color:rgb(var(--color-button-text))!important;font-size:1.18rem;font-weight:800;line-height:1;text-decoration:none!important;white-space:nowrap;box-shadow:0 .25rem .8rem rgba(11,45,103,.14)}
    .bhd-header__mobile-buy:hover{filter:brightness(.96)}
    .bhd-header__mobile-buy-shipping{display:block;margin-top:.22rem;color:#2c6b46;font-size:.78rem;font-weight:750;line-height:1;white-space:nowrap}
  }

  @media screen and (max-width:600px){
    .bhd-header__actions>a[aria-label="Account"]{display:none}
    .bhd-header__mobile-buy{min-height:3.35rem;padding:0 .82rem;font-size:1.08rem}
    .bhd-header__mobile-buy-shipping{font-size:.72rem}
  }

  @media screen and (max-width:420px){
    .bhd-header__mobile-buy{padding:0 .68rem;font-size:1.02rem}
    .bhd-header__mobile-buy-shipping{font-size:.68rem}
    .bhd-header__actions{gap:0}
    .bhd-header__icon-button{width:3.35rem;height:3.35rem}
  }
</style>

<script>
  (() => {
    const mountBuyNow = () => {
      const header = document.querySelector('.bhd-header');
      const actions = header && header.querySelector('.bhd-header__actions');
      if (!actions || actions.querySelector('.bhd-header__mobile-buy-wrap')) return;

      const wrap = document.createElement('div');
      wrap.className = 'bhd-header__mobile-buy-wrap';
      wrap.innerHTML = '<a class="bhd-header__mobile-buy" href="/products/lemonade-best-hydrate">Buy Now</a><small class="bhd-header__mobile-buy-shipping">✓ Free shipping</small>';
      actions.prepend(wrap);
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountBuyNow, { once: true });
    else mountBuyNow();

    document.addEventListener('shopify:section:load', mountBuyNow);
  })();
</script>

{% schema %}
{
  "name":"Compact header Buy Now",
  "enabled_on":{"groups":["header"]},
  "settings":[],
  "presets":[{"name":"Compact header Buy Now"}]
}
{% endschema %}
