<section id="BhdHero-{{ section.id }}" class="bhd-hero bhd-hero--visual" data-bhd-hero>
  <h1 class="visually-hidden">The Science of Hydration. Hydrate for YOUR Best Day!</h1>

  <div class="bhd-hero__desktop" aria-label="Best Hydrate hydration solutions">
    <img
      src="https://hmentca-my.sharepoint.com/:u:/g/personal/austin_besthydrate_com/IQDEKOsS3UWcT6AHuyTQefjFAZcdh9TPeZTYaosU9mjYZcM?download=1"
      alt="Best Hydrate, The Science of Hydration, across performance, daily, medical and humanitarian hydration"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high">
  </div>

  <div class="bhd-hero__carousel bhd-hero__tablet" data-hero-carousel data-interval="5200" aria-label="Best Hydrate tablet hero slideshow">
    <div class="bhd-hero__track">
      <div class="bhd-hero__slide is-active" data-hero-slide><img src="https://hmentca-my.sharepoint.com/:u:/g/personal/austin_besthydrate_com/IQBmYewRGkL3T5x3MzOu4gVXASQwmgRhEoUOXyVWTAHkKJ4?download=1" alt="Best Hydrate hydration science and performance" width="1200" height="900" loading="eager"></div>
      <div class="bhd-hero__slide" data-hero-slide><img src="https://hmentca-my.sharepoint.com/:u:/g/personal/austin_besthydrate_com/IQBUUS4mGYRDQYKnO_O6lDDuAU0vovCepcbSk-GojAMqSmc?download=1" alt="Best Hydrate daily and medical hydration" width="1200" height="900" loading="lazy"></div>
      <div class="bhd-hero__slide" data-hero-slide><img src="https://hmentca-my.sharepoint.com/:u:/g/personal/austin_besthydrate_com/IQCwXrKh-XcDQ4Bu_TYHe_pTAa--fCPy1sMJ50biE1gVvyM?download=1" alt="Best Hydrate humanitarian hydration and hydration science" width="1200" height="900" loading="lazy"></div>
    </div>
    <button class="bhd-hero__arrow bhd-hero__arrow--prev" type="button" data-hero-prev aria-label="Previous hero">‹</button>
    <button class="bhd-hero__arrow bhd-hero__arrow--next" type="button" data-hero-next aria-label="Next hero">›</button>
    <div class="bhd-hero__dots" data-hero-dots aria-label="Hero slides"></div>
  </div>

  <div class="bhd-hero__carousel bhd-hero__mobile" data-hero-carousel data-interval="4700" aria-label="Best Hydrate mobile hero slideshow">
    <div class="bhd-hero__debug" data-hero-debug>
      <strong>BHD HERO DEBUG v20260908-RAW-PINNED</strong>
      <div data-debug-runtime>JS: waiting</div>
      <div data-debug-viewport>Viewport: waiting</div>
      <div data-debug-item="performance">Performance: waiting</div>
      <div data-debug-item="daily">Daily: waiting</div>
      <div data-debug-item="medical">Medical: waiting</div>
      <div data-debug-item="humanitarian">Humanitarian: waiting</div>
    </div>

    <div class="bhd-hero__track">
      <div class="bhd-hero__slide is-active" data-hero-slide>
        <img data-hero-debug-name="performance" src="https://raw.githubusercontent.com/swini16/BhdMain-260907/bc2acdf7c97bc5a2bbf9ed73976d7d73951a5e6e/assets/hero-mobile-performance.webp" alt="Best Hydrate performance hydration" width="720" height="1280" loading="eager" fetchpriority="high" decoding="async">
      </div>
      <div class="bhd-hero__slide" data-hero-slide>
        <img data-hero-debug-name="daily" src="https://raw.githubusercontent.com/swini16/BhdMain-260907/bc2acdf7c97bc5a2bbf9ed73976d7d73951a5e6e/assets/hero-mobile-daily.webp" alt="Best Hydrate daily hydration" width="720" height="1280" loading="eager" decoding="async">
      </div>
      <div class="bhd-hero__slide" data-hero-slide>
        <img data-hero-debug-name="medical" src="https://raw.githubusercontent.com/swini16/BhdMain-260907/bc2acdf7c97bc5a2bbf9ed73976d7d73951a5e6e/assets/hero-mobile-medical.webp" alt="Best Hydrate medical hydration" width="720" height="1280" loading="eager" decoding="async">
      </div>
      <div class="bhd-hero__slide" data-hero-slide>
        <img data-hero-debug-name="humanitarian" src="https://raw.githubusercontent.com/swini16/BhdMain-260907/bc2acdf7c97bc5a2bbf9ed73976d7d73951a5e6e/assets/hero-mobile-humanitarian.webp" alt="Best Hydrate humanitarian hydration" width="720" height="1280" loading="eager" decoding="async">
      </div>
    </div>
    <button class="bhd-hero__arrow bhd-hero__arrow--prev" type="button" data-hero-prev aria-label="Previous hero">‹</button>
    <button class="bhd-hero__arrow bhd-hero__arrow--next" type="button" data-hero-next aria-label="Next hero">›</button>
    <div class="bhd-hero__dots" data-hero-dots aria-label="Hero slides"></div>
  </div>
</section>

<style>
  #BhdHero-{{ section.id }} { position:relative; width:100%; overflow:hidden; background:#dff4ff; }
  #BhdHero-{{ section.id }} img { display:block; width:100%; height:auto; }
  #BhdHero-{{ section.id }} .bhd-hero__desktop { display:block; width:100%; }
  #BhdHero-{{ section.id }} .bhd-hero__desktop img { width:100%; aspect-ratio:1600/900; object-fit:cover; }
  #BhdHero-{{ section.id }} .bhd-hero__tablet,
  #BhdHero-{{ section.id }} .bhd-hero__mobile { display:none; }

  #BhdHero-{{ section.id }} .bhd-hero__carousel { position:relative; width:100%; overflow:hidden; background:#dff4ff; }
  #BhdHero-{{ section.id }} .bhd-hero__track { position:relative; width:100%; }
  #BhdHero-{{ section.id }} .bhd-hero__slide { position:absolute; inset:0; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .5s ease; }
  #BhdHero-{{ section.id }} .bhd-hero__slide.is-active { position:relative; opacity:1; visibility:visible; pointer-events:auto; }
  #BhdHero-{{ section.id }} .bhd-hero__slide img { width:100%; height:100%; object-fit:cover; }

  #BhdHero-{{ section.id }} .bhd-hero__arrow { position:absolute; top:50%; z-index:3; width:4.4rem; height:4.4rem; margin-top:-2.2rem; border:1px solid rgba(255,255,255,.72); border-radius:999px; background:rgba(5,35,85,.58); color:#fff; display:grid; place-items:center; padding:0 0 .25rem; font-size:3.3rem; line-height:1; cursor:pointer; backdrop-filter:blur(7px); box-shadow:0 .5rem 1.8rem rgba(0,25,70,.16); }
  #BhdHero-{{ section.id }} .bhd-hero__arrow--prev { left:1.4rem; }
  #BhdHero-{{ section.id }} .bhd-hero__arrow--next { right:1.4rem; }
  #BhdHero-{{ section.id }} .bhd-hero__dots { position:absolute; z-index:3; left:50%; bottom:1.25rem; transform:translateX(-50%); display:flex; gap:.65rem; padding:.55rem .8rem; border-radius:999px; background:rgba(4,28,67,.34); backdrop-filter:blur(6px); }
  #BhdHero-{{ section.id }} .bhd-hero__dot { width:.8rem; height:.8rem; padding:0; border:1px solid rgba(255,255,255,.85); border-radius:999px; background:transparent; cursor:pointer; }
  #BhdHero-{{ section.id }} .bhd-hero__dot.is-active { background:#fff; transform:scale(1.18); }

  #BhdHero-{{ section.id }} .bhd-hero__debug { display:none; }

  @media screen and (max-width:1199px) and (min-width:750px) {
    #BhdHero-{{ section.id }} .bhd-hero__desktop { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero__tablet { display:block; }
    #BhdHero-{{ section.id }} .bhd-hero__tablet .bhd-hero__track { aspect-ratio:4/3; }
    #BhdHero-{{ section.id }} .bhd-hero__tablet .bhd-hero__slide { height:100%; }
  }

  @media screen and (max-width:749px) {
    #BhdHero-{{ section.id }} .bhd-hero__desktop { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero__mobile { display:block; }
    #BhdHero-{{ section.id }} .bhd-hero__mobile .bhd-hero__track { aspect-ratio:9/16; }
    #BhdHero-{{ section.id }} .bhd-hero__mobile .bhd-hero__slide { height:100%; }
    #BhdHero-{{ section.id }} .bhd-hero__mobile .bhd-hero__slide img { width:100%; height:100%; object-fit:cover; object-position:center; }
    #BhdHero-{{ section.id }} .bhd-hero__arrow { width:3.7rem; height:3.7rem; margin-top:-1.85rem; font-size:2.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero__arrow--prev { left:.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero__arrow--next { right:.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero__dots { bottom:.85rem; }
    #BhdHero-{{ section.id }} .bhd-hero__debug {
      display:block;
      position:absolute;
      z-index:10;
      top:.6rem;
      left:.6rem;
      right:.6rem;
      padding:.7rem .8rem;
      border:2px solid #ff2d55;
      border-radius:.7rem;
      background:rgba(255,255,255,.94);
      color:#111;
      font:600 11px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      overflow-wrap:anywhere;
      box-shadow:0 .3rem 1rem rgba(0,0,0,.18);
    }
    #BhdHero-{{ section.id }} .bhd-hero__debug strong { color:#b00020; }
  }

  @media (prefers-reduced-motion:reduce) {
    #BhdHero-{{ section.id }} .bhd-hero__slide { transition:none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('BhdHero-{{ section.id }}');
    if (!root) return;

    const debug = root.querySelector('[data-hero-debug]');
    if (debug) {
      const runtime = debug.querySelector('[data-debug-runtime]');
      const viewport = debug.querySelector('[data-debug-viewport]');
      runtime.textContent = 'JS: running, section={{ section.id }}';
      viewport.textContent = `Viewport: ${window.innerWidth}x${window.innerHeight}, DPR ${window.devicePixelRatio || 1}`;

      root.querySelectorAll('[data-hero-debug-name]').forEach((img) => {
        const key = img.dataset.heroDebugName;
        const row = debug.querySelector(`[data-debug-item="${key}"]`);
        if (!row) return;

        const paint = (state) => {
          const src = img.currentSrc || img.src || '(no src)';
          const srcLabel = src.length > 115 ? src.slice(0, 112) + '...' : src;
          row.textContent = `${key}: ${state}, natural=${img.naturalWidth}x${img.naturalHeight}, src=${srcLabel}`;
        };

        img.addEventListener('load', () => paint('LOAD OK'));
        img.addEventListener('error', () => paint('LOAD ERROR'));

        if (img.complete) {
          paint(img.naturalWidth > 0 ? 'ALREADY OK' : 'ALREADY ERROR');
        } else {
          paint('PENDING');
        }
      });
    }

    root.querySelectorAll('[data-hero-carousel]').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll('[data-hero-slide]'));
      const dotsWrap = carousel.querySelector('[data-hero-dots]');
      const prev = carousel.querySelector('[data-hero-prev]');
      const next = carousel.querySelector('[data-hero-next]');
      if (slides.length < 2 || !dotsWrap) return;

      let index = 0;
      let timer;
      const interval = Number(carousel.dataset.interval || 5000);

      const dots = slides.map((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'bhd-hero__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', `Show hero ${i + 1}`);
        dot.addEventListener('click', () => { show(i); restart(); });
        dotsWrap.appendChild(dot);
        return dot;
      });

      const show = (nextIndex) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      };

      const stop = () => { if (timer) clearInterval(timer); };
      const start = () => {
        stop();
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => show(index + 1), interval);
      };
      const restart = () => start();

      prev?.addEventListener('click', () => { show(index - 1); restart(); });
      next?.addEventListener('click', () => { show(index + 1); restart(); });
      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', start);
      start();
    });
  })();
</script>

