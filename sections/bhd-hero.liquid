{% assign hero_product = all_products['lemonade-best-hydrate'] %}
{% assign hero_product_image = hero_product.featured_image %}

<section id="BhdHero-{{ section.id }}" class="bhd-hero-v3" data-bhd-hero>
  <h1 class="visually-hidden">The Science of Hydration. Hydrate for YOUR Best Day!</h1>

  <div class="bhd-hero-v3__desktop bhd-hero-v3__frame" aria-label="Best Hydrate hydration solutions">
    <img
      src="https://hmentca-my.sharepoint.com/:u:/g/personal/austin_besthydrate_com/IQDH94WQynO-SY0f-DScEkVfAcjzjTtpIt757vzEnCibR9w?download=1"
      alt="Best Hydrate, The Science of Hydration, across performance, daily, medical and humanitarian hydration"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async">
  </div>

  <div class="bhd-hero-v3__mobile bhd-hero-v3__frame" data-hero-carousel data-interval="5000" aria-label="Best Hydrate mobile hero slideshow">
    <div class="bhd-hero-v3__mobile-stage">
      <div class="bhd-hero-v3__mobile-slide is-active" data-hero-slide>
        <img src="https://raw.githubusercontent.com/swini16/BhdMain-260907/a2007747405e9aaf5328daf59b1eef5fd8c1bfc6/assets/hero-v2-mobile-performance.webp" alt="Best Hydrate performance hydration" width="941" height="1672" loading="eager" fetchpriority="high" decoding="async">
      </div>
      <div class="bhd-hero-v3__mobile-slide" data-hero-slide>
        <img src="https://raw.githubusercontent.com/swini16/BhdMain-260907/a2007747405e9aaf5328daf59b1eef5fd8c1bfc6/assets/hero-v2-mobile-daily.webp" alt="Best Hydrate daily hydration" width="941" height="1672" loading="eager" decoding="async">
      </div>
      <div class="bhd-hero-v3__mobile-slide" data-hero-slide>
        <img src="https://raw.githubusercontent.com/swini16/BhdMain-260907/a2007747405e9aaf5328daf59b1eef5fd8c1bfc6/assets/hero-v2-mobile-medical.webp" alt="Best Hydrate medical hydration" width="941" height="1672" loading="eager" decoding="async">
      </div>
      <div class="bhd-hero-v3__mobile-slide" data-hero-slide>
        <img src="https://raw.githubusercontent.com/swini16/BhdMain-260907/a2007747405e9aaf5328daf59b1eef5fd8c1bfc6/assets/hero-v2-mobile-humanitarian.webp" alt="Best Hydrate humanitarian hydration" width="941" height="1672" loading="eager" decoding="async">
      </div>
      <button class="bhd-hero-v3__arrow bhd-hero-v3__arrow--prev" type="button" data-hero-prev aria-label="Previous hero">‹</button>
      <button class="bhd-hero-v3__arrow bhd-hero-v3__arrow--next" type="button" data-hero-next aria-label="Next hero">›</button>
      <div class="bhd-hero-v3__dots bhd-hero-v3__dots--mobile" data-hero-dots aria-label="Hero slides"></div>
    </div>
  </div>
</section>

<style>
  #BhdHero-{{ section.id }} {
    --hero-navy:#072b68;
    --hero-blue:#078ee7;
    width:100%;
    overflow:hidden;
    background:#eef8fd;
    box-sizing:border-box;
    padding:clamp(36px,3.4vw,56px);
  }
  #BhdHero-{{ section.id }} * { box-sizing:border-box; }
  #BhdHero-{{ section.id }} img { display:block; width:100%; max-width:100%; }
  #BhdHero-{{ section.id }} .bhd-hero-v3__frame {
    overflow:hidden;
    border-radius:18px;
    box-shadow:0 .6rem 1.6rem rgba(7,43,104,.08);
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__desktop {
    display:block;
    width:100%;
    max-width:1600px;
    margin:0 auto;
    background:#eef8fd;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__desktop img {
    width:100%;
    height:auto;
    aspect-ratio:auto;
    object-fit:contain;
    object-position:center center;
    margin:0 auto;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__mobile { display:none; }

  #BhdHero-{{ section.id }} .bhd-hero-v3__arrow {
    position:absolute;
    top:50%;
    z-index:7;
    transform:translateY(-50%);
    width:3.6rem;
    height:3.6rem;
    border:1px solid rgba(255,255,255,.8);
    border-radius:999px;
    background:rgba(6,43,104,.68);
    color:#fff;
    display:grid;
    place-items:center;
    padding:0 0 .2rem;
    font-size:2.6rem;
    line-height:1;
    cursor:pointer;
    backdrop-filter:blur(7px);
    box-shadow:0 .45rem 1.2rem rgba(0,30,75,.18);
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__arrow--prev { left:.85rem; }
  #BhdHero-{{ section.id }} .bhd-hero-v3__arrow--next { right:.85rem; }
  #BhdHero-{{ section.id }} .bhd-hero-v3__dots {
    display:flex;
    justify-content:center;
    align-items:center;
    gap:.55rem;
    min-height:1.5rem;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__dot {
    width:.72rem;
    height:.72rem;
    padding:0;
    border:1px solid rgba(7,43,104,.55);
    border-radius:50%;
    background:#fff;
    cursor:pointer;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v3__dot.is-active { background:var(--hero-navy); transform:scale(1.12); }

  @media screen and (min-width:1200px) {
    #BhdHero-{{ section.id }} {
      padding-top:clamp(36px,3.4vw,56px);
      padding-bottom:clamp(36px,3.4vw,56px);
      padding-left:clamp(72px,6.8vw,112px);
      padding-right:clamp(72px,6.8vw,112px);
    }
  }

  @media screen and (max-width:899px) {
    #BhdHero-{{ section.id }} { padding:12px; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__desktop { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__mobile { display:block; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__mobile-stage { position:relative; background:#dff2fb; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__mobile-slide { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__mobile-slide.is-active { display:block; }
    #BhdHero-{{ section.id }} .bhd-hero-v3__mobile-slide img {
      aspect-ratio:941/1672;
      height:auto;
      object-fit:cover;
    }
    #BhdHero-{{ section.id }} .bhd-hero-v3__arrow {
      width:3.35rem;
      height:3.35rem;
      font-size:2.35rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero-v3__dots--mobile {
      position:absolute;
      left:50%;
      bottom:.65rem;
      transform:translateX(-50%);
      z-index:8;
      padding:.35rem .55rem;
      border-radius:999px;
      background:rgba(255,255,255,.72);
      backdrop-filter:blur(5px);
    }
  }
</style>

<script>
(() => {
  const root = document.getElementById('BhdHero-{{ section.id }}');
  if (!root) return;

  const initCarousel = (carousel) => {
    const slides = Array.from(carousel.querySelectorAll('[data-hero-slide]'));
    if (slides.length < 2) return;

    const prev = carousel.querySelector('[data-hero-prev]');
    const next = carousel.querySelector('[data-hero-next]');
    const dotsWrap = carousel.querySelector('[data-hero-dots]');
    const intervalMs = Number(carousel.dataset.interval || 5000);
    let index = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
    let timer;

    const dots = slides.map((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'bhd-hero-v3__dot';
      dot.setAttribute('aria-label', `Show hero ${i + 1}`);
      dot.addEventListener('click', () => {
        goTo(i);
        restart();
      });
      dotsWrap?.appendChild(dot);
      return dot;
    });

    const goTo = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => {
      stop();
      timer = window.setInterval(() => goTo(index + 1), intervalMs);
    };
    const restart = () => { start(); };

    prev?.addEventListener('click', () => { goTo(index - 1); restart(); });
    next?.addEventListener('click', () => { goTo(index + 1); restart(); });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('touchstart', stop, { passive:true });
    carousel.addEventListener('touchend', start, { passive:true });

    goTo(index);
    start();
  };

  root.querySelectorAll('[data-hero-carousel]').forEach(initCarousel);
})();
</script>

{% schema %}
{
  "name":"Best Hydrate hero",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Hydrate for YOUR best day."},
    {"type":"text","id":"subheading","label":"Subheading","default":"Five essential electrolytes. Built for better hydration."},
    {"type":"product","id":"product","label":"Product"},
    {"type":"text","id":"button_label","label":"Button label","default":"SHOP NOW"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"range","id":"desktop_height","label":"Desktop height","min":400,"max":900,"step":20,"default":620},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":400,"max":900,"step":20,"default":560}
  ],
  "presets":[{"name":"Best Hydrate hero"}]
}
{% endschema %}