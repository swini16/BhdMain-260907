<section id="BhdHero-{{ section.id }}" class="bhd-hero">
  <img class="bhd-hero__media" src="{{ 'bhd-hero-premium.svg' | asset_url }}" alt="" width="1600" height="800" loading="eager">
  <div class="bhd-hero__wash"></div>
  <div class="page-width bhd-hero__inner">
    <div class="bhd-hero__copy">
      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
      {% if section.settings.button_label != blank %}<a class="button button--primary" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label }}</a>{% endif %}
    </div>

    <div class="bhd-hero__visual">
      <div class="bhd-hero__halo" aria-hidden="true"></div>
      {% if section.settings.product != blank and section.settings.product.featured_image != blank %}
        <a href="{{ section.settings.product.url }}" class="bhd-hero__product-card" aria-label="{{ section.settings.product.title | escape }}">
          {{ section.settings.product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '360,540,720,900', sizes: '(min-width: 990px) 35vw, 74vw', class: 'bhd-hero__product', alt: section.settings.product.title }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #BhdHero-{{ section.id }} { position:relative; min-height:620px; overflow:hidden; background:#dff6ff; }
  #BhdHero-{{ section.id }} .bhd-hero__media { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; }
  #BhdHero-{{ section.id }} .bhd-hero__wash { position:absolute; inset:0; background:linear-gradient(90deg,rgba(255,255,255,.90) 0%,rgba(255,255,255,.72) 42%,rgba(255,255,255,.18) 70%,rgba(255,255,255,.02) 100%); }
  #BhdHero-{{ section.id }} .bhd-hero__inner { position:relative; z-index:2; min-height:620px; display:grid; grid-template-columns:minmax(0,.95fr) minmax(340px,.8fr); align-items:center; gap:4rem; }
  #BhdHero-{{ section.id }} .bhd-hero__copy { max-width:690px; padding:4rem 0; }
  #BhdHero-{{ section.id }} .bhd-hero__copy h1 { margin:0; color:#0d2a62; font-size:clamp(4.8rem,6vw,7.3rem); line-height:.98; letter-spacing:-.035em; }
  #BhdHero-{{ section.id }} .bhd-hero__copy p { margin:1.8rem 0 0; color:#173765; font-size:clamp(1.9rem,2.2vw,2.35rem); line-height:1.38; max-width:600px; }
  #BhdHero-{{ section.id }} .bhd-hero__copy .button { margin-top:2.5rem; min-width:170px; }
  #BhdHero-{{ section.id }} .bhd-hero__visual { position:relative; min-height:500px; display:grid; place-items:center; }
  #BhdHero-{{ section.id }} .bhd-hero__halo { position:absolute; width:min(40vw,500px); aspect-ratio:1; border-radius:999px; background:rgba(255,255,255,.44); box-shadow:0 2rem 7rem rgba(23,70,111,.14); backdrop-filter:blur(4px); }
  #BhdHero-{{ section.id }} .bhd-hero__product-card { width:min(34vw,420px); position:relative; z-index:2; border-radius:1.8rem; overflow:hidden; box-shadow:0 2.4rem 5rem rgba(10,44,82,.20); background:#fff; transform:translateY(.6rem); }
  #BhdHero-{{ section.id }} .bhd-hero__product { display:block; width:100%; height:auto; }

  @media screen and (max-width:989px){
    #BhdHero-{{ section.id }} { min-height:690px; }
    #BhdHero-{{ section.id }} .bhd-hero__wash { background:linear-gradient(180deg,rgba(255,255,255,.95) 0%,rgba(255,255,255,.78) 44%,rgba(255,255,255,.12) 78%); }
    #BhdHero-{{ section.id }} .bhd-hero__inner { min-height:690px; grid-template-columns:1fr; gap:.2rem; text-align:center; padding:2rem 0 1.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero__copy { max-width:680px; margin:0 auto; padding:.8rem 0 0; }
    #BhdHero-{{ section.id }} .bhd-hero__copy h1 { font-size:clamp(4rem,10vw,5.6rem); }
    #BhdHero-{{ section.id }} .bhd-hero__copy p { margin-left:auto; margin-right:auto; font-size:1.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero__visual { min-height:320px; }
    #BhdHero-{{ section.id }} .bhd-hero__product-card { width:min(58vw,330px); transform:none; }
    #BhdHero-{{ section.id }} .bhd-hero__halo { width:min(70vw,370px); }
  }

  @media screen and (max-width:749px){
    #BhdHero-{{ section.id }} { min-height:560px; }
    #BhdHero-{{ section.id }} .bhd-hero__inner { min-height:560px; padding:1.2rem 0 1.4rem; }
    #BhdHero-{{ section.id }} .bhd-hero__copy { padding-top:.4rem; }
    #BhdHero-{{ section.id }} .bhd-hero__copy h1 { font-size:clamp(3.45rem,10.8vw,4.55rem); }
    #BhdHero-{{ section.id }} .bhd-hero__copy p { margin-top:.9rem; font-size:1.52rem; }
    #BhdHero-{{ section.id }} .bhd-hero__copy .button { margin-top:1.4rem; min-width:145px; }
    #BhdHero-{{ section.id }} .bhd-hero__visual { min-height:245px; }
    #BhdHero-{{ section.id }} .bhd-hero__product-card { width:min(64vw,260px); border-radius:1.2rem; }
    #BhdHero-{{ section.id }} .bhd-hero__halo { width:min(76vw,300px); }
  }
</style>

{% schema %}
{
  "name":"Best Hydrate hero",
  "settings":[
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Hydrate for YOUR best day."},
    {"type":"inline_richtext","id":"subheading","label":"Subheading","default":"Five essential electrolytes. Built for better hydration."},
    {"type":"product","id":"product","label":"Hero product"},
    {"type":"text","id":"button_label","label":"Button label","default":"SHOP NOW"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"range","id":"desktop_height","label":"Desktop height","min":500,"max":820,"step":20,"unit":"px","default":620},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":520,"max":760,"step":20,"unit":"px","default":560}
  ],
  "presets":[{"name":"Best Hydrate hero"}]
}
{% endschema %}
