<section id="BhdHero-{{ section.id }}" class="bhd-hero">
  {% if section.settings.product != blank and section.settings.product.featured_image != blank %}
    {{ section.settings.product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 1800', sizes: '100vw', class: 'bhd-hero__media', alt: section.settings.product.title }}
  {% else %}
    <img class="bhd-hero__media" src="{{ 'bhd-hero-premium.svg' | asset_url }}" alt="" width="1600" height="800" loading="eager">
  {% endif %}
  <div class="bhd-hero__shade"></div>
  <div class="page-width bhd-hero__content">
    <div class="bhd-hero__box">
      {% if section.settings.heading != blank %}
        <h1 class="bhd-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% assign hero_subheading = section.settings.subheading %}
      {% if hero_subheading == 'Five essential electrolytes. Built for better hydration.' %}
        {% assign hero_subheading = 'For training, work, recovery and everyday life.' %}
      {% endif %}
      {% if hero_subheading != blank %}
        <div class="bhd-hero__subheading">{{ hero_subheading }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button button--primary bhd-hero__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #BhdHero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    display: grid;
    align-items: center;
    background: #0b2558;
  }
  #BhdHero-{{ section.id }} .bhd-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }
  #BhdHero-{{ section.id }} .bhd-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(3,20,55,.78) 0%, rgba(5,32,72,.53) 42%, rgba(7,39,82,.12) 72%, rgba(7,39,82,.02) 100%);
  }
  #BhdHero-{{ section.id }} .bhd-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.desktop_height }}px;
    padding: 4rem 0;
  }
  #BhdHero-{{ section.id }} .bhd-hero__box {
    width: min(650px, 56vw);
    padding: 3.2rem 3.5rem;
    border-radius: 2rem;
    background: rgba(6, 28, 67, .54);
    border: 1px solid rgba(255,255,255,.20);
    box-shadow: 0 2rem 6rem rgba(0,0,0,.18);
    backdrop-filter: blur(8px);
  }
  #BhdHero-{{ section.id }} .bhd-hero__heading {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading-family);
    font-weight: 750;
    font-size: clamp(4rem, 5.1vw, 6.8rem);
    line-height: 1.01;
    letter-spacing: -.02em;
    text-shadow: 0 2px 14px rgba(0,0,0,.2);
  }
  #BhdHero-{{ section.id }} .bhd-hero__subheading {
    margin: 1.5rem 0 0;
    max-width: 560px;
    color: rgba(255,255,255,.94);
    font-size: clamp(1.8rem, 2vw, 2.25rem);
    line-height: 1.4;
    font-weight: 500;
  }
  #BhdHero-{{ section.id }} .bhd-hero__button { margin-top: 2.4rem; }

  @media screen and (max-width: 989px) {
    #BhdHero-{{ section.id }} .bhd-hero__shade {
      background: linear-gradient(180deg, rgba(3,20,55,.60) 0%, rgba(3,20,55,.38) 48%, rgba(3,20,55,.56) 100%);
    }
    #BhdHero-{{ section.id }} .bhd-hero__content {
      justify-content: center;
      text-align: center;
      padding: 2.4rem 0;
    }
    #BhdHero-{{ section.id }} .bhd-hero__box {
      width: min(680px, 88vw);
      margin: 0 auto;
      background: rgba(7, 30, 70, .58);
    }
    #BhdHero-{{ section.id }} .bhd-hero__subheading { margin-left: auto; margin-right: auto; }
  }

  @media screen and (max-width: 749px) {
    #BhdHero-{{ section.id }} { min-height: 470px; }
    #BhdHero-{{ section.id }} .bhd-hero__media {
      object-position: center 46%;
      filter: saturate(1.04) contrast(1.03);
    }
    #BhdHero-{{ section.id }} .bhd-hero__content {
      min-height: 470px;
      align-items: end;
      padding: 1.8rem 0 2.2rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero__box {
      width: calc(100% - 2.4rem);
      padding: 1.9rem 1.6rem;
      border-radius: 1.35rem;
      background: rgba(5, 24, 60, .68);
      backdrop-filter: blur(6px);
    }
    #BhdHero-{{ section.id }} .bhd-hero__heading {
      font-size: clamp(3.15rem, 10.3vw, 4.5rem);
      line-height: 1.02;
    }
    #BhdHero-{{ section.id }} .bhd-hero__subheading {
      margin-top: 1rem;
      font-size: 1.55rem;
      line-height: 1.32;
    }
    #BhdHero-{{ section.id }} .bhd-hero__button { margin-top: 1.5rem; }
  }
</style>

{% schema %}
{
  "name": "Best Hydrate hero",
  "settings": [
    {"type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hydrate for YOUR best day."},
    {"type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "For training, work, recovery and everyday life."},
    {"type": "product", "id": "product", "label": "Hero product"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "range", "id": "desktop_height", "label": "Desktop height", "min": 500, "max": 820, "step": 20, "unit": "px", "default": 620},
    {"type": "range", "id": "mobile_height", "label": "Mobile height", "min": 420, "max": 700, "step": 20, "unit": "px", "default": 480}
  ],
  "presets": [{"name": "Best Hydrate hero"}]
}
{% endschema %}
