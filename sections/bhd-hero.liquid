<section id="BhdHero-{{ section.id }}" class="bhd-hero">
  <img class="bhd-hero__media" src="{{ 'bhd-hero-premium.svg' | asset_url }}" alt="" width="1600" height="800" loading="eager">
  <div class="page-width bhd-hero__content">
    <div class="bhd-hero__layout">
      <div class="bhd-hero__box">
        {% if section.settings.heading != blank %}
          <h1 class="bhd-hero__heading">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="bhd-hero__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="button button--primary bhd-hero__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label }}</a>
        {% endif %}
      </div>

      <div class="bhd-hero__visual" aria-hidden="true">
        <div class="bhd-hero__halo"></div>
        {% if section.settings.product != blank and section.settings.product.featured_image != blank %}
          {{ section.settings.product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '420, 620, 820, 1000', sizes: '(min-width: 990px) 40vw, 72vw', class: 'bhd-hero__product-image', alt: '' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #BhdHero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    display: grid;
    align-items: center;
    background: #dff6ff;
  }
  #BhdHero-{{ section.id }} .bhd-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  #BhdHero-{{ section.id }} .bhd-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  #BhdHero-{{ section.id }} .bhd-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(360px, .8fr);
    gap: 4rem;
    align-items: center;
    min-height: {{ section.settings.desktop_height }}px;
    padding: 4rem 0;
  }
  #BhdHero-{{ section.id }} .bhd-hero__box {
    max-width: 690px;
    padding: 3.2rem 3.4rem;
    border-radius: 2rem;
    background: rgba(255,255,255,.76);
    box-shadow: 0 2.2rem 6rem rgba(8,49,84,.14);
    backdrop-filter: blur(8px);
  }
  #BhdHero-{{ section.id }} .bhd-hero__heading {
    margin: 0;
    color: #0b2558;
    font-family: var(--font-heading-family);
    font-weight: 750;
    font-size: clamp(4rem, 5.1vw, 6.8rem);
    line-height: 1.01;
    letter-spacing: -.02em;
  }
  #BhdHero-{{ section.id }} .bhd-hero__subheading {
    margin: 1.6rem 0 0;
    max-width: 560px;
    color: #183863;
    font-size: clamp(1.8rem, 2vw, 2.35rem);
    line-height: 1.4;
    font-weight: 500;
  }
  #BhdHero-{{ section.id }} .bhd-hero__button {
    margin-top: 2.5rem;
  }
  #BhdHero-{{ section.id }} .bhd-hero__visual {
    position: relative;
    min-height: 500px;
    display: grid;
    place-items: center;
  }
  #BhdHero-{{ section.id }} .bhd-hero__halo {
    position: absolute;
    width: min(42vw, 530px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255,255,255,.48);
    box-shadow: 0 2rem 7rem rgba(7,63,103,.16);
    backdrop-filter: blur(5px);
  }
  #BhdHero-{{ section.id }} .bhd-hero__product-image {
    position: relative;
    z-index: 2;
    display: block;
    width: min(39vw, 510px);
    height: auto;
    max-height: 520px;
    object-fit: contain;
    filter: drop-shadow(0 2.3rem 2.2rem rgba(5,42,72,.24));
  }

  @media screen and (max-width: 989px) {
    #BhdHero-{{ section.id }} .bhd-hero__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      text-align: center;
      padding: 3.5rem 0 2rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero__box {
      margin: 0 auto;
      max-width: 720px;
    }
    #BhdHero-{{ section.id }} .bhd-hero__subheading { margin-left: auto; margin-right: auto; }
    #BhdHero-{{ section.id }} .bhd-hero__visual { min-height: 330px; }
    #BhdHero-{{ section.id }} .bhd-hero__product-image { width: min(62vw, 380px); max-height: 360px; }
    #BhdHero-{{ section.id }} .bhd-hero__halo { width: min(70vw, 390px); }
  }

  @media screen and (max-width: 749px) {
    #BhdHero-{{ section.id }} {
      min-height: {{ section.settings.mobile_height }}px;
    }
    #BhdHero-{{ section.id }} .bhd-hero__layout {
      min-height: {{ section.settings.mobile_height }}px;
      padding: 2rem 0 1.5rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero__box {
      padding: 2.4rem 2rem;
      border-radius: 1.4rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero__heading {
      font-size: clamp(3.4rem, 11vw, 5rem);
    }
    #BhdHero-{{ section.id }} .bhd-hero__subheading {
      font-size: 1.7rem;
    }
    #BhdHero-{{ section.id }} .bhd-hero__visual { min-height: 280px; }
    #BhdHero-{{ section.id }} .bhd-hero__product-image { width: min(74vw, 330px); max-height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Best Hydrate hero",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hydrate for YOUR best day."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Five essential electrolytes. Built for better hydration."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Hero product"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 500,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 620,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    }
  ],
  "presets": [
    {
      "name": "Best Hydrate hero"
    }
  ]
}
{% endschema %}
