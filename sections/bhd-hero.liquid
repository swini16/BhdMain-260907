<style>
  #BhdHero-{{ section.id }} {
    --hero-navy:#072b68;
    --hero-blue:#078ee7;
    position:relative;
    width:100%;
    overflow:hidden;
    background:#eef8fd;
  }
  #BhdHero-{{ section.id }} img { display:block; max-width:100%; }
  #BhdHero-{{ section.id }} .bhd-hero-v2__desktop { display:block; }
  #BhdHero-{{ section.id }} .bhd-hero-v2__desktop img { width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; }
  #BhdHero-{{ section.id }} .bhd-hero-v2__tablet,
  #BhdHero-{{ section.id }} .bhd-hero-v2__mobile { display:none; }

  #BhdHero-{{ section.id }} .bhd-hero-v2__arrow {
    position:absolute; top:50%; z-index:7; transform:translateY(-50%);
    width:4.2rem; height:4.2rem; border:1px solid rgba(255,255,255,.75); border-radius:999px;
    background:rgba(6,43,104,.62); color:#fff; display:grid; place-items:center; padding:0 0 .25rem;
    font-size:3rem; line-height:1; cursor:pointer; backdrop-filter:blur(7px); box-shadow:0 .5rem 1.5rem rgba(0,30,75,.18);
  }
  #BhdHero-{{ section.id }} .bhd-hero-v2__arrow--prev { left:1rem; }
  #BhdHero-{{ section.id }} .bhd-hero-v2__arrow--next { right:1rem; }
  #BhdHero-{{ section.id }} .bhd-hero-v2__dots {
    position:absolute; z-index:8; left:50%; transform:translateX(-50%); display:flex; gap:.55rem;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v2__dot {
    width:.75rem; height:.75rem; padding:0; border:1px solid rgba(7,43,104,.65); border-radius:50%; background:#fff; cursor:pointer;
  }
  #BhdHero-{{ section.id }} .bhd-hero-v2__dot.is-active { background:var(--hero-navy); transform:scale(1.15); }

  @media screen and (max-width:1199px) and (min-width:750px) {
    #BhdHero-{{ section.id }} .bhd-hero-v2__desktop { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet { display:block; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet-shell {
      position:relative; width:100%; aspect-ratio:4/3; overflow:hidden;
      background:linear-gradient(180deg,#fafdff 0%,#edf8fd 69%,#d8eef9 100%);
      color:var(--hero-navy);
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__shared-head {
      position:absolute; z-index:6; top:2.1%; left:15%; right:15%; text-align:center;
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__eyebrow { font-size:clamp(.72rem,1.25vw,1rem); letter-spacing:.42em; font-weight:700; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__headline { font-size:clamp(2rem,5.1vw,4rem); line-height:.88; font-weight:900; color:var(--hero-blue); text-transform:uppercase; letter-spacing:-.035em; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__headline span { display:block; color:var(--hero-navy); font-size:.5em; letter-spacing:.02em; margin-bottom:.05em; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tagline { margin-top:.25rem; font-size:clamp(1rem,2vw,1.65rem); font-weight:700; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tagline em { font-style:italic; border-bottom:.18em solid #16bce7; padding:0 .08em; }

    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet-track { position:absolute; inset:21% 3% 20%; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet-slide {
      position:absolute; inset:0; display:grid; grid-template-columns:1fr 1fr; gap:1.1rem;
      opacity:0; visibility:hidden; pointer-events:none; transition:opacity .45s ease;
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet-slide.is-active { opacity:1; visibility:visible; pointer-events:auto; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-card {
      position:relative; overflow:hidden; border-radius:1.2rem; background:#d8ecf6;
      box-shadow:0 .6rem 1.7rem rgba(13,68,115,.14); border:1px solid rgba(255,255,255,.9);
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-card img { width:100%; height:100%; object-fit:cover; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-card::after {
      content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(3,32,72,.7) 0%,rgba(3,32,72,.05) 35%,rgba(3,32,72,0) 58%);
      pointer-events:none;
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-copy { position:absolute; z-index:2; left:1.2rem; top:1rem; right:1rem; color:#fff; text-shadow:0 2px 8px rgba(0,20,55,.3); }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-copy strong { display:block; font-size:clamp(1.5rem,3.2vw,2.6rem); line-height:1; text-transform:uppercase; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__segment-copy span { display:block; margin-top:.28rem; max-width:75%; font-size:clamp(.82rem,1.55vw,1.2rem); line-height:1.08; font-weight:700; }

    #BhdHero-{{ section.id }} .bhd-hero-v2__product {
      position:absolute; z-index:5; left:50%; bottom:11.8%; transform:translateX(-50%); width:clamp(14rem,24vw,22rem); text-decoration:none;
      filter:drop-shadow(0 .75rem 1rem rgba(0,25,70,.24));
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__product img { width:100%; height:auto; object-fit:contain; }

    #BhdHero-{{ section.id }} .bhd-hero-v2__benefits {
      position:absolute; z-index:4; left:0; right:0; bottom:0; height:17.5%; padding:1.1% 5% 1.4%;
      display:grid; grid-template-columns:repeat(4,1fr); align-items:center;
      background:rgba(250,253,255,.95); border-top:1px solid rgba(7,43,104,.1);
    }
    #BhdHero-{{ section.id }} .bhd-hero-v2__benefit { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.3rem; text-align:center; font-size:clamp(.62rem,1.08vw,.92rem); line-height:1.05; font-weight:800; text-transform:uppercase; color:var(--hero-navy); }
    #BhdHero-{{ section.id }} .bhd-hero-v2__benefit + .bhd-hero-v2__benefit { border-left:1px solid rgba(7,43,104,.28); }
    #BhdHero-{{ section.id }} .bhd-hero-v2__benefit svg { width:clamp(1.8rem,3.2vw,2.7rem); height:clamp(1.8rem,3.2vw,2.7rem); fill:none; stroke:var(--hero-blue); stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__dots { bottom:18.2%; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__arrow { top:50%; }
  }

  @media screen and (max-width:749px) {
    #BhdHero-{{ section.id }} .bhd-hero-v2__desktop,
    #BhdHero-{{ section.id }} .bhd-hero-v2__tablet { display:none; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__mobile { display:block; position:relative; width:100%; overflow:hidden; background:#eef8fd; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__mobile-track { position:relative; width:100%; aspect-ratio:9/16; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__mobile-slide { position:absolute; inset:0; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .45s ease; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__mobile-slide.is-active { opacity:1; visibility:visible; pointer-events:auto; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__mobile-slide img { width:100%; height:100%; object-fit:cover; object-position:center; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__arrow { width:3.65rem; height:3.65rem; font-size:2.8rem; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__arrow--prev { left:.7rem; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__arrow--next { right:.7rem; }
    #BhdHero-{{ section.id }} .bhd-hero-v2__dots { bottom:.8rem; padding:.42rem .58rem; border-radius:999px; background:rgba(255,255,255,.78); backdrop-filter:blur(5px); }
  }

  @media (prefers-reduced-motion:reduce) {
    #BhdHero-{{ section.id }} [data-hero-slide] { transition:none !important; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('BhdHero-{{ section.id }}');
    if (!root) return;

    root.querySelectorAll('[data-hero-carousel]').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll('[data-hero-slide]'));
      const dotsWrap = carousel.querySelector('[data-hero-dots]');
      const prev = carousel.querySelector('[data-hero-prev]');
      const next = carousel.querySelector('[data-hero-next]');
      if (slides.length < 2 || !dotsWrap) return;

      let index = 0;
      let timer;
      const interval = Number(carousel.dataset.interval || 5200);

      dotsWrap.innerHTML = '';
      const dots = slides.map((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'bhd-hero-v2__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', `Show hero ${i + 1}`);
        dot.addEventListener('click', () => { show(i); restart(); });
        dotsWrap.appendChild(dot);
        return dot;
      });

      const show = (nextIndex) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      };

      const stop = () => { if (timer) clearInterval(timer); };
      const start = () => {
        stop();
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => show(index + 1), interval);
      };
      const restart = () => start();

      prev?.addEventListener('click', () => { show(index - 1); restart(); });
      next?.addEventListener('click', () => { show(index + 1); restart(); });
      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', start);
      carousel.addEventListener('touchstart', stop, { passive:true });
      carousel.addEventListener('touchend', start, { passive:true });
      start();
    });
  })();
</script>

