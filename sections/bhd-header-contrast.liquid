      box-shadow: 0 .45rem 1.4rem rgba(13,33,78,.13);
    }
    .bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle { background: rgba(var(--color-button), .25); }

    .bhd-header .bhd-header__main-toggle span {
      width: .82rem;
      height: .82rem;
      font-size: 0 !important;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      border-radius: 1px;
      transform: rotate(45deg) translate(-1px,-1px) !important;
      transform-origin: 50% 50%;
      transition: transform .17s ease;
    }
    .bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle span {
      transform: rotate(225deg) translate(-1px,-1px) !important;
    }

    .bhd-header .bhd-header__dropdown-menu,
    .bhd-header .bhd-header__dropdown-menu--wide {
      width: min(860px, calc(100vw - 32px)) !important;
      grid-template-columns: repeat(4, minmax(0,1fr)) !important;
      gap: .9rem !important;
      transform: translateX(calc(-50% + var(--menu-shift-x, 0px))) !important;
    }
    .bhd-header .bhd-header__main-item.is-open .bhd-header__dropdown-menu {
      top: calc(100% + 1.45rem);
