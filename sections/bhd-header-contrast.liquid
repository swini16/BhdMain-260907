<style>
  @media screen and (min-width: 990px) {
    /* Static top-level controls should clearly read as controls before opening. */
    .bhd-header .bhd-header__split-button {
      background: rgba(var(--color-button), .10);
      border-color: rgba(var(--color-button), .28);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.75), 0 .2rem .75rem rgba(13,33,78,.055);
    }

    .bhd-header .bhd-header__main-link {
      font-weight: 600;
    }

    .bhd-header .bhd-header__main-toggle {
      background: rgba(var(--color-button), .16);
      border-left-color: rgba(var(--color-button), .30);
    }

    .bhd-header .bhd-header__main-item:hover .bhd-header__split-button {
      background: rgba(var(--color-button), .15);
      border-color: rgba(var(--color-button), .38);
      box-shadow: 0 .35rem 1rem rgba(13,33,78,.08);
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__split-button {
      background: rgba(var(--color-button), .23);
      border-color: rgba(var(--color-button), .58);
      box-shadow: 0 .45rem 1.4rem rgba(13, 33, 78, .13);
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle {
      background: rgba(var(--color-button), .22);
    }

    /* Replace the text glyph with a cleaner CSS chevron. */
    .bhd-header .bhd-header__main-toggle span {
      width: .82rem;
      height: .82rem;
      font-size: 0 !important;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      border-radius: 1px;
      transform: rotate(45deg) translate(-1px, -1px) !important;
      transform-origin: 50% 50%;
      transition: transform .17s ease;
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__main-toggle span {
      transform: rotate(225deg) translate(-1px, -1px) !important;
    }

    /* Dropdown stays clean and lighter than the static control above it. */
    .bhd-header .bhd-header__main-item.is-open .bhd-header__dropdown-menu {
      top: calc(100% + 1.45rem);
      background: rgb(var(--color-background));
      border: 1px solid rgba(var(--color-foreground), .13);
      border-top: 3px solid rgba(var(--color-button), .50);
      box-shadow: 0 2.2rem 5rem rgba(13, 33, 78, .18);
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__dropdown-menu::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 50%;
      width: 18px;
      height: 18px;
      transform: translateX(-50%) rotate(45deg);
      background: rgb(var(--color-background));
      border-left: 1px solid rgba(var(--color-foreground), .13);
      border-top: 1px solid rgba(var(--color-foreground), .13);
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__dropdown-child {
      background: rgba(var(--color-foreground), .018);
      border: 1px solid rgba(var(--color-foreground), .055);
    }
  }

  @media screen and (max-width: 989px) {
    .bhd-header .bhd-header__mobile-main-row {
      background: rgba(var(--color-button), .085);
      border-color: rgba(var(--color-button), .24);
    }

    .bhd-header .bhd-header__mobile-main-row > a {
      font-weight: 600;
    }

    .bhd-header .bhd-header__mobile-toggle {
      background: rgba(var(--color-button), .15);
      border-left-color: rgba(var(--color-button), .28);
    }

    .bhd-header .bhd-header__mobile-toggle span {
      display: inline-block;
      width: .78rem;
      height: .78rem;
      font-size: 0 !important;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      border-radius: 1px;
      transform: rotate(45deg) translate(-1px, -1px) !important;
      transform-origin: 50% 50%;
      transition: transform .17s ease;
    }

    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-main-row {
      background: rgba(var(--color-button), .20);
      border-color: rgba(var(--color-button), .50);
    }

    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-toggle span {
      transform: rotate(225deg) translate(-1px, -1px) !important;
    }

    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-level-one {
      margin-top: .45rem;
      padding: .75rem;
      border: 1px solid rgba(var(--color-foreground), .12);
      border-left: 3px solid rgba(var(--color-button), .50);
      border-radius: 10px;
      background: rgb(var(--color-background));
      box-shadow: 0 .8rem 2rem rgba(13,33,78,.08);
    }
  }
</style>

{% schema %}
{
  "name": "Header menu contrast",
  "enabled_on": {"groups": ["header"]},
  "settings": []
}
{% endschema %}
