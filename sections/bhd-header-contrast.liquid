{% render 'bhd-header-menu-source' %}

<style>
  @media screen and (min-width:990px){
    .bhd-header .bhd-header__split-button{background:rgba(var(--color-button),.11);border-color:rgba(var(--color-button),.32);box-shadow:inset 0 1px 0 rgba(255,255,255,.78),0 .22rem .8rem rgba(13,33,78,.06)}
    .bhd-header .bhd-header__main-link{font-weight:650}
    .bhd-header .bhd-header__main-toggle{background:rgba(var(--color-button),.18);border-left-color:rgba(var(--color-button),.34)}

    /* Desktop interaction is click-only. bhd-header.liquid owns the single state machine. */
    .bhd-header .bhd-header__main-item .bhd-header__dropdown-menu,
    .bhd-header .bhd-header__main-item:hover .bhd-header__dropdown-menu,
    .bhd-header .bhd-header__main-item:focus-within .bhd-header__dropdown-menu{
      display:none!important;
      visibility:hidden!important;
      opacity:0!important;
      pointer-events:none!important;
    }
    .bhd-header .bhd-header__main-item.is-open .bhd-header__dropdown-menu{
      display:grid!important;
      visibility:visible!important;
      opacity:1!important;
      pointer-events:auto!important;
      z-index:3;
      border-top:3px solid rgba(var(--color-button),.5);
      box-shadow:0 2.2rem 5rem rgba(13,33,78,.18);
    }

    .bhd-header .bhd-header__main-item.is-open .bhd-header__split-button{
      background:rgba(var(--color-button),.24);
      border-color:rgba(var(--color-button),.6);
      box-shadow:0 .45rem 1.4rem rgba(13,33,78,.13)
    }

    .bhd-header .bhd-header__main-item.bhd-current-main:not(.is-open) .bhd-header__split-button{
      background:rgba(72,132,120,.14);
      border-color:rgba(72,132,120,.46);
      box-shadow:inset 0 -3px 0 rgba(72,132,120,.72),0 .2rem .75rem rgba(44,92,82,.08)
    }
    .bhd-header .bhd-header__main-item.bhd-current-main .bhd-header__main-link{color:#245f55;font-weight:780}
    .bhd-header .bhd-header__main-item.bhd-current-main .bhd-header__main-toggle{border-left-color:rgba(72,132,120,.42)}

    .bhd-header .bhd-header__dropdown-child:hover .bhd-header__tier2-split{background:rgba(var(--color-button),.13);border-color:rgba(var(--color-button),.38)}
    .bhd-header .bhd-header__dropdown-child.is-tier2-open .bhd-header__tier2-split{background:rgba(72,132,120,.15);border-color:rgba(72,132,120,.48);box-shadow:0 .3rem .9rem rgba(44,92,82,.10)}
    .bhd-header .bhd-header__dropdown-child.is-tier2-open .bhd-header__tier2-link{color:#245f55}
    .bhd-header .bhd-header__dropdown-child.is-tier2-open .bhd-header__tier2-toggle{background:rgba(72,132,120,.26);color:#245f55;border-left-color:rgba(72,132,120,.46)}
    .bhd-header .bhd-header__dropdown-child.bhd-current-tier2 .bhd-header__tier2-split{background:rgba(72,132,120,.12);border-color:rgba(72,132,120,.52);box-shadow:inset 3px 0 0 rgba(72,132,120,.72)}
    .bhd-header .bhd-header__dropdown-child.bhd-current-tier2 .bhd-header__tier2-link{color:#245f55;font-weight:800}
    .bhd-header .bhd-header__tier3 a.bhd-current-tier3{background:rgba(72,132,120,.14);color:#245f55;font-weight:800;border-radius:.55rem;box-shadow:inset 3px 0 0 rgba(72,132,120,.72)}
  }

  .bhd-header .bhd-header__discuss-button.bhd-current-blog{border-color:rgba(72,132,120,.68)!important;background:rgba(72,132,120,.10)!important;box-shadow:0 0 0 3px rgba(72,132,120,.16),0 .55rem 1.45rem rgba(44,92,82,.14)!important}
  .bhd-header .bhd-header__discuss-button.bhd-current-blog::after{content:"";position:absolute;right:.28rem;bottom:.28rem;width:.72rem;height:.72rem;border-radius:50%;background:#488478;border:2px solid #fff;z-index:2}
  .bhd-header .bhd-header__shop-cta.bhd-current-shop{box-shadow:0 0 0 3px rgba(72,132,120,.20),0 .4rem 1rem rgba(44,92,82,.12)}

  @media screen and (max-width:989px){
    .bhd-header .bhd-header__mobile-main.is-open .bhd-header__mobile-main-row{background:rgba(var(--color-button),.2);border-color:rgba(var(--color-button),.5)}
    .bhd-header .bhd-header__mobile-main.bhd-current-main .bhd-header__mobile-main-row{background:rgba(72,132,120,.12);border-color:rgba(72,132,120,.46);box-shadow:inset 3px 0 0 rgba(72,132,120,.72)}
    .bhd-header .bhd-header__mobile-main.bhd-current-main .bhd-header__mobile-main-row>a{color:#245f55;font-weight:800}
    .bhd-header .bhd-header__mobile-tier2.is-tier2-open .bhd-header__mobile-tier2-split{background:rgba(72,132,120,.15);border-color:rgba(72,132,120,.48);box-shadow:0 .25rem .75rem rgba(44,92,82,.08)}
    .bhd-header .bhd-header__mobile-tier2.is-tier2-open .bhd-header__mobile-tier2-link{color:#245f55}
    .bhd-header .bhd-header__mobile-tier2.is-tier2-open .bhd-header__mobile-tier2-toggle{background:rgba(72,132,120,.26);color:#245f55;border-left-color:rgba(72,132,120,.46)}
    .bhd-header .bhd-header__mobile-tier2.bhd-current-tier2 .bhd-header__mobile-tier2-split{background:rgba(72,132,120,.12);border-color:rgba(72,132,120,.5);box-shadow:inset 3px 0 0 rgba(72,132,120,.72)}
    .bhd-header .bhd-header__mobile-tier2.bhd-current-tier2 .bhd-header__mobile-tier2-link{color:#245f55;font-weight:800}
    .bhd-header .bhd-header__mobile-tier3 a.bhd-current-tier3{background:rgba(72,132,120,.14);color:#245f55;font-weight:800;border-radius:.55rem;box-shadow:inset 3px 0 0 rgba(72,132,120,.72)}
  }

  @media screen and (max-width:360px){
    .bhd-header .bhd-header__inner{gap:.35rem}
    .bhd-header .bhd-header__actions>a[aria-label="Account"]{display:none}
    .bhd-header .bhd-header__brand{gap:.35rem}
    .bhd-header .bhd-header__logo{width:32px;height:32px}
    .bhd-header .bhd-header__site-name{font-size:1.6rem}
    .bhd-header .bhd-header__tagline{display:none}
  }
</style>

<script>
  (()=>{
    const normalizedPath=(value)=>{
      if(!value)return'';
      try{
        const parsed=new URL(value,location.origin);
        return (parsed.pathname||'/').replace(/\/+$/,'')||'/';
      }catch(_){
        return String(value).split('?')[0].split('#')[0].replace(/\/+$/,'')||'/';
      }
    };
    const samePath=(link,path)=>Boolean(link&&normalizedPath(link.getAttribute('href'))===path);
    const textOf=(node)=>node?.textContent?.replace(/\s+/g,' ').trim()||'';

    const clearCurrentClasses=(header)=>{
      header.querySelectorAll('.bhd-current-main,.bhd-current-tier2,.bhd-current-tier3,.bhd-current-blog,.bhd-current-shop').forEach(node=>{
        node.classList.remove('bhd-current-main','bhd-current-tier2','bhd-current-tier3','bhd-current-blog','bhd-current-shop');
        if(node.getAttribute('aria-current')==='location'||node.getAttribute('aria-current')==='page')node.removeAttribute('aria-current');
      });
    };

    const markDesktopPath=(header,path,isBlog)=>{
      header.querySelectorAll('[data-main-item]').forEach(main=>{
        const mainLink=main.querySelector(':scope > .bhd-header__split-button .bhd-header__main-link');
        let mainMatch=samePath(mainLink,path);
        const mainLabel=textOf(mainLink);
        main.querySelectorAll(':scope > .bhd-header__dropdown-menu > .bhd-header__dropdown-child').forEach(child=>{
          const tier2Link=child.querySelector(':scope > .bhd-header__tier2-split .bhd-header__tier2-link');
          let tier2Match=samePath(tier2Link,path);
          child.querySelectorAll(':scope > .bhd-header__tier3 > a').forEach(leaf=>{
            const blogLeaf=isBlog&&normalizedPath(leaf.getAttribute('href'))==='/blogs/news';
            if(samePath(leaf,path)||blogLeaf){
              leaf.classList.add('bhd-current-tier3');
              leaf.setAttribute('aria-current',blogLeaf&&path!=='/blogs/news'?'location':'page');
              tier2Match=true;
            }
          });
          const blogTier=isBlog&&textOf(tier2Link)==='News & Contact';
          if(tier2Match||blogTier){
            child.classList.add('bhd-current-tier2');
            tier2Link?.setAttribute('aria-current','location');
            if(!isBlog)mainMatch=true;
          }
        });
        if(mainMatch&&!isBlog){
          main.classList.add('bhd-current-main');
          mainLink?.setAttribute('aria-current',samePath(mainLink,path)?'page':'location');
        }
        if(isBlog&&mainLabel==='Connect')main.dataset.bhdContainsBlogContext='1';
      });
      const discuss=header.querySelector('.bhd-header__discuss-button');
      if(discuss&&isBlog){discuss.classList.add('bhd-current-blog');discuss.setAttribute('aria-current','page')}
      const shop=header.querySelector('.bhd-header__shop-cta');
      if(shop&&samePath(shop,path)){shop.classList.add('bhd-current-shop');shop.setAttribute('aria-current','page')}
    };

    const markMobilePath=(header,path,isBlog)=>{
      header.querySelectorAll('[data-mobile-main]').forEach(main=>{
        const mainLink=main.querySelector(':scope > .bhd-header__mobile-main-row > a');
        let mainMatch=samePath(mainLink,path);
        main.querySelectorAll(':scope > .bhd-header__mobile-level-one > .bhd-header__mobile-tier2').forEach(child=>{
          const tier2Link=child.querySelector(':scope > .bhd-header__mobile-tier2-split .bhd-header__mobile-tier2-link');
          let tier2Match=samePath(tier2Link,path);
          child.querySelectorAll(':scope > .bhd-header__mobile-tier3 > a').forEach(leaf=>{
            const blogLeaf=isBlog&&normalizedPath(leaf.getAttribute('href'))==='/blogs/news';
            if(samePath(leaf,path)||blogLeaf){
              leaf.classList.add('bhd-current-tier3');
              leaf.setAttribute('aria-current',blogLeaf&&path!=='/blogs/news'?'location':'page');
              tier2Match=true;
            }
          });
          const blogTier=isBlog&&textOf(tier2Link)==='News & Contact';
          if(tier2Match||blogTier){
            child.classList.add('bhd-current-tier2');
            tier2Link?.setAttribute('aria-current','location');
            if(!isBlog)mainMatch=true;
          }
        });
        if(mainMatch&&!isBlog){
          main.classList.add('bhd-current-main');
          mainLink?.setAttribute('aria-current',samePath(mainLink,path)?'page':'location');
        }
      });
      header.querySelectorAll('.bhd-header__mobile-shop').forEach(shop=>{if(samePath(shop,path)){shop.classList.add('bhd-current-shop');shop.setAttribute('aria-current','page')}});
    };

    const markCurrentLocation=(header)=>{
      if(!header)return;
      clearCurrentClasses(header);
      header.querySelectorAll('.bhd-hover-open').forEach(node=>node.classList.remove('bhd-hover-open'));
      const path=normalizedPath(location.pathname);
      const isBlog=path==='/blogs/news'||path.startsWith('/blogs/news/');
      markDesktopPath(header,path,isBlog);
      markMobilePath(header,path,isBlog);
      header.dataset.bhdCurrentContext=isBlog?'Blog':textOf(header.querySelector('[data-main-item].bhd-current-main .bhd-header__main-link'))||'None';
    };

    const breadcrumbNode=(tag,label,href=null,current=false)=>{
      const node=document.createElement(tag);
      node.textContent=label;
      if(href)node.href=href;
      if(current)node.setAttribute('aria-current','page');
      return node;
    };
    const breadcrumbSeparator=()=>{const node=document.createElement('span');node.textContent='›';node.setAttribute('aria-hidden','true');return node};
    const replaceBreadcrumb=(nav,trail)=>{
      if(!nav)return;
      const nodes=[];
      trail.forEach((item,index)=>{if(index)nodes.push(breadcrumbSeparator());nodes.push(breadcrumbNode(item.href?'a':'span',item.label,item.href||null,Boolean(item.current)))});
      nav.replaceChildren(...nodes);
    };
    const normalizeEditorialBreadcrumbs=()=>{
      const news=document.querySelector('.bhd-blog-intro__breadcrumbs');
      if(news)replaceBreadcrumb(news,[{label:'Home',href:'/'},{label:'Connect',href:'/pages/connect-overview'},{label:'News & Contact',href:'/pages/news-contact'},{label:'News & Insights',current:true}]);
      if(/^\/blogs\/news\//.test(location.pathname)){
        const articleNav=document.querySelector('.bhd-surface-context__crumbs,.bhd-utility-context__crumbs');
        if(articleNav){
          const current=articleNav.querySelector('[aria-current="page"]')?.textContent?.trim()||document.querySelector('h1')?.textContent?.trim()||'Article';
          replaceBreadcrumb(articleNav,[{label:'Home',href:'/'},{label:'Connect',href:'/pages/connect-overview'},{label:'News & Contact',href:'/pages/news-contact'},{label:'News & Insights',href:'/blogs/news'},{label:current,current:true}]);
        }
      }
    };

    const bind=()=>{
      document.querySelectorAll('.bhd-header').forEach(header=>{
        markCurrentLocation(header);
        if(header.dataset.bhdContextObserverBound==='1')return;
        header.dataset.bhdContextObserverBound='1';
        const observer=new MutationObserver(mutations=>{
          if(mutations.some(m=>m.type==='childList'))markCurrentLocation(header);
        });
        observer.observe(header,{subtree:true,childList:true});
      });
      normalizeEditorialBreadcrumbs();
    };

    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind,{once:true});
    else bind();
  })();
</script>

{% comment %}
Shopify Admin MAIN is injected as the live menu source. Static bhd-header markup remains fallback only.
Desktop menu interaction has one owner only: sections/bhd-header.liquid. Top-level menus open only from their toggle, persist until the same toggle, another top-level toggle, outside click, or Escape closes them. Hover/focus no longer creates a second menu state.
This section now handles contrast/current-route styling and editorial breadcrumb normalization only.
Sync marker: click-only-single-state-20260910.
{% endcomment %}

{% schema %}
{
  "name":"Header menu contrast",
  "enabled_on":{"groups":["header"]},
  "settings":[]
}
{% endschema %}
