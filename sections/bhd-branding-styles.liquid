<style>
  .header__heading-link {
    display: flex !important;
    align-items: center;
    gap: 1rem;
  }

  .header__heading-logo-wrapper {
    width: 48px !important;
    flex: 0 0 48px;
  }

  .header__heading-logo {
    width: 48px !important;
    max-width: 48px !important;
    height: auto !important;
  }

  .header__heading-link::after {
    content: 'Best Hydrate';
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1;
    white-space: nowrap;
    color: rgb(var(--color-foreground));
  }

  #Banner-hero .banner__box {
    max-width: 72rem;
  }

  #Banner-hero .banner__heading {
    color: #fff !important;
    font-size: clamp(3rem, 5vw, 5.6rem) !important;
    line-height: 1.05;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
  }

  #Banner-hero .banner__text,
  #Banner-hero .banner__text p {
    color: #fff !important;
    font-size: clamp(1.5rem, 2vw, 2.2rem) !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.75);
  }

  @media screen and (max-width: 749px) {
    .header__heading-logo-wrapper {
      width: 40px !important;
      flex-basis: 40px;
    }

    .header__heading-logo {
      width: 40px !important;
      max-width: 40px !important;
    }

    .header__heading-link::after {
      font-size: 1.8rem;
    }
  }
</style>

{% schema %}
{
  "name": "BHD branding styles",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [],
  "presets": [
    {
      "name": "BHD branding styles"
    }
  ]
}
{% endschema %}
