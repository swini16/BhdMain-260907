{% doc %}
  @prompt
    Create a trust badge / credentials section for a supplement brand homepage. Display three trust credentials as icon-with-text badges in a clean horizontal row: 'Health Canada NPN Registered' (with NPN# 80118664), 'FDA Registered', and 'Canadian Made'. Use simple, professional icons (shield checkmark for registrations, maple leaf or flag for Canadian Made). The section should have a subtle background to stand out, be fully mobile responsive (stacks gracefully on small screens), and match a premium hydration brand aesthetic with clean typography. Position this section to work well near the hero or above a reviews section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-credentials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-trust-credentials-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1100px;
    margin: 0 auto;
  }

  .ai-trust-credentials-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 58px;
    padding: 8px 24px;
    text-align: left;
  }

  .ai-trust-credentials-{{ ai_gen_id }}__item + .ai-trust-credentials-{{ ai_gen_id }}__item {
    border-left: 1px solid {{ block.settings.border_color }};
  }

  .ai-trust-credentials-{{ ai_gen_id }}__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-credentials-{{ ai_gen_id }}__icon svg {
    width: 100%;
    height: 100%;
  }

  .ai-trust-credentials-{{ ai_gen_id }}__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-trust-credentials-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .ai-trust-credentials-{{ ai_gen_id }}__detail {
    margin: 0;
    color: {{ block.settings.detail_color }};
    font-size: 12px;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-credentials-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-trust-credentials-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ai-trust-credentials-{{ ai_gen_id }}__item {
      justify-content: flex-start;
      min-height: 0;
      padding: 14px 4px;
    }

    .ai-trust-credentials-{{ ai_gen_id }}__item + .ai-trust-credentials-{{ ai_gen_id }}__item {
      border-top: 1px solid {{ block.settings.border_color }};
      border-left: 0;
    }
  }
{% endstyle %}

<div class="ai-trust-credentials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-credentials-{{ ai_gen_id }}__inner">
    <div class="ai-trust-credentials-{{ ai_gen_id }}__item">
      <span class="ai-trust-credentials-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4L39 10V21C39 31.2 32.7 39.7 24 44C15.3 39.7 9 31.2 9 21V10L24 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M16.5 23.5L21.5 28.5L32 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="ai-trust-credentials-{{ ai_gen_id }}__copy">
        <span class="ai-trust-credentials-{{ ai_gen_id }}__title">{{ block.settings.credential_one_title }}</span>
        <span class="ai-trust-credentials-{{ ai_gen_id }}__detail">{{ block.settings.credential_one_detail }}</span>
      </span>
    </div>

    <div class="ai-trust-credentials-{{ ai_gen_id }}__item">
      <span class="ai-trust-credentials-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4L39 10V21C39 31.2 32.7 39.7 24 44C15.3 39.7 9 31.2 9 21V10L24 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M16.5 23.5L21.5 28.5L32 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="ai-trust-credentials-{{ ai_gen_id }}__copy">
        <span class="ai-trust-credentials-{{ ai_gen_id }}__title">{{ block.settings.credential_two_title }}</span>
        <span class="ai-trust-credentials-{{ ai_gen_id }}__detail">{{ block.settings.credential_two_detail }}</span>
      </span>
    </div>

    <div class="ai-trust-credentials-{{ ai_gen_id }}__item">
      <span class="ai-trust-credentials-{{ ai_gen_id }}__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 5L27.7 15.8L39 15.9L30 22.7L33.4 33.5L24 27L14.6 33.5L18 22.7L9 15.9L20.3 15.8L24 5Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M24 27V42" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="ai-trust-credentials-{{ ai_gen_id }}__copy">
        <span class="ai-trust-credentials-{{ ai_gen_id }}__title">{{ block.settings.credential_three_title }}</span>
        <span class="ai-trust-credentials-{{ ai_gen_id }}__detail">{{ block.settings.credential_three_detail }}</span>
      </span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust credentials",
  "settings": [
    {
      "type": "header",
      "content": "Credentials"
    },
    {
      "type": "text",
      "id": "credential_one_title",
      "label": "First title",
      "default": "Health Canada NPN Registered"
    },
    {
      "type": "text",
      "id": "credential_one_detail",
      "label": "First detail",
      "default": "NPN# 80118664"
    },
    {
      "type": "text",
      "id": "credential_two_title",
      "label": "Second title",
      "default": "FDA Registered"
    },
    {
      "type": "text",
      "id": "credential_two_detail",
      "label": "Second detail",
      "default": "Quality you can trust"
    },
    {
      "type": "text",
      "id": "credential_three_title",
      "label": "Third title",
      "default": "Canadian Made"
    },
    {
      "type": "text",
      "id": "credential_three_detail",
      "label": "Third detail",
      "default": "Proudly made in Canada"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#E8EAF1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0E1B4D"
    },
    {
      "type": "color",
      "id": "detail_color",
      "label": "Details",
      "default": "#35416B"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "default": "#1E4FA3"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#C8CCDA"
    }
  ],
  "presets": [
    {
      "name": "Trust credentials"
    }
  ],
  "tag": null,
  "class": "trust-credentials-block"
}
{% endschema %}